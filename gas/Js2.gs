"  if(setSec&&(!SET_SECS.some(x=>x[0]===setSec)||!secVisible(setSec)))setSec=\"\";",
"  if(!setSec){renderSetHub();return}",
"  const S=SET_SECS.find(x=>x[0]===setSec),hasSave=[\"company\",\"boxes\",\"rules\",\"screens\",\"fx\",\"bank\"].indexOf(setSec)>=0;",
"  $(\"#view\").innerHTML=`<div class=\"set-top\"><button class=\"set-back\" id=\"setBack\" type=\"button\">${svgI(\"back\")}<span>\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a</span></button>",
"   <div class=\"set-title\"><span class=\"set-ic\">${svgI(setSec)}</span><div><h2>${S[1]}</h2><p class=\"note\">${S[2]}</p></div></div></div>",
"   <div class=\"set-body\">${({company:secCompany,boxes:secBoxes,staff:secStaff,users:secUsers,rules:secRules,data:secData,branches:secBranches,screens:secScreens,fx:secFx,bank:secBank,year:secYear})[setSec]()}</div>",
"   ${hasSave?`<div class=\"set-save\"><button class=\"btn primary block\" id=\"sSave\">\u062d\u0641\u0638 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a</button></div>`:\"\"}`;",
"  setDirty=false;",
"  $(\"#setBack\").onclick=async()=>{if(setDirty&&hasSave){const v=await ask(\"\u0641\u064a \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0645\u0627 \u0627\u0646\u062d\u0641\u0638\u062a. \u062a\u062d\u0641\u0638\u0647\u0627 \u0642\u0628\u0644 \u0627\u0644\u0631\u062c\u0648\u0639\u061f\",[{t:\"\u062d\u0641\u0638\",v:\"s\",cls:\"primary\"},{t:\"\u062a\u062c\u0627\u0647\u0644\",v:\"d\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]);if(!v)return;if(v===\"s\"&&!await saveSec())return}",
"    setSec=\"\";boxEd=null;renderSettings();window.scrollTo(0,0)};",
"  if(hasSave){const V=$(\"#view\");V.addEventListener(\"input\",()=>setDirty=true);V.addEventListener(\"change\",()=>setDirty=true);",
"    $(\"#sSave\").onclick=async()=>{const b=$(\"#sSave\");b.disabled=true;await saveSec();b.disabled=false}}",
"  ({company:bindCompany,boxes:bindBoxes,staff:bindStaff,users:bindUsers,rules:()=>{},data:bindData,branches:bindBranches,screens:()=>{},fx:bindFx,bank:bindBank,year:bindYear})[setSec]();",
"}",
"function renderSetHub(){",
"  $(\"#view\").innerHTML=`<div class=\"set-head\">${LOGO?`<img src=\"${LOGO}\" alt=\"\">`:`<span class=\"set-ic big\">${svgI(\"company\")}</span>`}",
"    <div><b>${esc(settings.store||\"\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629\")}</b><span class=\"note\">${esc(settings.branch||\"\")}${settings.branch?\" \u00b7 \":\"\"}\u0627\u0644\u0625\u0635\u062f\u0627\u0631 ${APPV}</span></div></div>",
"   <button class=\"set-row\" type=\"button\" id=\"setLang\"><span class=\"set-ic\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18\"/></svg></span><span class=\"set-txt\"><b data-notr>\u0627\u0644\u0644\u063a\u0629 \u00b7 Language</b><span class=\"note\" data-notr>${LANG===\"en\"?\"English\":\"\u0627\u0644\u0639\u0631\u0628\u064a\u0629\"}</span></span><span class=\"set-chev\" data-notr>${LANG===\"en\"?\"\u0627\u0644\u0639\u0631\u0628\u064a\u0629\":\"English\"}</span></button>",
"   <nav class=\"set-list\" aria-label=\"\u0623\u0642\u0633\u0627\u0645 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\">${SET_SECS.filter(x=>secVisible(x[0])).map(([k,t])=>`<button class=\"set-row\" type=\"button\" data-sec=\"${k}\"><span class=\"set-ic\">${svgI(k)}</span>",
"     <span class=\"set-txt\"><b>${t}</b><span class=\"note\" data-sum=\"${k}\">${esc(secSummary(k))}</span></span><span class=\"set-chev\">${svgI(\"chev\")}</span></button>`).join(\"\")}</nav>`;",
"  $(\"#setLang\").onclick=()=>setLang(LANG===\"en\"?\"ar\":\"en\");",
"  document.querySelectorAll(\"[data-sec]\").forEach(b=>b.onclick=()=>{setSec=b.dataset.sec;boxEd=null;renderSettings();window.scrollTo(0,0)});",
"  if(!usersCache&&me.admin)api(\"users\").then(r=>{usersCache=r;const e=document.querySelector('[data-sum=\"users\"]');if(e)e.textContent=secSummary(\"users\")}).catch(()=>{});",
"}",
"async function saveSec(){",
"  if(setSec===\"company\"){",
"    const st=$(\"#s-store\").value.trim();if(!st){toast(\"\u0627\u0643\u062a\u0628 \u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629\");return false}",
"    settings.store=st;settings.branch=$(\"#s-branch\").value.trim();settings.signA=$(\"#s-signA\").value.trim();settings.signB=$(\"#s-signB\").value.trim();",
"    settings.logoPrint=$(\"#s-logoPrint\").checked;settings.logoWm=$(\"#s-logoWm\").checked;settings.wmLevel=+$(\"#s-wmLevel\").value||0;settings.wmMode=$(\"#s-wmMode\").value;paintLogo()}",
"  else if(setSec===\"boxes\"){",
"    if(!boxesRead())return false;",
"    settings.cashiers=$(\"#s-cashiers\").value.split(\"\\n\").map(s=>s.trim()).filter(Boolean);settings.shifts=$(\"#s-shifts\").value.split(\"\\n\").map(s=>s.trim()).filter(Boolean)}",
"  else if(setSec===\"screens\"){settings.modCashbox=$(\"#s-modCashbox\").checked;settings.modPetty=$(\"#s-modPetty\").checked}",
"  else if(setSec===\"fx\"){const cur={};FXL.forEach(([c,,d])=>{const r=num($(\"#fx-r-\"+c).value);cur[c]={on:$(\"#fx-on-\"+c).checked,rate:r>0?r:d}});",
"    if($(\"#s-fxOn\").checked&&!FXL.some(([c])=>cur[c].on)){toast(\"\u0627\u062e\u062a\u0631 \u0639\u0645\u0644\u0629 \u0648\u0627\u062d\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\");return false}",
"    const bad=FXL.find(([c])=>cur[c].on&&!(num($(\"#fx-r-\"+c).value)>0));if(bad){toast(\"\u0627\u0643\u062a\u0628 \u0633\u0639\u0631 \u0635\u0631\u0641 \"+bad[1]);return false}",
"    settings.fx={on:$(\"#s-fxOn\").checked,mode:$(\"#s-fxTrack\").checked?\"track\":\"convert\",cur}}",
"  else if(setSec===\"bank\"){const v=await bankSave();if(!v)return false;settings.bankFee=v}",
"  else if(setSec===\"rules\"){",
"    const off=[...document.querySelectorAll(\"[data-net]\")].filter(x=>!x.checked).map(x=>x.dataset.net);if(off.length>=NV().length){toast(\"\u0644\u0627\u0632\u0645 \u062a\u0628\u0642\u0649 \u0634\u0628\u0643\u0629 \u0648\u0627\u062d\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\");return false}",
"    settings.netsOff=off;settings.rate=num($(\"#s-rate\").value);settings.rateNet=$(\"#s-rateNet\").checked;",
"    settings.supHours=num($(\"#s-hours\").value)||12;settings.supApprove=$(\"#s-supApprove\").checked;settings.supPrev=$(\"#s-supPrev\").checked;settings.allowFuture=$(\"#s-allowFuture\").checked}",
"  const ok=await saveSettings();if(ok){setDirty=false;if(setSec===\"boxes\"){boxEd=null;drawBoxCard()}}return ok;",
"}",
"/* company & identity */",
"function secCompany(){const ro=me.admin?\"\":\"disabled\";return`${me.admin?\"\":`<div class=\"info\">\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 \u0648\u0627\u0644\u0634\u0639\u0627\u0631 \u0648\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u0627\u0626\u064a\u0629 \u064a\u0639\u062f\u0651\u0644\u0647\u0627 \u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0641\u0642\u0637. \u062a\u0642\u062f\u0631 \u062a\u0639\u062f\u0651\u0644 \u0627\u0633\u0645 \u0627\u0644\u0641\u0631\u0639 \u0648\u0627\u0644\u062a\u0648\u0642\u064a\u0639\u0627\u062a.</div>`}<div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629</h3>",
"   <div class=\"field\"><label for=\"s-store\">\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629</label><input class=\"inp\" id=\"s-store\" value=\"${esc(settings.store)}\" ${ro}></div>",
"   <div class=\"field\"><label for=\"s-branch\">\u0627\u0644\u0641\u0631\u0639</label><input class=\"inp\" id=\"s-branch\" value=\"${esc(settings.branch)}\"></div>",
"   <div class=\"field\"><label for=\"s-signA\">\u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0623\u0648\u0644</label><input class=\"inp\" id=\"s-signA\" value=\"${esc(settings.signA)}\"></div>",
"   <div class=\"field\"><label for=\"s-signB\">\u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u062b\u0627\u0646\u064a</label><input class=\"inp\" id=\"s-signB\" value=\"${esc(settings.signB)}\"></div></div>",
"  <div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0634\u0639\u0627\u0631</h3><p class=\"note\" style=\"margin:0 0 10px\">\u064a\u0638\u0647\u0631 \u0623\u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0641\u064a \u0634\u0627\u0634\u0629 \u0627\u0644\u062f\u062e\u0648\u0644\u060c \u0648\u0641\u064a \u0631\u0623\u0633 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0645\u0637\u0628\u0648\u0639\u0629 \u0648\u0645\u0644\u0641\u0627\u062a PDF.</p>",
"   <div class=\"logo-edit\"><div class=\"logo-box\">${LOGO?`<img src=\"${LOGO}\" alt=\"\u0627\u0644\u0634\u0639\u0627\u0631\">`:`<span class=\"note\">\u0644\u0627 \u064a\u0648\u062c\u062f \u0634\u0639\u0627\u0631</span>`}</div>",
"   <div class=\"row-btns\"><label class=\"btn primary\" for=\"logoFile\">${LOGO?\"\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0634\u0639\u0627\u0631\":\"\u0625\u0636\u0627\u0641\u0629 \u0634\u0639\u0627\u0631\"}</label><input type=\"file\" id=\"logoFile\" accept=\"image/*\" hidden>${LOGO?`<button class=\"btn\" id=\"logoDel\" type=\"button\">\u062d\u0630\u0641 \u0627\u0644\u0634\u0639\u0627\u0631</button>`:\"\"}</div></div>",
"   <label class=\"chk\"><input type=\"checkbox\" id=\"s-logoPrint\" ${settings.logoPrint!==false?\"checked\":\"\"}>\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u0634\u0639\u0627\u0631 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0645\u0637\u0628\u0648\u0639\u0629 \u0648 PDF</label></div>",
"  <div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u0627\u0626\u064a\u0629</h3><p class=\"note\" style=\"margin:0 0 10px\">\u0635\u0648\u0631\u0629 \u062e\u0641\u064a\u0641\u0629 \u062e\u0644\u0641 \u0634\u0627\u0634\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645\u060c \u0648\u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646.</p>",
"   <label class=\"chk\"><input type=\"checkbox\" id=\"s-logoWm\" ${settings.logoWm!==false?\"checked\":\"\"}>\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u0627\u0626\u064a\u0629</label>",
"   <div class=\"logo-edit\" style=\"margin-top:8px\"><div class=\"logo-box wm-box\">${wmSrc()||WM||LOGO?`<img src=\"${WM||LOGO}\" alt=\"\" style=\"opacity:${wmOp(1)*4}\">`:`<span class=\"note\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0635\u0648\u0631\u0629</span>`}</div>",
"    <div><div class=\"note\" style=\"margin-bottom:6px\">${WM?\"\u0635\u0648\u0631\u0629 \u0645\u062e\u0635\u0635\u0629\":LOGO?\"\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0634\u0639\u0627\u0631 \u0627\u0644\u0634\u0631\u0643\u0629\":\"\u0623\u0636\u0641 \u0634\u0639\u0627\u0631\u0627\u064b \u0623\u0648 \u0635\u0648\u0631\u0629\"}</div>",
"    <div class=\"row-btns\"><label class=\"btn small primary\" for=\"wmFile\">${WM?\"\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0635\u0648\u0631\u0629\":\"\u0627\u062e\u062a\u064a\u0627\u0631 \u0635\u0648\u0631\u0629\"}</label><input type=\"file\" id=\"wmFile\" accept=\"image/*\" hidden>${WM?`<button class=\"btn small\" id=\"wmDel\" type=\"button\">\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0634\u0639\u0627\u0631</button>`:\"\"}</div></div></div>",
"   <div class=\"field\"><label for=\"s-wmMode\">\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0639\u0631\u0636</label><select class=\"inp\" id=\"s-wmMode\">${[[\"cover\",\"\u0645\u0644\u0621 \u0627\u0644\u0634\u0627\u0634\u0629\"],[\"tile\",\"\u0646\u0642\u0634 \u0645\u062a\u0643\u0631\u0631\"],[\"center\",\"\u0641\u064a \u0627\u0644\u0648\u0633\u0637\"]].map(([k,l])=>`<option value=\"${k}\" ${wmMode()===k?\"selected\":\"\"}>${l}</option>`).join(\"\")}</select></div>",
"   <div class=\"field\"><label for=\"s-wmLevel\">\u0648\u0636\u0648\u062d \u0627\u0644\u0639\u0644\u0627\u0645\u0629</label><select class=\"inp\" id=\"s-wmLevel\">${[\"\u062e\u0641\u064a\u0641\u0629\",\"\u0645\u062a\u0648\u0633\u0637\u0629\",\"\u0648\u0627\u0636\u062d\u0629\"].map((l,k)=>`<option value=\"${k}\" ${(+settings.wmLevel||0)===k?\"selected\":\"\"}>${l}</option>`).join(\"\")}</select></div></div>`}",
"function bindCompany(){",
"  $(\"#wmFile\").onchange=e=>{const f=e.target.files[0];e.target.value=\"\";if(f)pickWm(f)};const wd=$(\"#wmDel\");if(wd)wd.onclick=async()=>{try{await api(\"saveWm\",{data:\"\"});settings.wmV=\"\";await loadWm(\"\");toast(\"\u0631\u062c\u0639\u062a \u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u0627\u0626\u064a\u0629 \u0644\u0634\u0639\u0627\u0631 \u0627\u0644\u0634\u0631\u0643\u0629\");renderSettings()}catch(x){toast(x.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0630\u0641\")}};",
"  $(\"#s-logoWm\").onchange=e=>{settings.logoWm=e.target.checked;paintLogo()};$(\"#s-wmLevel\").onchange=e=>{settings.wmLevel=+e.target.value;paintLogo()};$(\"#s-wmMode\").onchange=e=>{settings.wmMode=e.target.value;paintLogo()};",
"  $(\"#logoFile\").onchange=e=>{const f=e.target.files[0];e.target.value=\"\";if(f)pickLogo(f)};const ld=$(\"#logoDel\");if(ld)ld.onclick=async()=>{if(!await ask(\"\u062d\u0630\u0641 \u0634\u0639\u0627\u0631 \u0627\u0644\u0634\u0631\u0643\u0629\u061f\",[{t:\"\u062d\u0630\u0641\",v:1,cls:\"danger\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]))return;try{await api(\"saveLogo\",{data:\"\"});await loadLogo(\"\");settings.logoV=\"\";toast(\"\u062a\u0645 \u062d\u0630\u0641 \u0627\u0644\u0634\u0639\u0627\u0631\");renderSettings()}catch(x){toast(x.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0630\u0641\")}};",
"}",
"/* boxes, cashiers, shifts */",
"function secBoxes(){return`<div class=\"card\" id=\"boxCard\"></div>",
"  <div class=\"card\"><h3 class=\"set-h\">\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a</h3><p class=\"note\" style=\"margin:0 0 8px\">\u0627\u0633\u0645 \u0641\u064a \u0643\u0644 \u0633\u0637\u0631. \u062a\u0638\u0647\u0631 \u0643\u0642\u0627\u0626\u0645\u0629 \u0627\u062e\u062a\u064a\u0627\u0631 \u0639\u0646\u062f \u0625\u062f\u062e\u0627\u0644 \u0627\u0644\u0635\u0646\u062f\u0648\u0642.</p>",
"   <textarea class=\"inp\" id=\"s-cashiers\" rows=\"6\">${esc((settings.cashiers||[]).join(\"\\n\"))}</textarea></div>",
"  <div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0648\u0631\u062f\u064a\u0627\u062a</h3><textarea class=\"inp\" id=\"s-shifts\" rows=\"3\">${esc((settings.shifts||[]).join(\"\\n\"))}</textarea></div>`}",
"function bindBoxes(){boxEd=null;drawBoxCard()}",
"/* staff: a searchable list, each person edited on their own sheet */",
"let staffQ=\"\";",
"function secStaff(){return`<div class=\"card set-tools\"><label class=\"set-search\">${svgI(\"search\")}<input class=\"inp\" id=\"stQ\" type=\"search\" placeholder=\"\u0628\u062d\u062b \u0628\u0627\u0644\u0627\u0633\u0645\" aria-label=\"\u0628\u062d\u062b \u0628\u0627\u0644\u0627\u0633\u0645\" value=\"${esc(staffQ)}\"></label>",
"   <button class=\"btn primary\" id=\"stAdd\" type=\"button\">${svgI(\"plus\")}\u0645\u0648\u0638\u0641 \u062c\u062f\u064a\u062f</button></div>",
"  <p class=\"note set-note\">\u0627\u0644\u062c\u0648\u0627\u0644 \u0648\u0627\u0644\u0625\u064a\u0645\u064a\u0644 \u0644\u0625\u0631\u0633\u0627\u0644 \u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u0639\u062c\u0632\u060c \u0648\u0627\u0644\u062c\u0646\u0633 \u0644\u0635\u064a\u063a\u0629 \u0627\u0644\u0645\u062e\u0627\u0637\u0628\u0629\u060c \u0648\u0627\u0644\u0648\u0631\u062f\u064a\u0629 \u062a\u0646\u0643\u062a\u0628 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0641\u064a \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0639\u0646\u062f \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0648\u0638\u0641\u060c \u0648\u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641 \u0648\u0646\u0648\u0639 \u0627\u0644\u062f\u0648\u0627\u0645 \u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062d\u0636\u0648\u0631. \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0623\u0648\u0641 \u0623\u0648 \u0646\u0648\u0639 \u0627\u0644\u062f\u0648\u0627\u0645 \u064a\u064f\u0637\u0628\u064e\u0651\u0642 \u0645\u0646 \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u062d\u0627\u0644\u064a.</p>",
"  <div class=\"card set-people\" id=\"stList\"></div>`}",
"function drawStaff(){",
"  const L=$(\"#stList\");if(!L)return;const q=staffQ.trim(),names=phoneNames().filter(n=>!q||n.indexOf(q)>=0).sort((a,b)=>a.localeCompare(b,\"ar\"));",
"  L.innerHTML=names.length?names.map(n=>{const sc=schedAt(n,todayISO())||{},st=staffOf(n)||{},ph=(settings.phones||{})[n],em=(settings.emails||{})[n],gone=st.end&&st.end<todayISO();",
"    return`<button class=\"person\" type=\"button\" data-st=\"${esc(n)}\"><span class=\"av\">${esc(n.trim().charAt(0))}</span><span class=\"p-txt\"><b>${esc(n)}</b>",
"     <span class=\"p-tags\"><span class=\"tag\">${isM(n)?\"\u0645\u0648\u0638\u0641\":\"\u0645\u0648\u0638\u0641\u0629\"}</span>${ph?`<span class=\"tag ok\">\u062c\u0648\u0627\u0644</span>`:`<span class=\"tag miss\">\u0628\u062f\u0648\u0646 \u062c\u0648\u0627\u0644</span>`}${em?`<span class=\"tag ok\">\u0625\u064a\u0645\u064a\u0644</span>`:\"\"}${st.shift?`<span class=\"tag\">${esc(st.shift)}</span>`:\"\"}${sc.off?`<span class=\"tag\">\u0623\u0648\u0641 ${esc(sc.off)}</span>`:\"\"}${sc.type===\"\u0628\u062f\u064a\u0644\"?`<span class=\"tag\">\u0628\u062f\u064a\u0644</span>`:\"\"}${gone?`<span class=\"tag miss\">\u0627\u0646\u062a\u0647\u0649 \u0639\u0645\u0644\u0647</span>`:\"\"}</span></span><span class=\"set-chev\">${svgI(\"chev\")}</span></button>`}).join(\"\")",
"   :`<div class=\"empty\">${q?\"\u0644\u0627 \u064a\u0648\u062c\u062f \u0645\u0648\u0638\u0641 \u0628\u0647\u0630\u0627 \u0627\u0644\u0627\u0633\u0645.\":\"\u0644\u0627 \u064a\u0648\u062c\u062f \u0645\u0648\u0638\u0641\u0648\u0646 \u0628\u0639\u062f. \u0623\u0636\u0641 \u0623\u0648\u0644 \u0645\u0648\u0638\u0641 \u0645\u0646 \u0632\u0631 \u00ab\u0645\u0648\u0638\u0641 \u062c\u062f\u064a\u062f\u00bb.\"}</div>`;",
"  L.querySelectorAll(\"[data-st]\").forEach(b=>b.onclick=()=>editStaff(b.dataset.st));",
"}",
"function bindStaff(){drawStaff();$(\"#stQ\").oninput=e=>{staffQ=e.target.value;drawStaff()};$(\"#stAdd\").onclick=()=>editStaff(null)}",
"function editStaff(n){",
"  const isNew=!n,sc=(n&&schedAt(n,todayISO()))||{},st=(n&&staffOf(n))||{};",
"  const body=`${isNew?`<div class=\"field\"><label for=\"e-name\">\u0627\u0644\u0627\u0633\u0645</label><input class=\"inp\" id=\"e-name\" autocomplete=\"off\"></div>`:\"\"}",
"   <div class=\"field\"><label for=\"e-gender\">\u0627\u0644\u0645\u062e\u0627\u0637\u0628\u0629</label><select class=\"inp\" id=\"e-gender\"><option value=\"f\">\u0645\u0648\u0638\u0641\u0629</option><option value=\"m\" ${n&&isM(n)?\"selected\":\"\"}>\u0645\u0648\u0638\u0641</option></select></div>",
"   <div class=\"field\"><label for=\"e-phone\">\u0627\u0644\u062c\u0648\u0627\u0644</label><input class=\"inp\" id=\"e-phone\" type=\"tel\" inputmode=\"tel\" dir=\"ltr\" placeholder=\"05xxxxxxxx\" value=\"${esc(n&&(settings.phones||{})[n]||\"\")}\"></div>",
"   <div class=\"field\"><label for=\"e-email\">\u0627\u0644\u0625\u064a\u0645\u064a\u0644</label><input class=\"inp\" id=\"e-email\" type=\"email\" inputmode=\"email\" dir=\"ltr\" autocapitalize=\"none\" placeholder=\"name@example.com\" value=\"${esc(n&&(settings.emails||{})[n]||\"\")}\"></div>",
"   <div class=\"field\"><label for=\"e-off\">\u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641</label><select class=\"inp\" id=\"e-off\"><option value=\"\">\u2014</option>${WEEK.map(w=>`<option ${sc.off===w?\"selected\":\"\"}>${w}</option>`).join(\"\")}</select></div>",
"   <div class=\"field\"><label for=\"e-shift\">\u0627\u0644\u0648\u0631\u062f\u064a\u0629</label><select class=\"inp\" id=\"e-shift\"><option value=\"\">\u2014</option>${[...new Set((settings.shifts||[]).concat(st.shift?[st.shift]:[]))].map(x=>`<option ${st.shift===x?\"selected\":\"\"}>${esc(x)}</option>`).join(\"\")}</select></div>",
"   <div class=\"field\"><label for=\"e-type\">\u0646\u0648\u0639 \u0627\u0644\u062f\u0648\u0627\u0645</label><select class=\"inp\" id=\"e-type\"><option ${sc.type!==\"\u0628\u062f\u064a\u0644\"?\"selected\":\"\"}>\u0623\u0633\u0627\u0633\u064a</option><option ${sc.type===\"\u0628\u062f\u064a\u0644\"?\"selected\":\"\"}>\u0628\u062f\u064a\u0644</option></select></div>",
"   <div class=\"field\"><label for=\"e-start\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629</label><input class=\"inp\" id=\"e-start\" type=\"date\" value=\"${esc(st.start||\"\")}\"></div>",
"   <div class=\"field\"><label for=\"e-end\">\u0622\u062e\u0631 \u064a\u0648\u0645 \u0639\u0645\u0644</label><input class=\"inp\" id=\"e-end\" type=\"date\" value=\"${esc(st.end||\"\")}\"></div>`;",
"  const s=sheet(isNew?\"\u0645\u0648\u0638\u0641 \u062c\u062f\u064a\u062f\":esc(n),body,`<button class=\"btn primary\" id=\"eSave\">\u062d\u0641\u0638</button><button class=\"btn\" data-close>\u0625\u0644\u063a\u0627\u0621</button>`);",
"  $(\"#eSave\").onclick=async()=>{const b=$(\"#eSave\");",
"    const name=isNew?$(\"#e-name\").value.trim().replace(/\\s+/g,\" \"):n;if(!name){toast(\"\u0627\u0643\u062a\u0628 \u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641\");return}",
"    if(isNew&&phoneNames().indexOf(name)>=0){toast(\"\u0627\u0644\u0627\u0633\u0645 \u0645\u0648\u062c\u0648\u062f \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629\");return}",
"    const em=$(\"#e-email\").value.trim().toLowerCase();if(em&&!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(em)){toast(\"\u0627\u0644\u0625\u064a\u0645\u064a\u0644 \u063a\u064a\u0631 \u0635\u062d\u064a\u062d\");return}",
"    const ph=$(\"#e-phone\").value.trim().replace(/[\u0660-\u0669]/g,d=>\"\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669\".indexOf(d)).replace(/[\u06f0-\u06f9]/g,d=>\"\u06f0\u06f1\u06f2\u06f3\u06f4\u06f5\u06f6\u06f7\u06f8\u06f9\".indexOf(d));if(ph&&ph.replace(/\\D/g,\"\").length<9){toast(\"\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\");return}",
"    b.disabled=true;",
"    const P=Object.assign({},settings.phones||{}),E=Object.assign({},settings.emails||{}),Gd=Object.assign({},settings.genders||{}),stf=JSON.parse(JSON.stringify(settings.staff||{})),mon=todayISO().slice(0,7);",
"    if(ph)P[name]=ph;else delete P[name];if(em)E[name]=em;else delete E[name];if($(\"#e-gender\").value===\"m\")Gd[name]=\"m\";else delete Gd[name];",
"    const e=stf[name]||(stf[name]={start:\"\",end:\"\",sched:{}});e.start=$(\"#e-start\").value;e.end=$(\"#e-end\").value;e.shift=$(\"#e-shift\").value;e.sched=e.sched||{};",
"    const c0=schedAt(name,todayISO())||{off:\"\",type:\"\u0623\u0633\u0627\u0633\u064a\"},nw={off:$(\"#e-off\").value,type:$(\"#e-type\").value};if(isNew||c0.off!==nw.off||(c0.type||\"\u0623\u0633\u0627\u0633\u064a\")!==nw.type)e.sched[mon]=nw;",
"    const keep={phones:settings.phones,emails:settings.emails,genders:settings.genders,staff:settings.staff,cashiers:settings.cashiers};",
"    settings.phones=P;settings.emails=E;settings.genders=Gd;settings.staff=stf;if(isNew)settings.cashiers=(settings.cashiers||[]).concat([name]);",
"    if(await saveSettings()){s.close();drawStaff()}else{Object.assign(settings,keep);b.disabled=false}};",
"}",
