"/* ---------- per-user permissions ---------- */",
"const PERM_TXT={xlsx:\"\u062a\u0635\u062f\u064a\u0631 Excel\",wa:\"\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0644\u0644\u0645\u0648\u0638\u0641\u064a\u0646 (\u0648\u0627\u062a\u0633\u0627\u0628\u060c \u0625\u064a\u0645\u064a\u0644\u060c \u0635\u0648\u0631\u0629)\",days:\"\u0645\u062f\u0629 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\"};",
"function permsUI(role,p){",
"  const box=$(\"#u-perms\");if(!box)return;",
"  if(role===\"acc\"){box.innerHTML=`<div class=\"info\" style=\"margin:0 0 12px\">\u0627\u0644\u0645\u062d\u0627\u0633\u0628 \u064a\u062f\u062e\u0644 \u0648\u064a\u0639\u062f\u0651\u0644 \u0643\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0641\u064a \u0641\u0631\u0639\u0647.</div>`;return}",
"  const d=PERM_DEF[role],al=PERM_ALLOWED[role];p=Object.assign({},d,p||{});",
"  box.innerHTML=`<div class=\"perm\"><b>\u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a</b>",
"   <div class=\"ptabs\">${al.map(k=>`<label class=\"chk\"><input type=\"checkbox\" data-pt=\"${k}\" ${(p.tabs||[]).indexOf(k)>=0?\"checked\":\"\"}>${TABN[k]}</label>`).join(\"\")}</div>",
"   ${role!==\"lead\"?`<label class=\"chk\"><input type=\"checkbox\" id=\"p-xlsx\" ${p.xlsx?\"checked\":\"\"}>${PERM_TXT.xlsx}</label>`:\"\"}",
"   ${role===\"lead\"||role===\"sup\"?`<label class=\"chk\"><input type=\"checkbox\" id=\"p-wa\" ${p.wa?\"checked\":\"\"}>${PERM_TXT.wa}</label>`:\"\"}",
"   ${d.days?`<div class=\"field\" style=\"margin-top:8px\"><label for=\"p-days\">${role===\"sup\"?\"\u0645\u062f\u0629 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u0627\u0644\u0639\u062c\u0648\u0632\u0627\u062a\":PERM_TXT.days}</label><select class=\"inp\" id=\"p-days\">${[2,7,14,30,60,90].map(n=>`<option value=\"${n}\" ${+p.days===n?\"selected\":\"\"}>\u0622\u062e\u0631 ${n===2?\"\u064a\u0648\u0645\u064a\u0646\":n+\" \u064a\u0648\u0645\u0627\u064b\"}</option>`).join(\"\")}</select></div>`:\"\"}",
"   ${role===\"sup\"?`<div class=\"perm\" style=\"margin-top:8px\"><b>\u0625\u062f\u062e\u0627\u0644\u0627\u062a\u0647 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631</b><div class=\"seg\" role=\"group\" aria-label=\"\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0625\u062f\u062e\u0627\u0644\"><button type=\"button\" data-ap=\"1\" aria-pressed=\"${apOf(p)}\">\u0628\u0639\u062f \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0645\u062d\u0627\u0633\u0628</button><button type=\"button\" data-ap=\"0\" aria-pressed=\"${!apOf(p)}\">\u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u062f\u0648\u0646 \u0627\u0639\u062a\u0645\u0627\u062f</button></div>",
"     <p class=\"note\" id=\"p-apNote\" style=\"margin:6px 0 0\">${apOf(p)?\"\u062a\u0638\u0647\u0631 \u0625\u062f\u062e\u0627\u0644\u0627\u062a\u0647 \u0644\u0644\u0645\u062d\u0627\u0633\u0628 \u00ab\u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f\u00bb\u060c \u0648\u0645\u0627 \u062a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0625\u0644\u0627 \u0628\u0639\u062f \u0645\u0627 \u064a\u0639\u062a\u0645\u062f\u0647\u0627.\":\"\u0625\u062f\u062e\u0627\u0644\u0627\u062a\u0647 \u062a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0623\u0648\u0644 \u0645\u0627 \u064a\u062d\u0641\u0638\u0647\u0627\u060c \u0628\u062f\u0648\u0646 \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0639\u062a\u0645\u0627\u062f.\"}</p></div>",
"     <p class=\"note\">\u064a\u062f\u062e\u0644 \u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u064a\u0648\u0645 \u0648\u064a\u0639\u062f\u0651\u0644 \u0643\u0644 \u0635\u0646\u062f\u0648\u0642 \u062e\u0644\u0627\u0644 ${settings.supHours||12} \u0633\u0627\u0639\u0629 \u0645\u0646 \u0623\u0648\u0644 \u062d\u0641\u0638.</p>`:\"\"}",
"   ${role===\"mgr\"?`<p class=\"note\">\u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0637\u0644\u0627\u0639 \u0641\u0642\u0637 \u0641\u064a \u0643\u0644 \u0627\u0644\u0634\u0627\u0634\u0627\u062a\u060c \u0648\u0644\u0627 \u064a\u0639\u062f\u0651\u0644 \u0623\u064a \u0628\u064a\u0627\u0646\u0627\u062a.</p>`:\"\"}",
