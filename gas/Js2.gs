"  el.textContent=\"\";if(MYAV){const im=document.createElement(\"img\");im.alt=\"\";im.src=MYAV;el.appendChild(im)}else el.textContent=String((me&&(me.name||me.username))||\"\").trim().charAt(0);",
"}",
"function avatarUI(){",
"  const s=sheet(\"\u0635\u0648\u0631\u0629 \u0627\u0644\u062d\u0633\u0627\u0628\",`<div class=\"av-pick\"><span class=\"avatar big\" id=\"avPrev\"></span><p class=\"note\" style=\"margin:8px 0 0;text-align:center\">\u0627\u0644\u0635\u0648\u0631\u0629 \u062a\u0638\u0647\u0631 \u0644\u0643 \u0623\u0646\u062a \u0641\u0642\u0637 \u0623\u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629\u060c \u0648\u062a\u062a\u0628\u0639\u0643 \u0639\u0644\u0649 \u0623\u064a \u062c\u0647\u0627\u0632 \u062a\u062f\u062e\u0644 \u0645\u0646\u0647.</p>",
"    <input type=\"file\" id=\"avFile\" accept=\"image/*\" hidden></div>`,`<button class=\"btn primary\" id=\"avChoose\" type=\"button\">\u0627\u062e\u062a\u064a\u0627\u0631 \u0635\u0648\u0631\u0629</button>${MYAV?`<button class=\"btn\" id=\"avDel\" type=\"button\">\u062d\u0630\u0641 \u0627\u0644\u0635\u0648\u0631\u0629</button>`:\"\"}<button class=\"btn\" data-close type=\"button\">\u0625\u063a\u0644\u0627\u0642</button>`);",
"  paintAvatar($(\"#avPrev\"));",
"  $(\"#avChoose\").onclick=()=>$(\"#avFile\").click();",
"  $(\"#avFile\").onchange=e=>{const f=e.target.files&&e.target.files[0];if(!f)return;if(!/^image\\//.test(f.type)){toast(\"\u0627\u062e\u062a\u0631 \u0645\u0644\u0641 \u0635\u0648\u0631\u0629\");return}",
"    const rd=new FileReader();rd.onload=()=>{const im=new Image();im.onload=async()=>{",
"      const M=192,k=Math.min(im.width,im.height),cv=document.createElement(\"canvas\");cv.width=M;cv.height=M;const g=cv.getContext(\"2d\");g.fillStyle=\"#fff\";g.fillRect(0,0,M,M);",
"      g.drawImage(im,(im.width-k)/2,(im.height-k)/2,k,k,0,0,M,M);let q=.85,d=cv.toDataURL(\"image/jpeg\",q);while(d.length>55000&&q>.4){q-=.1;d=cv.toDataURL(\"image/jpeg\",q)}",
"      try{await api(\"setAvatar\",{data:d});MYAV=d;cacheSave();paintAvatar($(\"#avatar\"));s.close();toast(\"\u062a\u0645 \u062d\u0641\u0638 \u0635\u0648\u0631\u0629 \u0627\u0644\u062d\u0633\u0627\u0628\")}catch(err){toast(err.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062d\u0641\u0638 \u0627\u0644\u0635\u0648\u0631\u0629\")}};",
"      im.onerror=()=>toast(\"\u062a\u0639\u0630\u0651\u0631 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0635\u0648\u0631\u0629\");im.src=rd.result};rd.readAsDataURL(f)};",
"  const dl=$(\"#avDel\");if(dl)dl.onclick=async()=>{try{await api(\"setAvatar\",{data:\"\"});MYAV=\"\";cacheSave();paintAvatar($(\"#avatar\"));s.close();toast(\"\u062a\u0645 \u062d\u0630\u0641 \u0635\u0648\u0631\u0629 \u0627\u0644\u062d\u0633\u0627\u0628\")}catch(err){toast(err.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0630\u0641\")}};",
"}",
"/* ---------- company logo ---------- */",
"function pickLogo(f){",
"  if(!/^image\\//.test(f.type)){toast(\"\u0627\u062e\u062a\u0631 \u0645\u0644\u0641 \u0635\u0648\u0631\u0629\");return}",
"  const rd=new FileReader();rd.onload=()=>{const im=new Image();im.onload=async()=>{",
"    const M=360,sc=Math.min(1,M/Math.max(im.width,im.height)),w=Math.max(1,Math.round(im.width*sc)),h=Math.max(1,Math.round(im.height*sc));",
"    const cv=document.createElement(\"canvas\");cv.width=w;cv.height=h;const g=cv.getContext(\"2d\");g.drawImage(im,0,0,w,h);",
"    let d=cv.toDataURL(\"image/png\");if(d.length>150000){const c2=document.createElement(\"canvas\");c2.width=w;c2.height=h;const g2=c2.getContext(\"2d\");g2.fillStyle=\"#fff\";g2.fillRect(0,0,w,h);g2.drawImage(im,0,0,w,h);d=c2.toDataURL(\"image/jpeg\",.85)}",
"    try{const r=await api(\"saveLogo\",{data:d});LOGO=d;try{ls.set(\"ccd-logo\",d);ls.set(\"ccd-logo-v\",r.v)}catch(e){}settings.logoV=r.v;paintLogo();toast(\"\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0634\u0639\u0627\u0631\");renderSettings()}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062d\u0641\u0638 \u0627\u0644\u0634\u0639\u0627\u0631\")}};",
"    im.onerror=()=>toast(\"\u062a\u0639\u0630\u0651\u0631 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0635\u0648\u0631\u0629\");im.src=rd.result};rd.readAsDataURL(f);",
"}",
