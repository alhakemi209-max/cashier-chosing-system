"/* ---------- cash & shortages (cashier lead) ---------- */",
"let sentLog=[];",
"function intlPhone(p){p=String(p||\"\").replace(/[\u0660-\u0669]/g,d=>\"\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669\".indexOf(d)).replace(/[^\\d]/g,\"\");",
"  if(p.indexOf(\"00\")===0)p=p.slice(2);",
"  if(p.indexOf(\"05\")===0&&p.length===10)p=\"966\"+p.slice(1);else if(p.indexOf(\"5\")===0&&p.length===9)p=\"966\"+p;",
"  return p.length>=11?p:\"\"}",
"function phoneOf(name){const ph=settings.phones||{};return ph[String(name||\"\").trim()]||\"\"}",
"const timeOf=iso=>{try{return new Date(iso).toLocaleTimeString(\"ar-SA-u-nu-latn\",{hour:\"numeric\",minute:\"2-digit\",timeZone:\"Asia/Riyadh\"})}catch(e){return\"\"}};",
"const leadDiff=b=>b.diff!=null?r2(b.diff):r2(boxCalc(b).diff);",
"const leadHas=b=>!!(b&&(b.cashier||b.cash||b.diff||b.report));",
"let leadSel=\"\";",
"function leadDates(){const t=todayISO(),o=[];for(let k=0;k<LEADD;k++){const d=addDays(t,-k);o.push([d,k===0?\"\u0627\u0644\u064a\u0648\u0645\":k===1?\"\u0623\u0645\u0633\":dayName(d)])}return o}",
"function leadPick(){const L=leadDates();if(!L.some(x=>x[0]===leadSel))leadSel=L[0][0];",
"  return`<div class=\"seg ldays\" role=\"group\" aria-label=\"\u0627\u0644\u064a\u0648\u0645\">${L.map(([d,l])=>`<button data-ld=\"${d}\" aria-pressed=\"${d===leadSel}\">${l}<small class=\"num\">${dmy(d).slice(0,5)}</small></button>`).join(\"\")}</div>`}",
"function bindLead(re){$(\"#view\").querySelectorAll(\"[data-ld]\").forEach(b=>b.onclick=()=>{leadSel=b.dataset.ld;re()})}",
"function leadDay(date){const d=days.get(date);return d&&!d.namesOnly?normDay(d):null}",
"let APPURL=\"\";",
"const newTk=()=>{const A=\"abcdefghijklmnopqrstuvwxyz0123456789\",b=new Uint8Array(24);try{crypto.getRandomValues(b)}catch(e){for(let k=0;k<24;k++)b[k]=Math.random()*256|0}return[...b].map(x=>A[x%36]).join(\"\")};",
"/* staff are female unless the accountant marks them male in settings */",
"/* who may send to staff: the lead, or a cashier supervisor the accountant allowed */",
"const canSendStaff=()=>{const r=effectiveRole();return(r===\"lead\"||r===\"sup\")&&can(\"wa\")},senderTitle=()=>(ROLES[effectiveRole()]||ROLES.lead).name;",
"const meF=(f,m)=>effectiveRole()===\"sup\"?m:f;",
"const isM=n=>((settings.genders||{})[String(n||\"\").trim()])===\"m\",G=(n,f,m)=>isM(n)?m:f;",
"function shortMsg(day,i,tk){const b=day.boxes[i],d=leadDiff(b),short=d<0;",
"  const line=\"\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\";",
"  return [`*${settings.store}*`,`${settings.branch}`,line,`*${short?\"\u0625\u0634\u0639\u0627\u0631 \u0639\u062c\u0632 \u0641\u064a \u0627\u0644\u0635\u0646\u062f\u0648\u0642\":\"\u0625\u0634\u0639\u0627\u0631 \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0627\u0644\u0635\u0646\u062f\u0648\u0642\"}*`,\"\",",
"    `${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0627\u0644\u0643\u0631\u064a\u0645\u0629\",\"\u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0643\u0631\u064a\u0645\")}: *${b.cashier||\"\"}*`,`\u0627\u0644\u062a\u0627\u0631\u064a\u062e: ${dayName(day.date)} ${dmy(day.date)}`,`\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642: ${BN(i)}`,`\u0627\u0644\u0643\u0627\u0634: ${fmt(b.cash)} \u0631\u064a\u0627\u0644`,",
"    `${short?\"\ud83d\udd34 \u0627\u0644\u0639\u062c\u0632\":\"\ud83d\udfe0 \u0627\u0644\u0632\u064a\u0627\u062f\u0629\"}: *${fmt(Math.abs(d))} \u0631\u064a\u0627\u0644*`,\"\",",
"    APPURL&&tk?`\u0644\u0639\u0631\u0636 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0627\u0637\u0644\u0627\u0639 (\u064a\u064f\u0637\u0644\u0628 \u0645\u0646\u0643 \u0622\u062e\u0631 4 \u0623\u0631\u0642\u0627\u0645 \u0645\u0646 \u062c\u0648\u0627\u0644\u0643):\\n${APPURL}?n=${tk}`:\"\",line,",
"    `_\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0628\u0648\u0627\u0633\u0637\u0629 ${senderTitle()}: ${me&&me.name||\"\"}_`].filter(x=>x!==\"\").join(\"\\n\").replace(/\\n\\n\\n+/g,\"\\n\\n\")}",
"const emailOf=n=>((settings.emails||{})[String(n||\"\").trim()])||\"\";",
"function sentPill(s){if(!s)return`<span class=\"note\">\u0644\u0645 \u064a\u064f\u0631\u0633\u0644 \u0628\u0639\u062f</span>`;",
"  return`<span class=\"pill saved\">\u0623\u064f\u0631\u0633\u0644 ${esc(s.ch||\"\u0648\u0627\u062a\u0633\u0627\u0628\")} ${esc(timeOf(s.at))}</span>${s.ack?`<span class=\"pill ackd\">\u2713 ${G(s.name,\"\u0623\u0643\u062f\u062a\",\"\u0623\u0643\u062f\")} \u0627\u0644\u0627\u0637\u0644\u0627\u0639 ${esc(String(s.ack).slice(11))}</span>`:s.seen?`<span class=\"pill seen\">\ud83d\udc41 ${G(s.name,\"\u0641\u062a\u062d\u062a\",\"\u0641\u062a\u062d\")} \u0627\u0644\u0625\u0634\u0639\u0627\u0631 ${esc(String(s.seen).slice(11))}</span>`:`<span class=\"pill wait\">${G(s.name,\"\u0644\u0645 \u062a\u0641\u062a\u062d\u0647\",\"\u0644\u0645 \u064a\u0641\u062a\u062d\u0647\")} \u0628\u0639\u062f</span>`}`}",
"function renderCash(){",
"  leadPick();$(\"#view\").innerHTML=leadPick()+leadDates().filter(x=>x[0]===leadSel).map(([date,lbl])=>{const day=leadDay(date);",
"    const rows=day?day.boxes.map((b,i)=>({b,i})).filter(x=>leadHas(x.b)):[];",
"    const tot=rows.reduce((s,x)=>s+(+x.b.cash||0),0);",
"    return `<div class=\"sec-h\"><h2>${lbl} \u2014 ${dayName(date)} <span class=\"num\">${dmy(date)}</span></h2></div>",
"     ${rows.length?`<div class=\"tbl-wrap\"><table><thead><tr><th>\u0627\u0644\u0635\u0646\u062f\u0648\u0642</th><th>\u0627\u0644\u0643\u0627\u0634\u064a\u0631</th><th class=\"n\">\u0627\u0644\u0643\u0627\u0634</th></tr></thead><tbody>",
"       ${rows.map(x=>`<tr><td class=\"num\">${BN(x.i)}</td><td>${esc(x.b.cashier)||\"\u2014\"}</td><td class=\"n num\">${fmt(x.b.cash)}</td></tr>`).join(\"\")}</tbody>",
"       <tfoot><tr><td colspan=\"2\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634</td><td class=\"n num\">${fmt(tot)}</td></tr></tfoot></table></div>`",
"     :`<div class=\"card empty\">\u0644\u0645 \u062a\u064f\u062d\u0641\u0638 \u0635\u0646\u0627\u062f\u064a\u0642 \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645 \u0628\u0639\u062f.</div>`}`}).join(\"\");",
"  bindLead(renderCash);",
"}",
"function shortCard(day,x){const {b,i,d}=x;const ph=intlPhone(phoneOf(b.cashier)),em=emailOf(b.cashier);const s=sentOf(day.date,i);",
"  const tk=newTk(),url=ph?`https://wa.me/${ph}?text=${encodeURIComponent(shortMsg(day,i,tk))}`:\"\";const neg=d<0,lead=canSendStaff();",
"  return `<div class=\"card scard ${neg?\"is-short\":\"is-over\"}\">",
"   <div class=\"sec-h\"><b>\u0635\u0646\u062f\u0648\u0642 <span class=\"num\">${BN(i)}</span> \u2014 ${esc(b.cashier)||\"\u0628\u062f\u0648\u0646 \u0627\u0633\u0645\"}</b><span class=\"pill ${neg?\"err\":\"dirty\"}\">${neg?\"\u0639\u062c\u0632\":\"\u0632\u064a\u0627\u062f\u0629\"} <span class=\"num\">${fmt(Math.abs(d))}</span></span></div>",
"   <div class=\"mini\"><span>\u0627\u0644\u0643\u0627\u0634 <b class=\"num\">${fmt(b.cash)}</b></span></div>",
"   <div class=\"sent-row\">${sentPill(s)}${!lead&&s?`<span class=\"note\">\u0628\u0648\u0627\u0633\u0637\u0629 ${esc(s.by||\"\")}</span>`:\"\"}</div>",
"   ${lead?`<div class=\"send-btns\"><button class=\"btn small img ${s?\"\":\"primary\"}\" data-img=\"${day.date}|${i}\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><circle cx=\"9\" cy=\"10\" r=\"2\"/><path d=\"M21 17l-5-5-9 8\"/></svg>${s?\"\u0625\u0639\u0627\u062f\u0629 \u0643\u0635\u0648\u0631\u0629\":\"\u0625\u0631\u0633\u0627\u0644 \u0643\u0635\u0648\u0631\u0629\"}</button>${url?`<a class=\"btn small wa\" href=\"${url}\" target=\"_blank\" rel=\"noopener\" data-send=\"${day.date}|${i}|${tk}\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 20l1.3-3.9A8 8 0 1 1 8 19z\"/></svg>${s?\"\u0625\u0639\u0627\u062f\u0629 \u0648\u0627\u062a\u0633\u0627\u0628\":\"\u0648\u0627\u062a\u0633\u0627\u0628\"}</a>`:`<span class=\"note\">\u0644\u0627 \u064a\u0648\u062c\u062f \u062c\u0648\u0627\u0644</span>`}",
"     ${em?`<button class=\"btn small mail\" data-mail=\"${day.date}|${i}\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg>\u0625\u064a\u0645\u064a\u0644</button>`:`<span class=\"note\">\u0644\u0627 \u064a\u0648\u062c\u062f \u0625\u064a\u0645\u064a\u0644</span>`}</div>`:\"\"}</div>`}",
"function renderShort(){",
"  leadPick();const sec=leadDates().filter(x=>x[0]===leadSel).map(([date,lbl])=>{const day=leadDay(date);",
"    const items=day?day.boxes.map((b,i)=>({b,i,d:leadDiff(b)})).filter(x=>leadHas(x.b)&&x.d!==0).sort((a,b)=>a.d-b.d):[];",
"    const tot=items.filter(x=>x.d<0).reduce((s,x)=>s+x.d,0);",
"    const sent=items.filter(x=>sentLog.some(e=>e.date===date&&e.box===x.i)).length;",
"    return `<div class=\"sec-h\"><h2>${lbl} \u2014 ${dayName(date)} <span class=\"num\">${dmy(date)}</span></h2>${items.length?`<span class=\"note num\">\u0623\u064f\u0631\u0633\u0644 ${sent} \u0645\u0646 ${items.length}</span>`:\"\"}</div>",
"     ${items.length?`<div class=\"stat wide short\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0639\u062c\u0632</span><b class=\"num\">${fmt(tot)}</b></div>`+items.map(x=>shortCard(day,x)).join(\"\"):`<div class=\"card empty\">${day?\"\u0644\u0627 \u064a\u0648\u062c\u062f \u0639\u062c\u0632 \u0623\u0648 \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645.\":\"\u0644\u0645 \u062a\u064f\u062d\u0641\u0638 \u0635\u0646\u0627\u062f\u064a\u0642 \u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645 \u0628\u0639\u062f.\"}</div>`}`}).join(\"\");",
"  $(\"#view\").innerHTML=`${leadPick()}<div class=\"info\">${!canSendStaff()?`\u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0622\u062e\u0631 ${LEADD} \u0623\u064a\u0627\u0645 (\u0627\u0637\u0644\u0627\u0639 \u0641\u0642\u0637)\u060c \u0645\u0639 \u062d\u0627\u0644\u0629 \u0625\u0631\u0633\u0627\u0644\u0647\u0627 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a.`:`\u064a\u0638\u0647\u0631 \u0647\u0646\u0627 \u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0622\u062e\u0631 ${LEADD} \u0623\u064a\u0627\u0645 \u0641\u0642\u0637\u060c \u0648\u0645\u0627 \u0642\u0628\u0644\u0647\u0627 \u064a\u062e\u062a\u0641\u064a \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b. \u0645\u0646 \u0647\u0646\u0627 \u064a\u064f\u0631\u0633\u0644 \u0625\u0634\u0639\u0627\u0631 \u0643\u0644 \u0635\u0646\u062f\u0648\u0642 \u0644\u0635\u0627\u062d\u0628\u0647 \u0643\u0635\u0648\u0631\u0629 \u0623\u0648 \u0648\u0627\u062a\u0633\u0627\u0628 \u0623\u0648 \u0625\u064a\u0645\u064a\u0644\u060c \u0648\u064a\u0648\u0635\u0644\u0647 \u0631\u0627\u0628\u0637 \u064a\u0641\u062a\u062d \u0645\u0646\u0647 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648\u064a\u0624\u0643\u062f \u0627\u0637\u0644\u0627\u0639\u0647\u060c \u0648\u062a\u0638\u0647\u0631 \u0627\u0644\u062d\u0627\u0644\u0629 \u0647\u0646\u0627.`}</div>${sec}`;",
"  bindLead(renderShort);",
"  $(\"#view\").querySelectorAll(\"[data-send]\").forEach(a=>a.addEventListener(\"click\",()=>{const v=a.dataset.send.split(\"|\");markSent(v[0],+v[1],v[2])}));",
"  $(\"#view\").querySelectorAll(\"[data-img]\").forEach(bt=>bt.onclick=()=>{const v=bt.dataset.img.split(\"|\");sendAsImage(v[0],+v[1],bt)});",
"  $(\"#view\").querySelectorAll(\"[data-mail]\").forEach(bt=>bt.onclick=async()=>{const v=bt.dataset.mail.split(\"|\");bt.disabled=true;bt.textContent=\"\u062c\u0627\u0631\u064d \u0627\u0644\u0625\u0631\u0633\u0627\u0644\u2026\";",
"    let img=\"\";try{const day=leadDay(v[0]);if(day)img=await blobURL(await noticePNG(day,+v[1]))}catch(e){img=\"\"}",
"    try{sentLog=await api(\"sendMail\",{date:v[0],box:+v[1],img});toast(\"\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u064a\u0645\u064a\u0644\");if(tab===\"short\"&&!layerOpen())renderShort()}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u064a\u0645\u064a\u0644\");bt.disabled=false;bt.textContent=\"\u0625\u064a\u0645\u064a\u0644\"}});",
"}",
"async function markSent(date,i,token){try{sentLog=await api(\"markSent\",{date,box:i,token});if(tab===\"short\"&&!layerOpen())renderShort();toast(\"\u0633\u064f\u062c\u0651\u0644 \u0627\u0644\u0625\u0631\u0633\u0627\u0644\")}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0625\u0631\u0633\u0627\u0644\")}}",
"",
