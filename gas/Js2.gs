"    im.onerror=()=>toast(\"\u062a\u0639\u0630\u0651\u0631 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0635\u0648\u0631\u0629\");im.src=rd.result};rd.readAsDataURL(f);",
"}",
