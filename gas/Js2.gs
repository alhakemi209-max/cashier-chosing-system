"  <div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0646\u0633\u062e \u0648\u0627\u0644\u062a\u0635\u062f\u064a\u0631</h3>",
"   <div class=\"set-acts\"><button class=\"act\" id=\"csvAll\" type=\"button\"><b>Excel \u0643\u0627\u0645\u0644</b><span class=\"note\">\u0643\u0644 \u0627\u0644\u0623\u064a\u0627\u0645 \u0648\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0641\u064a \u0645\u0644\u0641 \u0648\u0627\u062d\u062f</span></button>",
"   <button class=\"act\" id=\"bkOut\" type=\"button\"><b>\u0646\u0633\u062e\u0629 \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629</b><span class=\"note\">\u0645\u0644\u0641 \u064a\u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0648\u0643\u0644 \u0627\u0644\u0623\u064a\u0627\u0645</span></button></div></div>",
"  ${me.admin?`<div class=\"card\"><h3 class=\"set-h\">\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 Excel</h3><p class=\"note\" style=\"margin:0 0 10px\">\u0645\u0644\u0641 \u0628\u0633\u0637\u0631 \u0644\u0643\u0644 \u064a\u0648\u0645 \u0648\u0635\u0646\u062f\u0648\u0642: \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u060c \u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\u060c \u0627\u0644\u0643\u0627\u0634\u064a\u0631\u060c \u0627\u0644\u0643\u0627\u0634\u060c \u0627\u0644\u0634\u0628\u0643\u0627\u062a\u060c \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645. \u062a\u064f\u0636\u0627\u0641 \u0627\u0644\u0623\u064a\u0627\u0645 \u0648\u062a\u0638\u0647\u0631 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0639\u0646\u062f \u0643\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646.</p>",
"   <div class=\"row-btns\"><label class=\"btn primary\" for=\"impFile\">\u0627\u062e\u062a\u064a\u0627\u0631 \u0645\u0644\u0641 Excel</label><input type=\"file\" id=\"impFile\" accept=\".xlsx,.xls,.csv\" hidden><button class=\"btn\" id=\"impTpl\" type=\"button\">\u062a\u0646\u0632\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c</button></div></div>`:`<div class=\"info\">\u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 Excel \u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u0641\u0642\u0637.</div>`}`}",
"function bindData(){",
"  if($(\"#impFile\")){$(\"#impFile\").onchange=e=>{const f=e.target.files[0];e.target.value=\"\";if(f)importExcel(f)};$(\"#impTpl\").onclick=downloadTemplate}",
"  $(\"#bkOut\").onclick=()=>saveFile(`\u0646\u0633\u062e\u0629-\u0635\u0646\u0627\u062f\u064a\u0642-\u0627\u0644\u0643\u0627\u0634\u064a\u0631-${todayISO()}.json`,new Blob([JSON.stringify({settings,days:[...days.values()]},null,1)],{type:\"application/json\"}));",
"  $(\"#csvAll\").onclick=xlsxAll;",
"}",
"async function loadUsers(){try{usersCache=await api(\"users\");drawUsers()}catch(e){const L=$(\"#uList\");if(L)L.innerHTML=`<p class=\"note\">${esc(e.msg)}</p>`}}",
"function drawUsers(){",
"  const L=$(\"#uList\");if(!L||!usersCache)return;",
"  L.innerHTML=usersCache.map((u,i)=>{const P=u.perms||{},tags=u.role===\"acc\"?[u.top?`<span class=\"tag ok\">\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645</span>`:u.full?`<span class=\"tag ok\">\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0643\u0627\u0645\u0644\u0629</span>`:`<span class=\"tag\">${u.allbr?\"\u0643\u0644 \u0627\u0644\u0641\u0631\u0648\u0639\":\"\u0645\u062d\u0627\u0633\u0628 \u0641\u0631\u0639\"}</span>`]:((P.totals?[`<span class=\"tag\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a \u0641\u0642\u0637</span>`]:(P.tabs||[]).map(k=>`<span class=\"tag\">${TABN[k]}</span>`)).concat(P.wa?[`<span class=\"tag ok\">\u0625\u0631\u0633\u0627\u0644 \u0644\u0644\u0645\u0648\u0638\u0641\u064a\u0646</span>`]:[]).concat(u.role===\"sup\"?[apOf(P)?`<span class=\"tag\">\u064a\u062d\u062a\u0627\u062c \u0627\u0639\u062a\u0645\u0627\u062f</span>`:`<span class=\"tag ok\">\u0628\u062f\u0648\u0646 \u0627\u0639\u062a\u0645\u0627\u062f</span>`]:[]));",
"    return`<button class=\"person\" type=\"button\" data-u=\"${i}\"><span class=\"av ${u.active?\"\":\"off\"}\">${esc(String(u.name||u.username).trim().charAt(0))}</span><span class=\"p-txt\"><b>${esc(u.name)} <span class=\"role ${u.active?\"\":\"off\"}\">${u.active?esc(u.roleName):\"\u0645\u0648\u0642\u0648\u0641\"}</span></b>",
"     <span class=\"note\" dir=\"ltr\" style=\"text-align:right\">${esc(u.username)}</span><span class=\"p-tags\">${tags.join(\"\")}</span></span><span class=\"set-chev\">${svgI(\"chev\")}</span></button>`}).join(\"\");",
"  L.querySelectorAll(\"[data-u]\").forEach(b=>b.onclick=()=>editUser(usersCache[+b.dataset.u]));",
"}",
"function editUser(u){",
"  if(u&&u.top&&!me.top){toast(\"\u062d\u0633\u0627\u0628 \u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645 \u064a\u0639\u062f\u0651\u0644\u0647 \u0635\u0627\u062d\u0628\u0647 \u0641\u0642\u0637\");return}",
"  const isNew=!u;u=u||{username:\"\",name:\"\",role:\"sup\",active:true};const self=!isNew&&u.username===me.username;",
"  const body=`<div class=\"field\"><label for=\"u-name\">\u0627\u0644\u0627\u0633\u0645</label><input class=\"inp\" id=\"u-name\" value=\"${esc(u.name)}\"></div>",
"   <div class=\"field\"><label for=\"u-user\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645</label><input class=\"inp\" id=\"u-user\" dir=\"ltr\" autocapitalize=\"none\" spellcheck=\"false\" value=\"${esc(u.username)}\" ${isNew?\"\":\"readonly\"}></div>",
"   <div class=\"field\"><label for=\"u-role\">\u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629</label><select class=\"inp\" id=\"u-role\" ${self?\"disabled\":\"\"}>${Object.entries(ROLES).map(([k,v])=>`<option value=\"${k}\" ${u.role===k?\"selected\":\"\"}>${v.name}</option>`).join(\"\")}</select></div>",
"   <div id=\"u-br\"></div>",
"   <div id=\"u-full\"></div>",
"   <div id=\"u-perms\"></div>",
"   <div class=\"field\"><label for=\"u-pass\">${isNew?\"\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631\":\"\u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u062c\u062f\u064a\u062f\u0629\"}</label><input class=\"inp\" id=\"u-pass\" type=\"text\" dir=\"ltr\" autocomplete=\"off\" autocapitalize=\"none\" placeholder=\"${isNew?\"4 \u0623\u062d\u0631\u0641 \u0623\u0648 \u0623\u0631\u0642\u0627\u0645 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\":\"\u0627\u062a\u0631\u0643\u0647\u0627 \u0641\u0627\u0631\u063a\u0629 \u0644\u0639\u062f\u0645 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\"}\"></div>",
"   <label class=\"chk\"><input type=\"checkbox\" id=\"u-active\" ${u.active?\"checked\":\"\"} ${self?\"disabled\":\"\"}>\u0627\u0644\u062d\u0633\u0627\u0628 \u0641\u0639\u0651\u0627\u0644</label>",
"   <p class=\"note\">\u0639\u0646\u062f \u062a\u063a\u064a\u064a\u0631 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0623\u0648 \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u062d\u0633\u0627\u0628 \u064a\u062e\u0631\u062c \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0646 \u0643\u0644 \u0627\u0644\u0623\u062c\u0647\u0632\u0629.</p>`;",
"  const s=sheet(isNew?\"\u0645\u0633\u062a\u062e\u062f\u0645 \u062c\u062f\u064a\u062f\":\"\u062a\u0639\u062f\u064a\u0644 \u0645\u0633\u062a\u062e\u062f\u0645\",body,`${!isNew&&!self&&!u.top?`<button class=\"btn danger\" id=\"uDel\">\u062d\u0630\u0641</button>`:\"\"}<button class=\"btn primary\" id=\"uSave\">\u062d\u0641\u0638</button>`);",
"  const brUI=role=>{const L=ALLBR||BRANCHES||[],box=$(\"#u-br\");if(!box)return;",
"    if(role===\"own\"){const pb=u.perms&&Array.isArray(u.perms.branches)?u.perms.branches:null;box.innerHTML=L.length>1?`<div class=\"perm\"><b>\u0627\u0644\u0641\u0631\u0648\u0639 \u0627\u0644\u0644\u064a \u064a\u0637\u0651\u0644\u0639 \u0639\u0644\u064a\u0647\u0627</b><div class=\"ptabs\">${L.map(b=>`<label class=\"chk\"><input type=\"checkbox\" data-ubr=\"${esc(b.id)}\" ${!pb||pb.indexOf(b.id)>=0?\"checked\":\"\"}>${esc(b.name)}</label>`).join(\"\")}</div></div>`:\"\";fullUI(role);return}",
"    const cur=u.branch||(role===\"acc\"?\"*\":\"main\");",
"    box.innerHTML=L.length>1||role===\"acc\"?`<div class=\"field\"><label for=\"u-branch\">\u0627\u0644\u0641\u0631\u0639</label><select class=\"inp\" id=\"u-branch\" ${self?\"disabled\":\"\"}>${role===\"acc\"?`<option value=\"*\" ${cur===\"*\"?\"selected\":\"\"}>\u0643\u0644 \u0627\u0644\u0641\u0631\u0648\u0639</option>`:\"\"}${L.map(b=>`<option value=\"${esc(b.id)}\" ${cur===b.id?\"selected\":\"\"}>${esc(b.name)}</option>`).join(\"\")}</select></div>`:\"\";",
"    fullUI(role)};",
"  const fullUI=role=>{const f=$(\"#u-full\");if(!f)return;const sel=$(\"#u-branch\"),on=role===\"acc\"&&(!sel||sel.value===\"*\")&&!u.top&&me.top;",
"    f.innerHTML=on?`<label class=\"chk\"><input type=\"checkbox\" id=\"u-fullc\" ${u.full?\"checked\":\"\"}>\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0643\u0627\u0645\u0644\u0629: \u0647\u0648\u064a\u0629 \u0627\u0644\u0634\u0631\u0643\u0629\u060c \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 Excel\u060c \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0648\u0627\u0644\u0641\u0631\u0648\u0639</label><p class=\"note\">\u0628\u062f\u0648\u0646\u0647\u0627 \u064a\u062f\u062e\u0644 \u0648\u064a\u0639\u062f\u0651\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0641\u0642\u0637\u060c \u0648\u0627\u0644\u0647\u0648\u064a\u0629 \u0648\u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u062a\u0628\u0642\u0649 \u0644\u0643.</p>`",
"     :role===\"acc\"&&u.top?`<div class=\"info\" style=\"margin:0 0 12px\">\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645: \u0647\u0648\u064a\u0629 \u0627\u0644\u0634\u0631\u0643\u0629 \u0648\u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 Excel \u0648\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0648\u0627\u0644\u0641\u0631\u0648\u0639.</div>`:\"\";",
"    if(sel)sel.onchange=()=>fullUI(role)};",
"  brUI(u.role);permsUI(u.role,u.perms);$(\"#u-role\").onchange=e=>{brUI(e.target.value);permsUI(e.target.value,null)};",
"  $(\"#uSave\").onclick=async()=>{const b=$(\"#uSave\");b.disabled=true;",
"    try{usersCache=await api(\"saveUser\",{isNew,username:$(\"#u-user\").value,name:$(\"#u-name\").value,role:$(\"#u-role\").value,password:$(\"#u-pass\").value,active:$(\"#u-active\").checked,perms:permsRead(),full:!!($(\"#u-fullc\")&&$(\"#u-fullc\").checked),branch:$(\"#u-branch\")?$(\"#u-branch\").value:(u.branch||\"\")});",
"      s.close();drawUsers();toast(\"\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\")}catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0641\u0638\");b.disabled=false}};",
"  const d=$(\"#uDel\");if(d)d.onclick=async()=>{const v=await ask(\"\u062d\u0630\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u00ab\"+esc(u.name)+\"\u00bb \u0646\u0647\u0627\u0626\u064a\u0627\u064b\u061f\",[{t:\"\u062d\u0630\u0641\",v:1,cls:\"danger\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]);",
"    if(!v){editUser(u);return}try{usersCache=await api(\"deleteUser\",{username:u.username});drawUsers();toast(\"\u062a\u0645 \u062d\u0630\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\")}catch(e){toast(e.msg)}};",
"}",
