"/* which sections a user sees: users and branches belong to the system's main accountant */",
"function secBank(){const F=bfCfg(),L=bfPlans(),P=L[L.length-1],fresh=!(F.plans||[]).length,R=P.rates||{};",
"  const shown=NETS.filter(([k])=>(settings.netsOff||[]).indexOf(k)<0||R[k]!=null);",
"  return`<div class=\"card\"><h3 class=\"set-h\">\u0627\u062d\u062a\u0633\u0627\u0628 \u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0628\u0646\u0643</h3>",
"   <label class=\"chk\"><input type=\"checkbox\" id=\"s-bfOn\" ${F.on?\"checked\":\"\"}>\u0627\u062d\u062a\u0633\u0627\u0628 \u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0628\u0646\u0643 \u0639\u0644\u0649 \u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0634\u0628\u0643\u0627\u062a</label>",
"   <p class=\"note\" style=\"margin:4px 0 0\">\u062a\u0638\u0647\u0631 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0641\u064a \u0645\u0644\u062e\u0635 \u0627\u0644\u064a\u0648\u0645 \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 (\u064a\u0648\u0645\u060c \u0623\u0633\u0628\u0648\u0639\u060c \u0634\u0647\u0631\u060c \u0633\u0646\u0629\u060c \u0641\u062a\u0631\u0629) \u0644\u0644\u0645\u062d\u0627\u0633\u0628 \u0648\u0627\u0644\u0645\u062f\u064a\u0631 \u0648\u0627\u0644\u0645\u0627\u0644\u0643\u060c \u0648\u0644\u0627 \u062a\u063a\u064a\u0651\u0631 \u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642.</p></div>",
"  <div id=\"bfBody\" ${F.on?\"\":\"hidden\"}><div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0627\u0644\u0645\u062d\u062a\u0633\u0628\u0629 \u0648\u0646\u0633\u0628\u0647\u0627</h3>",
"   <p class=\"note\" style=\"margin:0 0 6px\">\u0627\u062e\u062a\u0631 \u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0627\u0644\u0644\u064a \u062a\u0628\u063a\u0649 \u062a\u0637\u0644\u0639 \u0639\u0645\u0648\u0644\u062a\u0647\u0627\u060c \u0648\u0627\u0643\u062a\u0628 \u0646\u0633\u0628\u0629 \u0643\u0644 \u0648\u062d\u062f\u0629. \u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0627\u0644\u0645\u0639\u0631\u0648\u0636\u0629 \u0647\u064a \u0627\u0644\u0645\u0641\u0639\u0651\u0644\u0629 \u0641\u064a \u00ab\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u00bb\u060c \u0648\u0623\u064a \u0634\u0628\u0643\u0629 \u062a\u0641\u0639\u0651\u0644\u0647\u0627 \u0647\u0646\u0627\u0643 \u062a\u0638\u0647\u0631 \u0647\u0646\u0627.</p>",
"   <div class=\"fx-list\">${shown.map(([k,l])=>{const on=fresh?true:R[k]!=null;return`<div class=\"fx-row\"><label class=\"chk\" style=\"padding:0\"><input type=\"checkbox\" data-bfon=\"${k}\" ${on?\"checked\":\"\"}><span>${l}</span></label><label class=\"fx-rate\"><span class=\"note\">\u0646\u0633\u0628\u0629 \u0627\u0644\u0628\u0646\u0643 %</span><input class=\"inp money\" id=\"bf-${k}\" inputmode=\"decimal\" dir=\"ltr\" value=\"${esc(R[k]!=null?R[k]:BF_DEF[k])}\" ${on?\"\":\"disabled\"}></label></div>`}).join(\"\")}</div>",
"   <label class=\"chk\" style=\"margin-top:10px\"><input type=\"checkbox\" id=\"s-bfVat\" ${F.vat!==false?\"checked\":\"\"}>\u062a\u064f\u0636\u0627\u0641 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629 15% \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0648\u0644\u0629</label>",
"   <p class=\"note\" style=\"margin:10px 0 0\">${fresh?\"\u0623\u0648\u0644 \u062d\u0641\u0638 \u064a\u0637\u0628\u0651\u0642 \u0627\u0644\u0646\u0633\u0628 \u0639\u0644\u0649 \u0643\u0644 \u0627\u0644\u0623\u064a\u0627\u0645.\":`\u0627\u0644\u0646\u0633\u0628 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0645\u0637\u0628\u0651\u0642\u0629 ${P.from>\"2000-01-01\"?\"\u0645\u0646 \"+dmy(P.from):\"\u0639\u0644\u0649 \u0643\u0644 \u0627\u0644\u0623\u064a\u0627\u0645\"}. \u0625\u0630\u0627 \u063a\u064a\u0651\u0631\u062a \u0623\u064a \u0646\u0633\u0628\u0629 \u064a\u0633\u0623\u0644\u0643 \u0627\u0644\u0646\u0638\u0627\u0645 \u0639\u0646\u062f \u0627\u0644\u062d\u0641\u0638: \u062a\u0635\u062d\u064a\u062d \u0644\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u0629\u060c \u0623\u0648 \u062a\u063a\u064a\u064a\u0631 \u0644\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0642\u0627\u062f\u0645\u0629 \u0641\u0642\u0637.`}</p></div>",
"   ${L.length>1?`<div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0646\u0633\u0628 \u0627\u0644\u0633\u0627\u0628\u0642\u0629</h3>${L.slice(0,-1).reverse().map(x=>`<div class=\"calc\" style=\"font-weight:400;align-items:center\"><span><b>${x.from>\"2000-01-01\"?\"\u0645\u0646 \"+dmy(x.from):\"\u0645\u0646 \u0627\u0644\u0628\u062f\u0627\u064a\u0629\"}</b><span class=\"note\"> \u00b7 ${NETS.filter(([k])=>(x.rates||{})[k]!=null).map(([k])=>BF_SHORT[k]+\" \"+x.rates[k]+\"%\").join(\"\u060c \")}</span></span><button class=\"btn small\" type=\"button\" data-bfdel=\"${x.from}\">\u062d\u0630\u0641</button></div>`).join(\"\")}</div>`:\"\"}",
"   <div class=\"card\"><h3 class=\"set-h\">\u0641\u064a \u0627\u0644\u0633\u0648\u0642 \u0627\u0644\u0633\u0639\u0648\u062f\u064a</h3><p class=\"note\" style=\"margin:0\">\u0645\u062f\u0649 \u063a\u0627\u0644\u0628\u0627\u064b 0.8% (\u0648\u0628\u0639\u0636 \u0627\u0644\u0628\u0646\u0648\u0643 0.7% \u0644\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u062d\u062a\u0649 100 \u0631\u064a\u0627\u0644)\u060c \u0648\u0627\u0644\u0641\u064a\u0632\u0627 \u0648\u0627\u0644\u0645\u0627\u0633\u062a\u0631\u0643\u0627\u0631\u062f \u0648\u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062e\u0644\u064a\u062c\u064a\u0629 \u063a\u0627\u0644\u0628\u0627\u064b \u0628\u064a\u0646 1.5% \u06482.5%\u060c \u0648\u0628\u0639\u0636 \u0627\u0644\u0628\u0646\u0648\u0643 \u062a\u0636\u064a\u0641 \u0631\u0633\u0645\u0627\u064b \u062b\u0627\u0628\u062a\u0627\u064b \u0639\u0644\u0649 \u0643\u0644 \u0639\u0645\u0644\u064a\u0629 \u0623\u0648 \u0631\u0633\u0645\u0627\u064b \u0634\u0647\u0631\u064a\u0627\u064b \u0644\u0644\u062c\u0647\u0627\u0632 \u0625\u0630\u0627 \u0642\u0644\u0651\u062a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a. \u0648\u062a\u064f\u0636\u0627\u0641 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629 15% \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0646\u0641\u0633\u0647\u0627 \u0648\u0644\u064a\u0633 \u0639\u0644\u0649 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a. \u0627\u0639\u062a\u0645\u062f \u0627\u0644\u0646\u0633\u0628 \u0627\u0644\u0645\u0643\u062a\u0648\u0628\u0629 \u0641\u064a \u0639\u0642\u062f\u0643 \u0645\u0639 \u0627\u0644\u0628\u0646\u0643 \u0623\u0648 \u0643\u0634\u0641 \u0627\u0644\u062a\u0633\u0648\u064a\u0629.</p></div></div>`;",
"}",
"function bindBank(){$(\"#s-bfOn\").onchange=e=>{$(\"#bfBody\").hidden=!e.target.checked};",
"  $(\"#view\").querySelectorAll(\"[data-bfon]\").forEach(c=>c.onchange=()=>{const e=$(\"#bf-\"+c.dataset.bfon);if(e)e.disabled=!c.checked});",
"  $(\"#view\").querySelectorAll(\"[data-bfdel]\").forEach(b=>b.onclick=()=>{const L=bfPlans().filter(x=>x.from!==b.dataset.bfdel);settings.bankFee=Object.assign({},bfCfg(),{plans:L});setDirty=true;renderSettingsKeep()})}",
"function renderSettingsKeep(){const d=setDirty;renderSettings();setDirty=d}",
"function bankRead(){",
"  const on=$(\"#s-bfOn\").checked,F=bfCfg();if(!on)return Object.assign({},F,{on:false});",
"  const rates={};for(const [k,l] of NETS){const e=$(\"#bf-\"+k),c=document.querySelector(`[data-bfon=\"${k}\"]`);if(!e||!c||!c.checked)continue;const v=num(e.value);",
"    if(!/^\\s*[\\d\u0660-\u0669\u06f0-\u06f9]*[.\u066b,]?[\\d\u0660-\u0669\u06f0-\u06f9]+\\s*%?\\s*$/.test(e.value)||!(v>=0&&v<=20)){toast(\"\u0627\u0643\u062a\u0628 \u0646\u0633\u0628\u0629 \u0635\u062d\u064a\u062d\u0629 \u0644\u0640 \"+l+\" (\u0645\u0646 0 \u0625\u0644\u0649 20%)\");e.focus();return null}rates[k]=r2(v*1000)/1000}",
"  if(!Object.keys(rates).length){toast(\"\u0627\u062e\u062a\u0631 \u0634\u0628\u0643\u0629 \u0648\u0627\u062d\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0644\u0627\u062d\u062a\u0633\u0627\u0628 \u0639\u0645\u0648\u0644\u062a\u0647\u0627\");return null}",
"  return{on:true,vat:$(\"#s-bfVat\").checked,rates};",
"}",
"const sameRates=(a,b)=>{const A=Object.keys(a||{}),B=Object.keys(b||{});return A.length===B.length&&A.every(k=>(b||{})[k]!=null&&+a[k]===+b[k])};",
"/* when the rates change the accountant decides: correct a mistake (earlier days follow the new rates) or a new bank rate (only the coming days) */",
"function bfApplyAsk(P){return new Promise(res=>{const t=todayISO(),since=P.from>\"2000-01-01\"?`\u0627\u0644\u0623\u064a\u0627\u0645 \u0645\u0646 ${dmy(P.from)}`:\"\u0643\u0644 \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u0629\";",
"  const s=sheet(\"\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0646\u0633\u0628 \u0627\u0644\u062c\u062f\u064a\u062f\u0629\",`<p style=\"margin:6px 0 10px\">\u063a\u064a\u0651\u0631\u062a \u0646\u0633\u0628 \u0627\u0644\u0639\u0645\u0648\u0644\u0629. \u0643\u064a\u0641 \u062a\u0628\u064a \u062a\u0637\u0628\u0651\u0642\u0647\u0627\u061f</p>",
"   <label class=\"radio-row\"><input type=\"radio\" name=\"bfm\" value=\"fix\" checked><span><b>\u062a\u0635\u062d\u064a\u062d \u062e\u0637\u0623 \u0641\u064a \u0627\u0644\u0646\u0633\u0628\u0629</b><span class=\"note\">\u062a\u062a\u0639\u062f\u0644 ${since} \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629\u060c \u0643\u0623\u0646 \u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0644\u0635\u062d\u064a\u062d\u0629 \u0643\u0627\u0646\u062a \u0645\u0646 \u0627\u0644\u0628\u062f\u0627\u064a\u0629.</span></span></label>",
"   <label class=\"radio-row\"><input type=\"radio\" name=\"bfm\" value=\"new\"><span><b>\u062a\u063a\u064a\u064a\u0631 \u062c\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0628\u0646\u0643</b><span class=\"note\">\u062a\u0628\u0642\u0649 \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0639\u0644\u0649 \u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\u060c \u0648\u062a\u062a\u0637\u0628\u0651\u0642 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0645\u0646 \u0627\u0644\u062a\u0627\u0631\u064a\u062e:</span>",
"    <input type=\"date\" class=\"inp\" id=\"bfNewFrom\" value=\"${t}\" style=\"margin-top:6px\"></span></label>`,",
"   `<button class=\"btn primary\" type=\"button\" id=\"bfOk\">\u062d\u0641\u0638</button><button class=\"btn\" type=\"button\" data-close>\u0625\u0644\u063a\u0627\u0621</button>`,()=>res(null));",
"  s.el.querySelector(\"#bfNewFrom\").onfocus=()=>{s.el.querySelector('[name=\"bfm\"][value=\"new\"]').checked=true};",
"  s.el.querySelector(\"#bfOk\").onclick=()=>{const m=s.el.querySelector('[name=\"bfm\"]:checked').value,d=s.el.querySelector(\"#bfNewFrom\").value;",
"    if(m===\"new\"&&!/^\\d{4}-\\d{2}-\\d{2}$/.test(d)){toast(\"\u0627\u062e\u062a\u0631 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0644\u064a \u062a\u0628\u062f\u0623 \u0645\u0646\u0647 \u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629\");return}",
"    if(m===\"new\"&&d<=P.from){toast(\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0644\u0627\u0632\u0645 \u064a\u0643\u0648\u0646 \u0628\u0639\u062f \"+(P.from>\"2000-01-01\"?dmy(P.from):\"\u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0646\u0633\u0628 \u0627\u0644\u062d\u0627\u0644\u064a\u0629\")+\"\u060c \u0623\u0648 \u0627\u062e\u062a\u0631 \u00ab\u062a\u0635\u062d\u064a\u062d \u062e\u0637\u0623\u00bb\");return}",
"    $(\"#layer\").innerHTML=\"\";res({mode:m,from:d})}})}",
"async function bankSave(){",
"  const v=bankRead();if(!v)return null;if(!v.on)return v;",
"  const F=bfCfg(),fresh=!(F.plans||[]).length;let L=bfPlans().map(x=>({from:x.from,rates:Object.assign({},x.rates)}));const P=L[L.length-1];",
"  if(fresh)L=[{from:\"2000-01-01\",rates:v.rates}];",
"  else if(!sameRates(v.rates,P.rates)){const a=await bfApplyAsk(P);if(!a)return null;",
"    if(a.mode===\"fix\")P.rates=v.rates;else{L=L.filter(x=>x.from!==a.from);L.push({from:a.from,rates:v.rates});L.sort((x,y)=>x.from<y.from?-1:1)}}",
"  return{on:true,vat:v.vat,plans:L.slice(-24)};",
"}",
"/* year close: carry the balances into the new year and keep the last 36 months in the main sheet */",
"function secYear(){return`<div id=\"yrBody\"><div class=\"card empty\">\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0645\u064a\u0644\u2026</div></div>`}",
"async function bindYear(){",
"  let I;try{I=await api(\"years\")}catch(e){$(\"#yrBody\").innerHTML=`<div class=\"card empty\">${esc(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062a\u062d\u0645\u064a\u0644\")}</div>`;return}",
"  drawYear(I);",
"}",
"function drawYear(I){",
"  const cy=I.today.slice(0,4),Y=I.years.slice();if(!Y.some(y=>y.year===cy))Y.unshift({year:cy,days:0,closed:null});",
"  const sm=(t)=>t?`<div class=\"yr-sum\"><span>\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a <b class=\"num\">${fmt((t.cash||0)+(t.net||0))}</b></span><span>\u0627\u0644\u0623\u064a\u0627\u0645 <b class=\"num\">${t.days}</b></span><span>\u0627\u0644\u0632\u064a\u0627\u062f\u0629/\u0627\u0644\u0646\u0642\u0635 <b class=\"num\">${fmtS(t.diff||0)}</b></span></div>`:\"\";",
"  $(\"#yrBody\").innerHTML=`<div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0633\u0646\u0648\u0627\u062a</h3><p class=\"note\" style=\"margin:0 0 8px\">\u0625\u0642\u0641\u0627\u0644 \u0627\u0644\u0633\u0646\u0629 \u064a\u0631\u062d\u0651\u0644 \u0631\u0635\u064a\u062f \u0625\u0642\u0641\u0627\u0644 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0644\u0634\u0647\u0631 \u064a\u0646\u0627\u064a\u0631 \u0645\u0646 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629\u060c \u0648\u062a\u0628\u0642\u0649 \u0623\u0631\u0635\u062f\u0629 \u0627\u0644\u0639\u0647\u062f \u0645\u0633\u062a\u0645\u0631\u0629\u060c \u0648\u062a\u0635\u064a\u0631 \u0623\u064a\u0627\u0645 \u0627\u0644\u0633\u0646\u0629 \u0644\u0644\u0627\u0637\u0644\u0627\u0639 \u0648\u0627\u0644\u0637\u0628\u0627\u0639\u0629 \u0641\u0642\u0637. \u0648\u062a\u0642\u062f\u0631 \u062a\u0639\u064a\u062f \u0641\u062a\u062d\u0647\u0627 \u0648\u0642\u062a \u0645\u0627 \u062a\u062d\u062a\u0627\u062c.</p>",
"   ${Y.map(y=>{const c=y.closed;return`<div class=\"yr-row\"><div><b class=\"num\">${y.year}</b><span class=\"note\"> \u00b7 <span class=\"num\">${y.days}</span> \u064a\u0648\u0645${c?` \u00b7 \u0645\u0642\u0641\u0644\u0629 ${esc(c.at||\"\")} \u0628\u0648\u0627\u0633\u0637\u0629 ${esc(c.by||\"\")}`:y.year===cy?\" \u00b7 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629\":\" \u00b7 \u0645\u0641\u062a\u0648\u062d\u0629\"}</span>",
