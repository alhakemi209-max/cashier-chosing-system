"    $(\"#p-apNote\").textContent=x.dataset.ap===\"1\"?\"\u062a\u0638\u0647\u0631 \u0625\u062f\u062e\u0627\u0644\u0627\u062a\u0647 \u0644\u0644\u0645\u062d\u0627\u0633\u0628 \u00ab\u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f\u00bb\u060c \u0648\u0645\u0627 \u062a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0625\u0644\u0627 \u0628\u0639\u062f \u0645\u0627 \u064a\u0639\u062a\u0645\u062f\u0647\u0627.\":\"\u0625\u062f\u062e\u0627\u0644\u0627\u062a\u0647 \u062a\u062f\u062e\u0644 \u0641\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0623\u0648\u0644 \u0645\u0627 \u064a\u062d\u0641\u0638\u0647\u0627\u060c \u0628\u062f\u0648\u0646 \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0639\u062a\u0645\u0627\u062f.\"});",
"  const tt=$(\"#p-tot\"),lock=()=>document.querySelectorAll(\"[data-pt]\").forEach(x=>{x.disabled=tt.checked;x.parentElement.style.opacity=tt.checked?.45:\"\"});if(tt){tt.onchange=lock;lock()}",
