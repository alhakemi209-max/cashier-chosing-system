"/* ---------- weekly sales (branch manager) ---------- */",
"function weekSales(){return leadDates().map(([d,l])=>{const raw=days.get(d);const day=raw&&!raw.namesOnly?normDay(raw):null;return{d,l,t:day?dayCalc(day):null}})}",
"function renderSales(){",
"  const W=weekSales(),H=W.filter(x=>x.t&&x.t.count);",
"  const T=H.reduce((a,x)=>{a.s+=x.t.reportNet;a.c+=x.t.cashNet;a.n+=x.t.net;a.d+=x.t.diff;return a},{s:0,c:0,n:0,d:0});T.d=r2(T.d);",
"  $(\"#view\").innerHTML=`<div class=\"info\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0644\u0622\u062e\u0631 ${LEADD} \u0623\u064a\u0627\u0645 (\u0627\u0637\u0644\u0627\u0639 \u0641\u0642\u0637).</div>",
"  ${H.length?`<div class=\"strip\"><div class=\"stat\"><span>\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0623\u0633\u0628\u0648\u0639</span><b class=\"num\">${fmt(T.s)}</b></div>",
"   <div class=\"stat\"><span>\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u064a\u0648\u0645</span><b class=\"num\">${fmt(T.s/H.length)}</b></div>",
"   <div class=\"stat ${T.d<0?\"short\":T.d>0?\"over\":\"ok\"}\"><span>\u0635\u0627\u0641\u064a \u0627\u0644\u0639\u062c\u0632 / \u0627\u0644\u0632\u064a\u0627\u062f\u0629</span><b class=\"num\">${fmt(T.d)}</b></div></div>",
"   <div class=\"row-btns\"><button class=\"btn primary\" id=\"slPrint\">\u0637\u0628\u0627\u0639\u0629</button></div>`:\"\"}",
"  <div class=\"tbl-wrap\"><table><thead><tr><th>\u0627\u0644\u064a\u0648\u0645</th><th class=\"n\">\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0643\u0627\u0634</th><th class=\"n\">\u0627\u0644\u0634\u0628\u0643\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0641\u0631\u0642</th></tr></thead><tbody>",
"  ${W.map(x=>`<tr><td>${x.l===dayName(x.d)?x.l:x.l+\" \u2014 \"+dayName(x.d)}<div class=\"note num\">${dmy(x.d)}</div></td>${x.t&&x.t.count?`<td class=\"n num\"><b>${fmt(x.t.reportNet)}</b></td><td class=\"n num\">${fmt(x.t.cashNet)}</td><td class=\"n num\">${fmt(x.t.net)}</td><td class=\"n num ${x.t.diff<0?\"neg\":x.t.diff>0?\"pos\":\"\"}\">${fmt(x.t.diff)}</td>`:`<td class=\"n\" colspan=\"4\"><span class=\"note\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a</span></td>`}</tr>`).join(\"\")}</tbody>",
"  ${H.length?`<tfoot><tr><td>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n num\">${fmt(T.s)}</td><td class=\"n num\">${fmt(T.c)}</td><td class=\"n num\">${fmt(T.n)}</td><td class=\"n num\">${fmt(T.d)}</td></tr></tfoot>`:\"\"}</table></div>`;",
"  const p=$(\"#slPrint\");if(p)p.onclick=()=>preview(\"\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0623\u0633\u0628\u0648\u0639\",rcptSales(W,T),`\u0645\u0628\u064a\u0639\u0627\u062a-\u0627\u0644\u0623\u0633\u0628\u0648\u0639-${todayISO()}.pdf`);",
"}",
"function rcptSales(W,T){",
"  const f=W[W.length-1].d,t=W[0].d;",
"  return`<div class=\"rcpt\">${head(\"\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u064a\u0629\",`<div class=\"c\" style=\"font-weight:700\">\u0645\u0646 ${dmy(f)} \u0625\u0644\u0649 ${dmy(t)}</div>`)}",
"  <table><thead><tr><th>\u0627\u0644\u064a\u0648\u0645</th><th class=\"n\">\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0641\u0631\u0642</th></tr></thead><tbody>",
"  ${W.slice().reverse().map(x=>`<tr><td>${dayName(x.d)} ${dmy(x.d).slice(0,5)}</td><td class=\"n\">${x.t&&x.t.count?fmt(x.t.reportNet):\"\u2014\"}</td><td class=\"n\">${x.t&&x.t.count?fmt(x.t.diff):\"\u2014\"}</td></tr>`).join(\"\")}</tbody>",
"  <tfoot><tr><td>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n\">${fmt(T.s)}</td><td class=\"n\">${fmt(T.d)}</td></tr></tfoot></table></div>`;",
"}",
"/* ---------- shortage notices seen by the accountant ---------- */",
"function sentOf(date,i){const L=sentLog.filter(e=>e.date===date&&e.box===i);if(!L.length)return undefined;",
"  return Object.assign({},L[L.length-1],{ch:[...new Set(L.map(e=>e.ch||\"\u0648\u0627\u062a\u0633\u0627\u0628\"))].join(\" \u0648\"),ack:(L.filter(e=>e.ack).pop()||{}).ack||\"\",seen:(L.filter(e=>e.seen).map(e=>e.seen).sort()[0])||\"\"})}",
"function sentBadge(i){if(effectiveRole()!==\"acc\")return\"\";return sentOf(cur.date,i)?'<span class=\"sn\">\u2713 \u0623\u064f\u0631\u0633\u0644</span>':\"\"}",
"function sentInfo(i){",
"  if(effectiveRole()!==\"acc\")return\"\";const sv=days.get(cur.date),b=sv&&!sv.namesOnly&&sv.boxes?sv.boxes[i]:null;if(!b||!hasData(b))return\"\";",
"  const d=boxCalc(b).diff,s=sentOf(cur.date,i);",
"  if(s)return`<div class=\"info\" style=\"margin:8px 0\">\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 ${d<0?\"\u0627\u0644\u0639\u062c\u0632\":d>0?\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629\":\"\u0627\u0644\u062a\u0642\u0631\u064a\u0631\"} ${G(b.cashier,\"\u0644\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0644\u0644\u0645\u0648\u0638\u0641\")} \u0639\u0628\u0631 ${esc(s.ch||\"\u0648\u0627\u062a\u0633\u0627\u0628\")} \u2014 \u0628\u0648\u0627\u0633\u0637\u0629 <b>${esc(s.by||\"\")}</b> <span class=\"num\">${esc(timeOf(s.at))}</span>${s.ack?`<br>\u2713 ${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0641\u062a\u062d\u062a \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648\u0623\u0643\u062f\u062a \u0627\u0637\u0644\u0627\u0639\u0647\u0627\",\"\u0627\u0644\u0645\u0648\u0638\u0641 \u0641\u062a\u062d \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0648\u0623\u0643\u062f \u0627\u0637\u0644\u0627\u0639\u0647\")} <span class=\"num\">${esc(s.ack)}</span>`:s.seen?`<br>\ud83d\udc41 ${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0641\u062a\u062d\u062a\",\"\u0627\u0644\u0645\u0648\u0638\u0641 \u0641\u062a\u062d\")} \u0627\u0644\u0625\u0634\u0639\u0627\u0631 <span class=\"num\">${esc(s.seen)}</span> ${G(b.cashier,\"\u0648\u0644\u0645 \u062a\u0624\u0643\u062f \u0628\u0639\u062f\",\"\u0648\u0644\u0645 \u064a\u0624\u0643\u062f \u0628\u0639\u062f\")}`:`<br><span class=\"note\">${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0644\u0645 \u062a\u0641\u062a\u062d\",\"\u0627\u0644\u0645\u0648\u0638\u0641 \u0644\u0645 \u064a\u0641\u062a\u062d\")} \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0628\u0639\u062f</span>`}</div>`;",
"  return d?`<p class=\"note\" style=\"margin:8px 0\">\u0644\u0645 \u064a\u064f\u0631\u0633\u0644 ${d<0?\"\u0627\u0644\u0639\u062c\u0632\":\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629\"} ${G(b.cashier,\"\u0644\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0644\u0644\u0645\u0648\u0638\u0641\")} \u0628\u0639\u062f.</p>`:\"\";",
"}",
"function sentStrip(){",
"  if(effectiveRole()!==\"acc\"||!cur.isSaved)return\"\";",
"  const L=cur.boxes.map((b,i)=>({i,d:hasData(b)?boxCalc(b).diff:0})).filter(x=>x.d);if(!L.length)return\"\";",
"  const n=L.filter(x=>sentOf(cur.date,x.i)).length;",
"  return`<div class=\"info\">\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a: \u0623\u064f\u0631\u0633\u0644 <b class=\"num\">${n}</b> \u0645\u0646 <b class=\"num\">${L.length}</b></div>`;",
"}",
"function noticeNewSent(list){",
"  const r=effectiveRole();if((r!==\"acc\"&&!canSendStaff())||!list)return;",
"  const key=e=>e.date+\"|\"+e.box+\"|\"+e.at,old=new Map(sentLog.map(e=>[key(e),e]));",
"  if(r===\"acc\"){const nw=list.filter(e=>!old.has(key(e)));",
"    if(nw.length===1)toast(`\u0623\u064f\u0631\u0633\u0644 \u062a\u0642\u0631\u064a\u0631 \u0635\u0646\u062f\u0648\u0642 ${BN(nw[0].box)}${nw[0].name?\" \u2014 \"+nw[0].name:\"\"} \u0628\u0648\u0627\u0633\u0637\u0629 ${nw[0].by}`);",
"    else if(nw.length>1)toast(`\u0623\u064f\u0631\u0633\u0644\u062a ${nw.length} \u062a\u0642\u0627\u0631\u064a\u0631 \u0639\u062c\u0632 \u0648\u0632\u064a\u0627\u062f\u0629 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a`)}",
"  list.forEach(e=>{const o=old.get(key(e));if(!o)return;",
"    if(e.ack&&!o.ack)toast(`\u2713 ${e.name||\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\"} ${G(e.name,\"\u0623\u0643\u062f\u062a\",\"\u0623\u0643\u062f\")} \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u0625\u0634\u0639\u0627\u0631 \u0635\u0646\u062f\u0648\u0642 ${BN(e.box)}`);",
"    else if(e.seen&&!o.seen)toast(`\ud83d\udc41 ${e.name||\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\"} ${G(e.name,\"\u0641\u062a\u062d\u062a\",\"\u0641\u062a\u062d\")} \u0625\u0634\u0639\u0627\u0631 \u0635\u0646\u062f\u0648\u0642 ${BN(e.box)}`)});",
"}",
"",
"/* ---------- accountant: shortage notice centre ---------- */",
"function noticeItems(n){",
"  const t=todayISO(),out=[];",
"  for(let k=0;k<(n||7);k++){const d=addDays(t,-k),raw=days.get(d);if(!raw||raw.namesOnly)continue;",
"    normDay(raw).boxes.forEach((b,i)=>{if(!hasData(b))return;const df=boxCalc(b).diff;if(!df)return;out.push({date:d,i,name:b.cashier||\"\",d:df,s:sentOf(d,i)})})}",
"  return out;",
"}",
"function renderBell(){",
"  const bt=$(\"#bell\");if(!bt)return;const on=effectiveRole()===\"acc\";bt.hidden=!on;if(!on)return;",
"  const n=noticeItems().filter(x=>!x.s).length,i=$(\"#bellN\");i.hidden=!n;i.textContent=n>99?\"99+\":n;",
"  bt.title=n?`${n} \u0644\u0645 \u064a\u064f\u0631\u0633\u0644 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a`:\"\u0643\u0644 \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0639\u062c\u0632 \u0623\u064f\u0631\u0633\u0644\u062a\";",
"}",
"function openBell(){",
"  const L=noticeItems(),un=L.filter(x=>!x.s).length;",
"  const byDay={};L.forEach(x=>(byDay[x.date]||(byDay[x.date]=[])).push(x));",
"  const body=L.length?`<div class=\"strip\" style=\"margin:8px 0\"><div class=\"stat ${un?\"short\":\"ok\"}\"><span>\u0644\u0645 \u064a\u064f\u0631\u0633\u0644</span><b class=\"num\">${un}</b></div><div class=\"stat ok\"><span>\u0623\u064f\u0631\u0633\u0644</span><b class=\"num\">${L.length-un}</b></div></div>",
"   <p class=\"note\">\u0627\u0644\u0625\u0631\u0633\u0627\u0644 \u0644\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0645\u0646 \u0639\u0646\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0635\u0631\u0651\u062d \u0644\u0647 \u0628\u0627\u0644\u0625\u0631\u0633\u0627\u0644\u060c \u0648\u0647\u0646\u0627 \u062a\u062a\u0627\u0628\u0639 \u062d\u0627\u0644\u062a\u0647 \u0641\u0642\u0637. \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0623\u064a \u0633\u0637\u0631 \u0644\u0641\u062a\u062d \u0627\u0644\u064a\u0648\u0645.</p>",
"   ${Object.keys(byDay).sort().reverse().map(d=>`<div class=\"sec-h\" style=\"margin-top:10px\"><b>${dayName(d)} <span class=\"num\">${dmy(d)}</span></b><span class=\"note num\">\u0623\u064f\u0631\u0633\u0644 ${byDay[d].filter(x=>x.s).length} \u0645\u0646 ${byDay[d].length}</span></div>",
"     ${byDay[d].sort((a,b)=>(!!a.s)-(!!b.s)||a.d-b.d).map(x=>`<button class=\"ntc\" data-go=\"${d}\"><span><b class=\"num\">${BN(x.i)}</b> \u2014 ${esc(x.name)||\"\u0628\u062f\u0648\u0646 \u0627\u0633\u0645\"}<br><span class=\"num ${x.d<0?\"neg\":\"pos\"}\">${x.d<0?\"\u0639\u062c\u0632\":\"\u0632\u064a\u0627\u062f\u0629\"} ${fmt(Math.abs(x.d))}</span></span>",
"       ${x.s?`<span class=\"pill saved\">\u0623\u064f\u0631\u0633\u0644 ${esc(x.s.ch||\"\")} ${esc(timeOf(x.s.at))}<br><small>${esc(x.s.by||\"\")}${x.s.ack?\" \u00b7 \u2713 \u0623\u0643\u062f\u062a\":x.s.seen?\" \u00b7 \ud83d\udc41 \u0641\u062a\u062d\u062a\":\"\"}</small></span>`:`<span class=\"pill err\">\u0644\u0645 \u064a\u064f\u0631\u0633\u0644</span>`}</button>`).join(\"\")}`).join(\"\")}`",
"   :`<div class=\"card empty\">\u0644\u0627 \u064a\u0648\u062c\u062f \u0639\u062c\u0632 \u0623\u0648 \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0622\u062e\u0631 7 \u0623\u064a\u0627\u0645.</div>`;",
"  const s=sheet(\"\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629\",body,`<button class=\"btn\" data-close>\u0625\u063a\u0644\u0627\u0642</button>`);",
"  s.el.querySelectorAll(\"[data-go]\").forEach(b=>b.onclick=()=>{s.close();tab=\"boxes\";goDate(b.dataset.go).then(()=>render())});",
"}",
"let bootNoticed=false;",
"function bootNotice(){",
"  if(bootNoticed||effectiveRole()!==\"acc\")return;bootNoticed=true;",
"  const t=todayISO(),n=noticeItems().filter(x=>!x.s&&x.date<t).length;let q=0;for(let k=0;k<7;k++){const L=rqList(addDays(t,-k));q+=L.boxes.length+L.rets.length}",
"  const msg=[q?`${q} \u0637\u0644\u0628 \u0627\u0639\u062a\u0645\u0627\u062f \u0645\u0646 \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a`:\"\",n?`${n} \u0639\u062c\u0632/\u0632\u064a\u0627\u062f\u0629 \u0645\u0646 \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0644\u0645 \u064a\u064f\u0631\u0633\u0644 \u0644\u0644\u0645\u0648\u0638\u0641\u0627\u062a`:\"\"].filter(Boolean).join(\"\u060c \u0648\");",
"  if(msg)setTimeout(()=>toast(\"\u062a\u0646\u0628\u064a\u0647: \"+msg),900);",
"}",
"",
"/* ---------- the shortage notice as an image (shared to WhatsApp or attached to the e-mail) ---------- */",
"function noticeCardHTML(day,i){",
"  const b=day.boxes[i],d=leadDiff(b),short=d<0,col=short?\"#c0392b\":\"#b9770e\",bg=short?\"#fdecea\":\"#fef5e7\";",
"  const row=(k,v)=>`<tr><td style=\"padding:9px 0;color:#5b6b7f;border-bottom:1px solid #edf1f6\">${k}</td><td style=\"padding:9px 0;text-align:left;font-weight:600;color:#1d2b3a;border-bottom:1px solid #edf1f6;direction:ltr\">${v}</td></tr>`;",
"  const wm=wmSrc()?`<div style=\"position:absolute;inset:120px 0 60px;background:url('${wmSrc()}') center/62% auto no-repeat;opacity:${wmOp(1)}\"></div>`:\"\";",
"  return`<div class=\"ncard\" style=\"width:420px;background:#fff;border-radius:18px;overflow:hidden;font-family:'IBM Plex Sans Arabic',Tahoma,Arial,sans-serif;direction:rtl;text-align:right;position:relative;box-shadow:0 0 0 1px #e6ebf2\">",
"   <div style=\"background:#1d3a5f;padding:20px 18px 16px;text-align:center\">${LOGO?`<img src=\"${LOGO}\" style=\"max-height:60px;max-width:70%;background:#fff;border-radius:10px;padding:6px 10px;margin-bottom:8px\">`:\"\"}",
"    <div style=\"color:#fff;font-size:18px;font-weight:700\">${esc(settings.store)}</div><div style=\"color:#c9d6e6;font-size:13px\">${esc(settings.branch)}</div></div>",
"   <div style=\"padding:20px 22px 6px;position:relative\">${wm}<div style=\"position:relative\"><div style=\"font-size:13px;color:#5b6b7f\">${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0627\u0644\u0643\u0631\u064a\u0645\u0629\",\"\u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0643\u0631\u064a\u0645\")}</div><div style=\"font-size:19px;font-weight:700;color:#1d2b3a;margin:2px 0 12px\">${esc(b.cashier||\"\")}</div>",
"    <div style=\"background:${bg};border:1px solid ${col}55;border-radius:14px;padding:14px;text-align:center\"><div style=\"color:${col};font-size:14px;font-weight:700\">${short?\"\u0625\u0634\u0639\u0627\u0631 \u0639\u062c\u0632 \u0641\u064a \u0627\u0644\u0635\u0646\u062f\u0648\u0642\":\"\u0625\u0634\u0639\u0627\u0631 \u0632\u064a\u0627\u062f\u0629 \u0641\u064a \u0627\u0644\u0635\u0646\u062f\u0648\u0642\"}</div>",
"     <div style=\"color:${col};font-size:30px;font-weight:800;margin-top:4px;direction:ltr\">${fmt(Math.abs(d))} <span style=\"font-size:14px\">\u0631\u064a\u0627\u0644</span></div></div>",
"    <table style=\"width:100%;border-collapse:collapse;margin-top:12px;font-size:14px\">${row(\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",dayName(day.date)+\" \"+dmy(day.date))}${row(\"\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",BN(i))}${row(\"\u0627\u0644\u0643\u0627\u0634\",fmt(b.cash))}</table>",
"    <p style=\"font-size:13px;line-height:1.9;color:#33475b;margin:14px 0 4px\">\u0646\u0631\u062c\u0648 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 \u062a\u0641\u0627\u0635\u064a\u0644 \u0635\u0646\u062f\u0648\u0642\u0643 \u0623\u0639\u0644\u0627\u0647\u060c \u0648\u0645\u0631\u0627\u062c\u0639\u0629 ${senderTitle()} \u0641\u064a \u062d\u0627\u0644 \u0648\u062c\u0648\u062f \u0623\u064a \u0645\u0644\u0627\u062d\u0638\u0629.</p></div></div>",
"   <div style=\"padding:10px 22px 16px;border-top:1px solid #edf1f6;margin-top:8px;font-size:11px;color:#8a97a8;text-align:center\">\u062a\u0645 \u0625\u0631\u0633\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0628\u0648\u0627\u0633\u0637\u0629 ${senderTitle()}: ${esc(me&&me.name||\"\")}<br>${dmy(todayISO())}</div></div>`;",
"}",
"async function noticePNG(day,i){",
"  await loadLib(\"h2c\");try{await document.fonts.ready}catch(e){}",
"  const st=$(\"#stage\");st.className=\"\";st.innerHTML=noticeCardHTML(day,i);",
"  const c=await html2canvas(st.firstElementChild,{scale:2,backgroundColor:\"#ffffff\",logging:false});st.innerHTML=\"\";",
"  return await new Promise(r=>c.toBlob(r,\"image/png\"));",
"}",
"const blobURL=b=>new Promise(r=>{const f=new FileReader();f.onload=()=>r(f.result);f.readAsDataURL(b)});",
"/* the image goes straight to the employee's own WhatsApp chat: it is copied, her chat opens with the message,",
"   and the supervisor pastes it. Without a phone number the phone's share sheet is used instead. */",
"async function copyImage(blob){try{if(navigator.clipboard&&window.ClipboardItem){await navigator.clipboard.write([new ClipboardItem({\"image/png\":blob})]);return true}}catch(e){}return false}",
"async function sendAsImage(date,i,bt){",
"  const day=leadDay(date);if(!day)return;const t=bt.innerHTML;bt.disabled=true;bt.textContent=\"\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062c\u0647\u064a\u0632\u2026\";",
"  try{const tk=newTk(),b=day.boxes[i],ph=intlPhone(phoneOf(b.cashier)),msg=shortMsg(day,i,tk),blob=await noticePNG(day,i),name=`\u0627\u0634\u0639\u0627\u0631-${BN(i)}-${date}.png`;",
"    if(!ph){const r=await shareImage(blob,name,\"\u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",msg);if(r!==\"cancel\")await markSent(date,i,tk)}",
"    else{",
"      const copied=await copyImage(blob);if(!copied)await saveFile(name,blob);",
"      const url=`https://wa.me/${ph}?text=${encodeURIComponent(msg)}`;let w=null;try{w=window.open(url,\"_blank\")}catch(e){}",
"      await markSent(date,i,tk);",
"      const s=sheet(\"\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0644\u0640 \"+esc(b.cashier||\"\"),`<div class=\"imgsteps\">",
"        <div class=\"st1\"><b>1</b><span>${copied?\"\u062a\u0645 \u0646\u0633\u062e \u0635\u0648\u0631\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u2713\":\"\u062a\u0645 \u062d\u0641\u0638 \u0635\u0648\u0631\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0641\u064a \u062c\u0647\u0627\u0632\u0643 \u2713\"}</span></div>",
"        <div class=\"st1\"><b>2</b><span>${w?`\u0627\u0646\u0641\u062a\u062d\u062a \u0645\u062d\u0627\u062f\u062b\u0629 ${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0627\u0644\u0645\u0648\u0638\u0641\")} \u0641\u064a \u0648\u0627\u062a\u0633\u0627\u0628`:`${meF(\"\u0627\u0641\u062a\u062d\u064a\",\"\u0627\u0641\u062a\u062d\")} \u0645\u062d\u0627\u062f\u062b\u0629 ${G(b.cashier,\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0627\u0644\u0645\u0648\u0638\u0641\")} \u0645\u0646 \u0627\u0644\u0632\u0631 \u062a\u062d\u062a`}\u060c \u0648\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 \u0645\u0643\u062a\u0648\u0628\u0629 \u0641\u064a\u0647\u0627</span></div>",
"        <div class=\"st1\"><b>3</b><span>${copied?meF(\"\u0627\u0636\u063a\u0637\u064a \u0645\u0637\u0648\u0644\u0627\u064b \u0641\u064a \u062e\u0627\u0646\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0648\u0627\u062e\u062a\u0627\u0631\u064a \u00ab\u0644\u0635\u0642\u00bb \u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0635\u0648\u0631\u0629\u060c \u062b\u0645 \u0623\u0631\u0633\u0644\u064a\",\"\u0627\u0636\u063a\u0637 \u0645\u0637\u0648\u0644\u0627\u064b \u0641\u064a \u062e\u0627\u0646\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0648\u0627\u062e\u062a\u0631 \u00ab\u0644\u0635\u0642\u00bb \u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u0635\u0648\u0631\u0629\u060c \u062b\u0645 \u0623\u0631\u0633\u0644\"):meF(\"\u0627\u0636\u063a\u0637\u064a \ud83d\udcce \u0648\u0627\u062e\u062a\u0627\u0631\u064a \u0627\u0644\u0635\u0648\u0631\u0629 \u0645\u0646 \u0627\u0644\u0645\u0639\u0631\u0636\u060c \u062b\u0645 \u0623\u0631\u0633\u0644\u064a\",\"\u0627\u0636\u063a\u0637 \ud83d\udcce \u0648\u0627\u062e\u062a\u0631 \u0627\u0644\u0635\u0648\u0631\u0629 \u0645\u0646 \u0627\u0644\u0645\u0639\u0631\u0636\u060c \u062b\u0645 \u0623\u0631\u0633\u0644\")}</span></div></div>`,",
"        `<a class=\"btn primary\" href=\"${url}\" target=\"_blank\" rel=\"noopener\">\u0641\u062a\u062d \u0648\u0627\u062a\u0633\u0627\u0628 ${esc(b.cashier||\"\")}</a><button class=\"btn\" data-close>\u062a\u0645</button>`);",
"    }}",
"  catch(e){toast(\"\u062a\u0639\u0630\u0651\u0631 \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0635\u0648\u0631\u0629\")}",
"  bt.disabled=false;bt.innerHTML=t;",
"}",
"/* ---------- attendance from closings ---------- */",
"const WEEK=[\"\u0627\u0644\u0633\u0628\u062a\",\"\u0627\u0644\u0623\u062d\u062f\",\"\u0627\u0644\u0625\u062b\u0646\u064a\u0646\",\"\u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621\",\"\u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621\",\"\u0627\u0644\u062e\u0645\u064a\u0633\",\"\u0627\u0644\u062c\u0645\u0639\u0629\"];",
"const ATT={p:[\"\u062d\u0627\u0636\u0631\",\"ok\"],po:[\"\u062d\u0627\u0636\u0631 \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\",\"over\"],a:[\"\u063a\u064a\u0627\u0628\",\"short\"],o:[\"\u0623\u0648\u0641\",\"off\"]};",
"let att=Object.assign(mkP(),{});",
"function staffOf(n){return(settings.staff||{})[n]||null}",
"function schedAt(n,date){const st=staffOf(n);if(!st||!st.sched)return null;const m=date.slice(0,7);let best=null;Object.keys(st.sched).sort().forEach(k=>{if(k<=m)best=st.sched[k]});return best}",
"function namesIn(b){return String(b.cashier||\"\").split(\" / \").map(s=>s.trim()).filter(Boolean)}",
"function attBuild(from,to){",
"  const t=todayISO(),pres={},boxesOf={},dates=[];",
"  for(let d=from;d<=to;d=addDays(d,1)){dates.push(d);const raw=days.get(d);if(!raw||raw.namesOnly)continue;",
"    normDay(raw).boxes.forEach((b,i)=>{if(!hasData(b))return;namesIn(b).forEach(n=>{(pres[d]||(pres[d]={}))[n]=1;((boxesOf[d]||(boxesOf[d]={}))[n]||(boxesOf[d][n]=[])).push(BN(i))})})}",
"  const names=new Set(Object.keys(settings.staff||{}));Object.values(pres).forEach(o=>Object.keys(o).forEach(n=>names.add(n)));",
"  const rows=[];",
"  names.forEach(n=>{const st=staffOf(n)||{};const cells=[];const c={p:0,po:0,a:0,o:0};",
"    dates.forEach(d=>{const here=!!(pres[d]&&pres[d][n]);let s=\"\";",
"      const out=(st.start&&d<st.start)||(st.end&&d>st.end);const sc=schedAt(n,d);const off=!!(sc&&sc.off&&sc.off===dayName(d));",
"      if(here)s=off?\"po\":\"p\";",
"      else if(out||d>=t||!pres[d]||(sc&&sc.type===\"\u0628\u062f\u064a\u0644\"))s=\"\";",
"      else s=off?\"o\":\"a\";",
"      if(s)c[s]++;cells.push({d,s,box:here?(boxesOf[d][n]||[]).join(\"\u060c \"):\"\"})});",
"    if(c.p+c.po+c.a+c.o===0)return;",
"    const sc=schedAt(n,to);rows.push({name:n,c,cells,off:sc&&sc.off||\"\",type:sc&&sc.type||\"\"})});",
"  rows.sort((a,b)=>b.c.a-a.c.a||a.name.localeCompare(b.name,\"ar\"));",
"  return{rows,dates};",
"}",
"function renderAtt(){",
"  const [from,to,label]=periodRange(att);const A0=attBuild(from,to),V=attView(),A=attFilter(A0,V);",
"  const T=A.rows.reduce((s,r)=>{[\"p\",\"po\",\"a\",\"o\"].forEach(k=>s[k]+=r.c[k]);return s},{p:0,po:0,a:0,o:0});",
"  $(\"#view\").innerHTML=`${periodCtrl(att)}",
"  <div class=\"info\">\u0627\u0644\u062d\u0636\u0648\u0631 \u0645\u0646 \u062d\u0631\u0643\u0629 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631: \u064a\u0648\u0645 \u0641\u064a\u0647 \u062a\u0642\u0631\u064a\u0631 \u0644\u0644\u0645\u0648\u0638\u0641\u0629 = \u062d\u0627\u0636\u0631\u060c \u0648\u064a\u0648\u0645 \u0628\u062f\u0648\u0646 \u062a\u0642\u0631\u064a\u0631 = \u063a\u064a\u0627\u0628\u060c \u0625\u0644\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641 \u0627\u0644\u062e\u0627\u0635 \u0628\u0647\u0627. \u0623\u064a\u0627\u0645 \u0627\u0644\u062f\u0648\u0627\u0645 \u0627\u0644\u0628\u062f\u064a\u0644 \u0648\u0623\u064a\u0627\u0645 \u0642\u0628\u0644 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 \u0623\u0648 \u0628\u0639\u062f \u0622\u062e\u0631 \u064a\u0648\u0645 \u0639\u0645\u0644 \u0644\u0627 \u062a\u064f\u062d\u0633\u0628.</div>",
"  ${A.rows.length?`<div class=\"strip\">",
"   <div class=\"stat ok\"><span>\u0623\u064a\u0627\u0645 \u062d\u0636\u0648\u0631</span><b class=\"num\">${T.p+T.po}</b></div>",
"   <div class=\"stat short\"><span>\u0623\u064a\u0627\u0645 \u063a\u064a\u0627\u0628</span><b class=\"num\">${T.a}</b></div>",
"   <div class=\"stat\"><span>\u0623\u064a\u0627\u0645 \u0623\u0648\u0641</span><b class=\"num\">${T.o}</b></div>",
"   <div class=\"stat over\"><span>\u0639\u0645\u0644 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641</span><b class=\"num\">${T.po}</b></div></div>",
"  ${attBar(A0,A,V)}<div class=\"row-btns\"><button class=\"btn primary\" id=\"attPdf\">\u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u062a\u0642\u0631\u064a\u0631</button><button class=\"btn\" id=\"attCsv\">\u062a\u0635\u062f\u064a\u0631 Excel</button></div>",
"  <div class=\"tbl-wrap\"><table><thead><tr><th>\u0627\u0644\u0645\u0648\u0638\u0641\u0629</th><th>\u0627\u0644\u0623\u0648\u0641</th><th class=\"n\">\u062d\u0636\u0648\u0631</th><th class=\"n\">\u063a\u064a\u0627\u0628</th><th class=\"n\">\u0623\u0648\u0641</th><th class=\"n\">\u0639\u0645\u0644 \u0628\u0627\u0644\u0623\u0648\u0641</th></tr></thead><tbody>",
"   ${A.rows.map((r,k)=>`<tr class=\"click\" data-att=\"${k}\"><td>${esc(r.name)}${r.type===\"\u0628\u062f\u064a\u0644\"?' <span class=\"note\">(\u0628\u062f\u064a\u0644)</span>':\"\"}</td><td>${esc(r.off)||\"\u2014\"}</td><td class=\"n num\">${r.c.p+r.c.po}</td><td class=\"n num ${r.c.a?\"neg\":\"\"}\">${r.c.a}</td><td class=\"n num\">${r.c.o}</td><td class=\"n num ${r.c.po?\"pos\":\"\"}\">${r.c.po}</td></tr>`).join(\"\")}</tbody></table></div>",
"  <p class=\"note\">\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641\u0629 \u0644\u0639\u0631\u0636 \u0623\u064a\u0627\u0645\u0647\u0627 \u064a\u0648\u0645\u0627\u064b \u0628\u064a\u0648\u0645.</p>`",
"  :A0.rows.length?`${attBar(A0,A,V)}<div class=\"card empty\">\u0643\u0644 \u0627\u0644\u0645\u0648\u0638\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0627\u062a \u0628\u0633\u0628\u0628 \u0627\u0644\u062a\u062e\u0635\u064a\u0635.</div>`:`<div class=\"card empty\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u062d\u0636\u0648\u0631 \u0641\u064a ${label}.</div>`}`;",
"  bindPeriod(att,renderAtt);const vb=$(\"#attView\");if(vb)vb.onclick=()=>attViewEdit(A0);const va=$(\"#attAll\");if(va)va.onclick=()=>attViewSave({hide:[],boxes:[]});",
"  $(\"#view\").querySelectorAll(\"[data-att]\").forEach(tr=>tr.onclick=()=>attDetail(A.rows[+tr.dataset.att],label));",
"  const p=$(\"#attPdf\");if(p)p.onclick=()=>preview(\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062d\u0636\u0648\u0631\",rcptAtt(A,label),`\u0627\u0644\u062d\u0636\u0648\u0631-${label.replace(/[\\s/]+/g,\"-\")}.pdf`);",
"  const c=$(\"#attCsv\");if(c)c.onclick=()=>xlsxAtt(A,label);",
"}",
"function attDetail(r,label){",
"  const list=r.cells.filter(x=>x.s).map(x=>`<div class=\"calc\" style=\"font-weight:400\"><span>${dayName(x.d)} <span class=\"num\">${dmy(x.d)}</span></span><span class=\"pill ${({p:\"saved\",po:\"dirty\",a:\"err\",o:\"new\"})[x.s]}\">${ATT[x.s][0]}${x.box?` \u2014 <span class=\"num\">${x.box}</span>`:\"\"}</span></div>`).join(\"\");",
"  const s=sheet(esc(r.name),`<p class=\"note\" style=\"margin:8px 0\">${label}${r.off?` \u2014 \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641: <b>${esc(r.off)}</b>`:\"\"}</p>",
"   <div class=\"strip\" style=\"margin-bottom:8px\"><div class=\"stat ok\"><span>\u062d\u0636\u0648\u0631</span><b class=\"num\">${r.c.p+r.c.po}</b></div><div class=\"stat short\"><span>\u063a\u064a\u0627\u0628</span><b class=\"num\">${r.c.a}</b></div></div>${list}`,",
"   `<button class=\"btn primary\" id=\"attOne\">\u0637\u0628\u0627\u0639\u0629</button><button class=\"btn\" data-close>\u0625\u063a\u0644\u0627\u0642</button>`);",
"  $(\"#attOne\").onclick=()=>preview(\"\u062d\u0636\u0648\u0631 \"+r.name,rcptAttOne(r,label),`\u062d\u0636\u0648\u0631-${r.name}-${label.replace(/[\\s/]+/g,\"-\")}.pdf`);",
"}",
"function rcptAtt(A,label){",
"  return`<div class=\"rcpt\">${head(\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u062d\u0636\u0648\u0631 \u0648\u0627\u0644\u063a\u064a\u0627\u0628\",`<div class=\"c\" style=\"font-weight:700\">${label}</div>`)}",
"  <table><thead><tr><th>\u0627\u0644\u0645\u0648\u0638\u0641\u0629</th><th class=\"n\">\u062d\u0636\u0648\u0631</th><th class=\"n\">\u063a\u064a\u0627\u0628</th><th class=\"n\">\u0623\u0648\u0641</th></tr></thead><tbody>",
"  ${A.rows.map(r=>`<tr><td class=\"who\" style=\"max-width:130px\">${esc(r.name)}</td><td class=\"n\">${r.c.p+r.c.po}</td><td class=\"n\">${r.c.a}</td><td class=\"n\">${r.c.o}</td></tr>`).join(\"\")}</tbody></table>",
"  ${sigs()}<div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"function rcptAttOne(r,label){",
"  return`<div class=\"rcpt\">${head(\"\u0643\u0634\u0641 \u062d\u0636\u0648\u0631 \u0645\u0648\u0638\u0641\u0629\",`<div class=\"c\" style=\"font-weight:700\">${esc(r.name)} \u2014 ${label}</div>`)}",
"  ${R(\"\u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\",esc(r.off)||\"\u2014\")}${R(\"\u0623\u064a\u0627\u0645 \u0627\u0644\u062d\u0636\u0648\u0631\",r.c.p+r.c.po)}${R(\"\u0623\u064a\u0627\u0645 \u0627\u0644\u063a\u064a\u0627\u0628\",r.c.a)}${R(\"\u0623\u064a\u0627\u0645 \u0627\u0644\u0623\u0648\u0641\",r.c.o)}${R(\"\u0639\u0645\u0644 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\",r.c.po)}",
"  <table><thead><tr><th>\u0627\u0644\u064a\u0648\u0645</th><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u062d\u0627\u0644\u0629</th></tr></thead><tbody>",
"  ${r.cells.filter(x=>x.s).map(x=>`<tr><td>${dayName(x.d)}</td><td>${dmy(x.d)}</td><td>${ATT[x.s][0]}</td></tr>`).join(\"\")}</tbody></table>",
"  <div class=\"sig\"><div>\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0645\u0648\u0638\u0641\u0629</div><div>${esc(settings.signB)}</div></div><div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"function attCSV(A,label){",
