"function secFx(){const F=fxCfg(),C=F.cur||{};return`<div class=\"card\"><h3 class=\"set-h\">\u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0623\u062c\u0646\u0628\u064a\u0629</h3>",
"   <label class=\"chk\"><input type=\"checkbox\" id=\"s-fxOn\" ${F.on?\"checked\":\"\"}>\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0639\u0645\u0644\u0627\u062a \u0623\u062c\u0646\u0628\u064a\u0629 \u0641\u064a \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</label>",
"   <div id=\"fxBody\" ${F.on?\"\":\"hidden\"}><div class=\"fx-list\">${FXL.map(([c,n,d])=>{const o=C[c]||{};return`<div class=\"fx-row\"><label class=\"chk\"><input type=\"checkbox\" id=\"fx-on-${c}\" ${o.on?\"checked\":\"\"}><span>${n} <span class=\"note\" dir=\"ltr\">${c}</span></span></label>",
"     <label class=\"fx-rate\"><span class=\"note\">\u0633\u0639\u0631 \u0627\u0644\u0635\u0631\u0641</span><input class=\"inp money\" id=\"fx-r-${c}\" inputmode=\"decimal\" dir=\"ltr\" value=\"${esc(o.rate||d)}\"></label></div>`}).join(\"\")}</div>",
"    <p class=\"note\">\u0633\u0639\u0631 \u0627\u0644\u0635\u0631\u0641 = \u0643\u0645 \u0631\u064a\u0627\u0644 \u062a\u0633\u0627\u0648\u064a \u0648\u062d\u062f\u0629 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u0627\u0644\u0639\u0645\u0644\u0629. \u064a\u064f\u062d\u0641\u0638 \u0627\u0644\u0633\u0639\u0631 \u0645\u0639 \u0643\u0644 \u0635\u0646\u062f\u0648\u0642 \u0648\u0642\u062a \u0625\u062f\u062e\u0627\u0644\u0647\u060c \u0641\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0633\u0639\u0631 \u0644\u0627\u062d\u0642\u0627\u064b \u0645\u0627 \u064a\u063a\u064a\u0651\u0631 \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u0629.</p></div></div>",
"  <div class=\"card\" id=\"fxModeCard\" ${F.on?\"\":\"hidden\"}><h3 class=\"set-h\">\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0627\u062d\u062a\u0633\u0627\u0628</h3>",
"   <label class=\"radio-row\"><input type=\"radio\" name=\"fxm\" id=\"s-fxConv\" ${F.mode!==\"track\"?\"checked\":\"\"}><span><b>\u062a\u064f\u0635\u0631\u0641 \u0644\u0644\u0643\u0627\u0634 \u0645\u0628\u0627\u0634\u0631\u0629</b><span class=\"note\">\u062a\u062a\u062d\u0648\u0644 \u0628\u0633\u0639\u0631 \u0627\u0644\u0635\u0631\u0641 \u0648\u062a\u0646\u0636\u0627\u0641 \u0644\u0643\u0627\u0634 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\u060c \u0648\u062a\u0638\u0647\u0631 \u0645\u0639 \u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0643\u0627\u0634.</span></span></label>",
"   <label class=\"radio-row\"><input type=\"radio\" name=\"fxm\" id=\"s-fxTrack\" ${F.mode===\"track\"?\"checked\":\"\"}><span><b>\u0645\u062a\u0627\u0628\u0639\u0629 \u0645\u0646\u0641\u0635\u0644\u0629</b><span class=\"note\">\u062a\u0646\u062d\u0633\u0628 \u0636\u0645\u0646 \u0645\u0637\u0627\u0628\u0642\u0629 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\u060c \u0648\u062a\u0638\u0647\u0631 \u0644\u062d\u0627\u0644\u0647\u0627 \u0641\u064a \u0645\u0644\u062e\u0635 \u0627\u0644\u064a\u0648\u0645 \u0648\u0641\u064a \u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u0635\u0646\u062f\u0648\u0642.</span></span></label></div>`}",
"function bindFx(){$(\"#s-fxOn\").onchange=e=>{$(\"#fxBody\").hidden=!e.target.checked;$(\"#fxModeCard\").hidden=!e.target.checked}}",
"/* ---------- import from Excel ---------- */",
"function loadXLSX(){return window.XLSX?Promise.resolve():new Promise((res,rej)=>{const s=document.createElement(\"script\");",
"  s.src=\"https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js\";s.onload=res;s.onerror=()=>rej(new Error(\"\u062a\u0639\u0630\u0651\u0631 \u062a\u062d\u0645\u064a\u0644 \u0642\u0627\u0631\u0626 \u0645\u0644\u0641\u0627\u062a Excel\u060c \u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a\"));document.head.appendChild(s)})}",
"const IMP_ORDER=[\"date\",\"cashier\",\"shift\",\"gulf\",\"master\",\"mada\",\"visa\",\"amex\",\"report\",\"notes\",\"amount\",\"cash\",\"box\"];",
"const IMP_RX={date:/\u062a\u0627\u0631\u064a\u062e|date/i,cashier:/\u0643\u0627\u0634\u064a\u0631|\u0623\u0645\u064a\u0646|\u0627\u0645\u064a\u0646|cashier/i,shift:/\u0648\u0631\u062f\u064a|shift/i,gulf:/\u062e\u0644\u064a\u062c/i,master:/\u0645\u0627\u0633\u062a\u0631|master/i,mada:/\u0645\u062f\u0649|mada/i,visa:/\u0641\u064a\u0632\u0627|visa/i,",
"  amex:/\u0623\u0645\u0631\u064a\u0643\u0627\u0646|\u0627\u0645\u0631\u064a\u0643\u0627\u0646|amex|american/i,report:/\u062a\u0642\u0631\u064a\u0631|\u0627\u0644\u0646\u0638\u0627\u0645|report/i,notes:/\u0645\u0644\u0627\u062d\u0638|note/i,amount:/\u0642\u064a\u0645\u0629|\u0645\u0628\u0644\u063a|amount/i,cash:/\u0643\u0627\u0634|\u0646\u0642\u062f|cash/i,box:/\u0635\u0646\u062f\u0648\u0642|box/i};",
"const TPL_HEAD=[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0627\u0644\u0648\u0631\u062f\u064a\u0629\",\"\u0627\u0644\u0643\u0627\u0634\",\"\u0634\u0628\u0643\u0629 \u062e\u0644\u064a\u062c\u064a\u0629\",\"\u0645\u0627\u0633\u062a\u0631\u0643\u0627\u0631\u062f\",\"\u0634\u0628\u0643\u0629 \u0633\u0639\u0648\u062f\u064a\u0629 (\u0645\u062f\u0649)\",\"\u0641\u064a\u0632\u0627\",\"\u0623\u0645\u0631\u064a\u0643\u0627\u0646 \u0625\u0643\u0633\u0628\u0631\u0633\",\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u0642\u0631\u064a\u0631 (\u0627\u0644\u0646\u0638\u0627\u0645)\",\"\u0645\u0644\u0627\u062d\u0638\u0627\u062a\"];",
"function mapHeader(row){const map={};(row||[]).forEach((h,ci)=>{h=String(h==null?\"\":h).trim();if(!h)return;",
"  for(const k of IMP_ORDER){if(map[k]!=null)continue;if(IMP_RX[k].test(h)){map[k]=ci;break}}});return map}",
"function impDate(v){",
"  if(v instanceof Date&&!isNaN(v))return v.getFullYear()+\"-\"+String(v.getMonth()+1).padStart(2,\"0\")+\"-\"+String(v.getDate()).padStart(2,\"0\");",
"  if(typeof v===\"number\"&&v>20000&&v<80000){const d=XLSX.SSF.parse_date_code(v);return d.y+\"-\"+String(d.m).padStart(2,\"0\")+\"-\"+String(d.d).padStart(2,\"0\")}",
"  let s=String(v==null?\"\":v).replace(/[\u0660-\u0669]/g,d=>\"\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669\".indexOf(d)).trim();let m;",
"  if((m=s.match(/^(\\d{4})[-/.](\\d{1,2})[-/.](\\d{1,2})/)))return m[1]+\"-\"+m[2].padStart(2,\"0\")+\"-\"+m[3].padStart(2,\"0\");",
"  if((m=s.match(/^(\\d{1,2})[-/.](\\d{1,2})[-/.](\\d{4})/)))return m[3]+\"-\"+m[2].padStart(2,\"0\")+\"-\"+m[1].padStart(2,\"0\");",
"  return null;",
"}",
"function impBox(v){const x=parseInt(num(v),10);if(!x)return null;const st=parseInt(settings.boxStart,10)||1;",
"  for(let i=0;i<BOXES;i++)if(BN(i)===x)return i;if(x>=st&&x<st+BOXES)return x-st;if(x>=1&&x<=BOXES)return x-1;return null}",
"function parseWorkbook(wb){",
"  const D={},warn=[];let rowsOk=0,merged=0;",
"  const day=date=>D[date]||(D[date]={date,boxes:Array.from({length:BOXES},()=>null),returns:[]});",
"  wb.SheetNames.forEach(name=>{",
"    const rows=XLSX.utils.sheet_to_json(wb.Sheets[name],{header:1,raw:true,defval:\"\"});",
"    let hr=-1,map=null;for(let r=0;r<Math.min(rows.length,20);r++){const m=mapHeader(rows[r]);if(m.date!=null&&m.box!=null){hr=r;map=m;break}}",
"    if(hr<0)return;",
"    const isRet=map.amount!=null&&map.report==null&&map.cash==null;",
"    for(let r=hr+1;r<rows.length;r++){const R=rows[r];const g=k=>map[k]!=null?R[map[k]]:\"\";",
"      if(R.every(v=>v===\"\"||v==null))continue;",
"      const date=impDate(g(\"date\"));if(!date){warn.push(`${name} \u0633\u0637\u0631 ${r+1}: \u062a\u0627\u0631\u064a\u062e \u063a\u064a\u0631 \u0645\u0641\u0647\u0648\u0645`);continue}",
"      if(isRet){const a=num(g(\"amount\"));if(!a)continue;const bi=impBox(g(\"box\"));day(date).returns.push({amount:-Math.abs(a),box:bi==null?0:bi+1,note:String(g(\"notes\")||\"\")});rowsOk++;continue}",
"      const bi=impBox(g(\"box\"));if(bi==null){warn.push(`${name} \u0633\u0637\u0631 ${r+1}: \u0631\u0642\u0645 \u0635\u0646\u062f\u0648\u0642 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641 (${g(\"box\")})`);continue}",
"      const vals={cash:num(g(\"cash\")),gulf:num(g(\"gulf\")),master:num(g(\"master\")),mada:num(g(\"mada\")),visa:num(g(\"visa\")),amex:num(g(\"amex\")),report:num(g(\"report\"))};",
"      const name2=String(g(\"cashier\")||\"\").trim();",
"      if(!Object.values(vals).some(Boolean))continue;",
"      const d=day(date);let o=d.boxes[bi];",
"      if(o){merged++;Object.keys(vals).forEach(k=>o[k]=r2(o[k]+vals[k]));if(name2&&o.cashier.split(\" / \").indexOf(name2)<0)o.cashier=o.cashier?o.cashier+\" / \"+name2:name2}",
"      else d.boxes[bi]=Object.assign({cashier:name2,shift:String(g(\"shift\")||\"\"),notes:String(g(\"notes\")||\"\")},vals);",
"      rowsOk++;",
"    }",
"  });",
"  const list=Object.values(D).sort((a,b)=>a.date<b.date?-1:1);",
"  return{list,warn,rowsOk,merged};",
"}",
"async function importExcel(f){",
"  try{await loadXLSX()}catch(e){toast(e.message);return}",
"  let wb;try{wb=XLSX.read(await f.arrayBuffer(),{type:\"array\"})}catch(e){toast(\"\u062a\u0639\u0630\u0651\u0631 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u0644\u0641. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0645\u062d\u0645\u064a\u0627\u064b \u0628\u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u0627\u062d\u0641\u0638\u0647 \u0628\u062f\u0648\u0646 \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u062b\u0645 \u0623\u0639\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629\");return}",
"  const P=parseWorkbook(wb);",
"  if(!P.list.length){sheet(\"\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 Excel\",`<div class=\"banner short\" style=\"margin:10px 0\">\u0644\u0645 \u0623\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0628\u0627\u0644\u0634\u0643\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628 \u0641\u064a \u0627\u0644\u0645\u0644\u0641.</div><p class=\"note\">\u062a\u0623\u0643\u062f \u0623\u0646 \u0641\u064a \u0627\u0644\u0645\u0644\u0641 \u0639\u0645\u0648\u062f\u0627\u064b \u0644\u0644\u062a\u0627\u0631\u064a\u062e \u0648\u0639\u0645\u0648\u062f\u0627\u064b \u0644\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0641\u064a \u0635\u0641 \u0627\u0644\u0639\u0646\u0627\u0648\u064a\u0646\u060c \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0645 \u00ab\u062a\u0646\u0632\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c\u00bb.</p>${P.warn.slice(0,6).map(w=>`<p class=\"note\">${esc(w)}</p>`).join(\"\")}`);return}",
"  const exist=P.list.filter(d=>days.has(d.date)&&!days.get(d.date).namesOnly).length;",
"  const tot=P.list.reduce((s,d)=>s+d.boxes.reduce((a,b)=>a+(b?b.report:0),0)+d.returns.reduce((a,r)=>a+r.amount,0),0);",
"  const body=`<div class=\"strip\" style=\"margin:10px 0\">",
"     <div class=\"stat\"><span>\u0623\u064a\u0627\u0645</span><b class=\"num\">${P.list.length}</b></div>",
"     <div class=\"stat\"><span>\u0625\u0642\u0641\u0627\u0644\u0627\u062a \u0635\u0646\u0627\u062f\u064a\u0642</span><b class=\"num\">${P.rowsOk}</b></div>",
"     <div class=\"stat wide\"><span>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631</span><b class=\"num\">${fmt(tot)}</b></div></div>",
"   <p class=\"note\" style=\"margin:0 0 8px\">\u0627\u0644\u0641\u062a\u0631\u0629: <b class=\"num\">${dmy(P.list[0].date)}</b> \u0625\u0644\u0649 <b class=\"num\">${dmy(P.list[P.list.length-1].date)}</b>${P.merged?`. \u062f\u064f\u0645\u062c <b class=\"num\">${P.merged}</b> \u0633\u0637\u0631 \u0644\u0635\u0646\u062f\u0648\u0642 \u062a\u0643\u0631\u0631 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u064a\u0648\u0645 (\u062c\u064f\u0645\u0639\u062a \u0645\u0628\u0627\u0644\u063a\u0647)`:\"\"}.</p>",
"   ${exist?`<div class=\"card\" style=\"padding:10px 12px\"><b>${exist} \u064a\u0648\u0645 \u0645\u0648\u062c\u0648\u062f \u0645\u0633\u0628\u0642\u0627\u064b \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645</b>",
"     <label class=\"chk\"><input type=\"radio\" name=\"impMode\" value=\"skip\" checked>\u0625\u0628\u0642\u0627\u0621 \u0627\u0644\u0645\u0648\u062c\u0648\u062f \u0648\u062a\u062e\u0637\u064a \u0647\u0630\u0647 \u0627\u0644\u0623\u064a\u0627\u0645</label>",
"     <label class=\"chk\"><input type=\"radio\" name=\"impMode\" value=\"replace\">\u0627\u0633\u062a\u0628\u062f\u0627\u0644\u0647\u0627 \u0628\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0644\u0641</label></div>`:\"\"}",
"   <label class=\"chk\"><input type=\"checkbox\" id=\"impSheets\">\u0625\u0646\u0634\u0627\u0621 \u0648\u0631\u0642\u0629 \u0645\u0633\u062a\u0642\u0644\u0629 \u0644\u0643\u0644 \u064a\u0648\u0645 \u0641\u064a \u062c\u062f\u0648\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a (\u0623\u0628\u0637\u0623)</label>",
"   ${P.warn.length?`<details><summary class=\"note\">${P.warn.length} \u0633\u0637\u0631 \u0644\u0645 \u064a\u064f\u0642\u0631\u0623</summary>${P.warn.slice(0,30).map(w=>`<p class=\"note\" style=\"margin:2px 0\">${esc(w)}</p>`).join(\"\")}</details>`:\"\"}",
"   <div id=\"impProg\" hidden><div class=\"prog\" style=\"margin-top:12px;height:6px;border-radius:3px;background:var(--line)\"><i id=\"impBar\" style=\"display:block;height:100%;width:0;background:var(--accent);border-radius:3px\"></i></div><p class=\"note\" id=\"impTxt\"></p></div>`;",
"  const s=sheet(\"\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 Excel\",body,`<button class=\"btn primary\" id=\"impGo\">\u0627\u0633\u062a\u064a\u0631\u0627\u062f ${P.list.length} \u064a\u0648\u0645</button><button class=\"btn\" data-close>\u0625\u0644\u063a\u0627\u0621</button>`);",
"  $(\"#impGo\").onclick=async()=>{",
"    const mode=(s.el.querySelector('input[name=\"impMode\"]:checked')||{}).value||\"skip\",daySheets=$(\"#impSheets\").checked;",
"    const go=$(\"#impGo\");go.disabled=true;s.el.querySelectorAll(\"input\").forEach(x=>x.disabled=true);$(\"#impProg\").hidden=false;",
"    const step=daySheets?8:31;const R={added:0,replaced:0,skipped:0};let done=0;",
"    for(let k=0;k<P.list.length;k+=step){",
"      const part=P.list.slice(k,k+step).map(d=>({date:d.date,boxes:d.boxes.map(b=>b||{}),returns:d.returns}));",
"      $(\"#impTxt\").textContent=`\u062c\u0627\u0631\u064d \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f: ${done} \u0645\u0646 ${P.list.length} \u064a\u0648\u0645\u2026`;",
"      try{const r=await api(\"importDays\",{days:part,mode,daySheets});R.added+=r.added;R.replaced+=r.replaced;R.skipped+=r.skipped}",
"      catch(e){$(\"#impTxt\").textContent=`\u062a\u0648\u0642\u0641 \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0639\u0646\u062f ${done} \u064a\u0648\u0645: ${e.msg||\"\u062e\u0637\u0623\"}. \u0623\u0639\u062f \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0644\u0641 \u0648\u0627\u062e\u062a\u0631 \u00ab\u0625\u0628\u0642\u0627\u0621 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u00bb \u0644\u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0628\u0627\u0642\u064a.`;go.disabled=false;go.textContent=\"\u0625\u063a\u0644\u0627\u0642\";go.onclick=()=>s.close();lastOk=0;poll();return}",
"      done+=part.length;$(\"#impBar\").style.width=(done/P.list.length*100)+\"%\";",
"    }",
"    $(\"#impTxt\").textContent=`\u062a\u0645: \u0623\u064f\u0636\u064a\u0641 ${R.added} \u064a\u0648\u0645${R.replaced?`\u060c \u0648\u0627\u0633\u062a\u064f\u0628\u062f\u0644 ${R.replaced}`:\"\"}${R.skipped?`\u060c \u0648\u062a\u064f\u062e\u0637\u0651\u064a ${R.skipped} \u0645\u0648\u062c\u0648\u062f`:\"\"}.`;",
"    go.disabled=false;go.textContent=\"\u062a\u0645\";go.onclick=()=>{s.close();render()};poll();",
"  };",
"}",
"async function downloadTemplate(){",
"  try{await loadXLSX()}catch(e){toast(e.message);return}",
"  const ws=XLSX.utils.aoa_to_sheet([TPL_HEAD]);ws[\"!cols\"]=TPL_HEAD.map((h,i)=>({wch:i===2?18:i===10?20:13}));",
"  const wr=XLSX.utils.aoa_to_sheet([[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0631\u062a\u062c\u0639\",\"\u0645\u0644\u0627\u062d\u0638\u0627\u062a\"]]);",
"  const wb=XLSX.utils.book_new();wb.Workbook={Views:[{RTL:true}]};XLSX.utils.book_append_sheet(wb,ws,\"\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\");XLSX.utils.book_append_sheet(wb,wr,\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\");",
"  XLSX.writeFile(wb,\"\u0646\u0645\u0648\u0630\u062c-\u0627\u0633\u062a\u064a\u0631\u0627\u062f-\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642.xlsx\");",
"}",
