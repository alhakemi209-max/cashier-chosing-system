"  ${fxSummaryCard(cur)}${bfCard([cur],\"\u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0628\u0646\u0643 \u0644\u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645\")}<div class=\"card\"><h2 style=\"margin-bottom:6px\">\u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629</h2>",
