"    const v=await ask(`\u062a\u0627\u0631\u064a\u062e ${dayName(date)} <span class=\"num\">${dmy(date)}</span> \u0644\u0627\u062d\u0642 \u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u064a\u0648\u0645. \u0645\u062a\u0623\u0643\u062f \u062a\u0628\u064a \u062a\u062f\u062e\u0644 \u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u061f`,[{t:\"\u0646\u0639\u0645\u060c \u0645\u062a\u0627\u0628\u0639\u0629\",v:1,cls:\"primary\"},{t:\"\u0625\u0644\u063a\u0627\u0621\",v:0}]);",
"    if(!v){$(\"#datePick\").value=cur.date;return}}",
