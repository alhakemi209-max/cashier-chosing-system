"  const lv=$(\"#live\");lv.hidden=!r;const on=Date.now()-lastOk<POLL_MS*3;lv.className=\"live \"+(on?\"on\":\"off\");lv.title=on?\"\u0645\u062a\u0635\u0644\u060c \u0627\u0644\u062a\u062d\u062f\u064a\u062b \u0645\u0628\u0627\u0634\u0631\":\"\u063a\u064a\u0631 \u0645\u062a\u0635\u0644\";lv.setAttribute(\"aria-label\",lv.title);",
"  renderBell();",
