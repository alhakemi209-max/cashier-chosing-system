"  MYAV=typeof b.avatar===\"string\"?b.avatar:MYAV;me=b.user;if(me&&(me.lang==='en'||me.lang==='ar')&&me.lang!==LANG)setTimeout(()=>setLang(me.lang,true),0);settings=Object.assign(settings,b.settings);syncBoxes();loadLogo(settings.logoV||\"\");loadWm(settings.wmV||\"\");if(b.accDays)ACCD=b.accDays;if(b.appUrl)APPURL=b.appUrl;if(b.leadDays)LEADD=b.leadDays;applyMe();TODAY=b.today;sheetUrl=b.sheetUrl;lastRev=b.rev||lastRev;",
"  if(b.now)clockSkew=Date.parse(b.now)-Date.now();",
