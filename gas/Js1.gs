"  const rc=cur.returns.filter(r=>r.amount).length;",
"  $(\"#view\").innerHTML=`${effectiveRole()===\"acc\"&&yearClosed(cur.date)?`<div class=\"banner short\">\u0633\u0646\u0629 <b class=\"num\">${cur.date.slice(0,4)}</b> \u0645\u0642\u0641\u0644\u0629\u060c \u0648\u0623\u064a\u0627\u0645\u0647\u0627 \u0645\u062a\u0627\u062d\u0629 \u0644\u0644\u0627\u0637\u0644\u0627\u0639 \u0648\u0627\u0644\u0637\u0628\u0627\u0639\u0629 \u0641\u0642\u0637.</div>`:effectiveRole()===\"acc\"&&!periodOpen(cur.date)?`<div class=\"banner short\">\u0647\u0630\u0627 \u0627\u0644\u064a\u0648\u0645 \u0636\u0645\u0646 \u0641\u062a\u0631\u0629 \u0645\u063a\u0644\u0642\u0629 (\u0623\u0642\u062f\u0645 \u0645\u0646 <b class=\"num\">${ACCD}</b> \u064a\u0648\u0645\u0627\u064b)\u060c \u0648\u0645\u062a\u0627\u062d \u0644\u0644\u0627\u0637\u0644\u0627\u0639 \u0648\u0627\u0644\u0637\u0628\u0627\u0639\u0629 \u0641\u0642\u0637.</div>`:\"\"}${effectiveRole()===\"mgr\"?`<div class=\"info\">\u0648\u0636\u0639 \u0627\u0644\u0627\u0637\u0644\u0627\u0639: \u0639\u0631\u0636 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0648\u0637\u0628\u0627\u0639\u062a\u0647\u0627 \u0628\u062f\u0648\u0646 \u062a\u0639\u062f\u064a\u0644.</div>`:effectiveRole()===\"sup\"?`<div class=\"info\">\u064a\u0645\u0643\u0646\u0643 \u062a\u0639\u062f\u064a\u0644 \u0643\u0644 \u0635\u0646\u062f\u0648\u0642 \u062e\u0644\u0627\u0644 <b class=\"num\">${settings.supHours}</b> \u0633\u0627\u0639\u0627\u062a \u0645\u0646 \u0623\u0648\u0644 \u062d\u0641\u0638 \u0644\u0647\u060c \u0628\u0639\u062f\u0647\u0627 \u064a\u064f\u0642\u0641\u0644 \u0648\u064a\u0639\u062f\u0651\u0644\u0647 \u0627\u0644\u0645\u062d\u0627\u0633\u0628 \u0641\u0642\u0637.</div>`:\"\"}${stripHTML(t)}",
"  ${rqStrip()}${sentStrip()}<div class=\"sec-h\"><h2>\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642</h2>${canEditDay()?`<button class=\"btn small\" id=\"copyNames\">\u0646\u0633\u062e \u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a \u0645\u0646 \u0622\u062e\u0631 \u064a\u0648\u0645</button>`:\"\"}${canMoveDay()?`<button class=\"btn small\" id=\"moveDay\">\u062a\u063a\u064a\u064a\u0631 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u064a\u0648\u0645</button>`:\"\"}</div>",
