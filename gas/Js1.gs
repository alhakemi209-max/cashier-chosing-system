"  s.el.querySelectorAll(\"[data-k]\").forEach(inp=>inp.addEventListener(\"input\",()=>{const k=inp.dataset.k;b[k]=inp.classList.contains(\"money\")?calc(inp.value):inp.value;if(inp.classList.contains(\"money\")){const h=$(\"#xh-\"+inp.id);if(h)h.textContent=isExpr(inp.value)?\"= \"+fmt(b[k]):\"\"}if(k!==\"cashier\"&&!b.cashier)b.cashier=$(\"#b-cashier\").value.trim();if(k!==\"shift\"){const sf=shiftOf(b.cashier),se=$(\"#b-shift\");if(sf&&se&&(k===\"cashier\"||!b.shift)){b.shift=sf;se.value=sf}}if(k===\"cashSar\"){fxSync(b);fxPaint(b)}markBox(i);upd()}));",
"  s.el.querySelectorAll(\".money\").forEach(inp=>inp.addEventListener(\"blur\",()=>{const v=calc(inp.value);inp.value=v?String(r2(v)):\"\";const h=$(\"#xh-\"+inp.id);if(h)h.textContent=\"\"}));",
"  s.el.querySelectorAll(\"[data-plus]\").forEach(bt=>{bt.addEventListener(\"mousedown\",e=>e.preventDefault());bt.onclick=()=>{const x=$(\"#\"+bt.dataset.plus);if(!x||x.disabled)return;x.value=(x.value.trim()?x.value.trim():\"\")+\"+\";if(document.activeElement!==x)x._keep=true;x.focus();try{x.setSelectionRange(x.value.length,x.value.length)}catch(e){}}});",
"  s.el.querySelectorAll(\"[data-fx]\").forEach(x=>{if(!ed)x.disabled=true;x.addEventListener(\"input\",()=>{fxInput(b,x);markBox(i);upd()})});fxPaint(b);",
