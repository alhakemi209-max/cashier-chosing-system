"  const noDate=r===\"lead\"||(r===\"mgr\"&&!dateTabs())||(r===\"sup\"&&tab===\"short\")||[\"settings\",\"cashbox\",\"home\",\"petty\",\"branches\"].indexOf(tab)>=0;$(\"#dateBar\").hidden=!r||noDate;if(noDate){p.hidden=true}",
