"}",
"function ask(msg,btns){return new Promise(res=>{const s=sheet(\"\u062a\u0623\u0643\u064a\u062f\",`<p style=\"margin:10px 0\">${msg}</p>`,btns.map((b,i)=>`<button class=\"btn ${b.cls||\"\"}\" data-i=\"${i}\">${b.t}</button>`).join(\"\"),()=>res(null));",
"  s.el.querySelectorAll(\"[data-i]\").forEach(x=>x.onclick=()=>{$(\"#layer\").innerHTML=\"\";res(btns[+x.dataset.i].v)})})}",
"",
"/* ---------- roles & permissions ---------- */",
"function effectiveRole(){return ready&&me?me.role:null}",
"const PERM_DEF={acc:{tabs:[\"boxes\",\"summary\",\"reports\",\"commission\",\"att\",\"log\",\"cashbox\",\"petty\",\"branches\",\"settings\"],xlsx:true,wa:false,days:0},own:{tabs:[\"branches\",\"summary\",\"reports\",\"sales\",\"short\"],xlsx:true,wa:false,days:0},mgr:{tabs:[\"short\",\"sales\"],xlsx:false,wa:false,days:7},sup:{tabs:[\"boxes\",\"summary\"],xlsx:true,wa:false,days:7},lead:{tabs:[\"cash\",\"short\"],xlsx:false,wa:true,days:7}};",
"const PERM_ALLOWED={acc:PERM_DEF.acc.tabs,own:[\"branches\",\"summary\",\"reports\",\"sales\",\"short\",\"boxes\",\"commission\",\"att\",\"log\",\"cashbox\",\"petty\"],mgr:[\"short\",\"sales\",\"boxes\",\"summary\",\"reports\",\"commission\",\"att\",\"log\",\"cashbox\",\"petty\"],sup:[\"boxes\",\"summary\",\"short\"],lead:[\"cash\",\"short\"]};",
"function myPerms(){const r=me&&me.role;if(!r||!PERM_DEF[r])return{tabs:[]};return Object.assign({},PERM_DEF[r],r===\"acc\"?{}:(me.perms||{}))}",
"/* screens can be switched off in settings, and the branches report only shows when there is more than one branch */",
"const modOn=k=>k==='cashbox'?settings.modCashbox!==false:k==='petty'?!!settings.modPetty:k==='branches'?(ALLBR||BRANCHES||[]).length>1:true;",
"function myTabs(){const r=me&&me.role;if(!r||!PERM_DEF[r])return[];const p=myPerms();let t=PERM_ALLOWED[r].filter(k=>(p.tabs||[]).indexOf(k)>=0);if(!t.length)t=PERM_DEF[r].tabs.slice();const v=t.filter(modOn);return[\"home\"].concat(v.length?v:t.slice(0,1))}",
"function can(k){return !!myPerms()[k]}",
"function mgrModes(){const d=myPerms().days||7;return d>=60?[\"day\",\"week\",\"month\",\"range\"]:d>=30?[\"day\",\"week\",\"month\"]:d>=7?[\"day\",\"week\"]:[\"day\"]}",
"const dateTabs=()=>myTabs().some(k=>[\"boxes\",\"summary\",\"reports\",\"commission\",\"att\",\"log\"].indexOf(k)>=0);",
"function applyMe(){const p=myPerms();if(p.days)LEADD=p.days;document.body.classList.toggle(\"no-xlsx\",!p.xlsx)}",
"const isFuture=d=>d>todayISO(),futureOk=d=>!isFuture(d)||!!settings.allowFuture;",
"function allowedDate(d){const r=effectiveRole();if(r===\"acc\"&&!futureOk(d))return false;if(r===\"mgr\"){const t=todayISO();return d<=t&&d>addDays(t,-(myPerms().days||7))}if(r!==\"sup\")return true;const t=todayISO();return d===t||(settings.supPrev&&d===addDays(t,-1))}",
"const nowMs=()=>Date.now()+clockSkew;",
"const lockMs=()=>(+settings.supHours||12)*3600e3;",
"const yearClosed=d=>!!((settings.yearsClosed||{})[String(d||\"\").slice(0,4)]);",
"function periodOpen(d){return !yearClosed(d)&&d>=addDays(todayISO(),-ACCD)&&futureOk(d)}",
"function canEditDay(){const r=effectiveRole();return(r===\"acc\"&&periodOpen(cur.date))||(r===\"sup\"&&allowedDate(cur.date))}",
"function stampOpen(f){return !f||nowMs()-Date.parse(f)<lockMs()}",
"function canEditBox(i){const r=effectiveRole();if(r===\"acc\")return periodOpen(cur.date);if(r!==\"sup\"||!allowedDate(cur.date))return false;return stampOpen(cur.boxes[i].firstAt)}",
"function canEditRet(x){const r=effectiveRole();if(r===\"acc\")return periodOpen(cur.date);if(r!==\"sup\"||!allowedDate(cur.date))return false;return stampOpen(x.firstAt)}",
"function leftText(f){if(!f)return\"\";const m=Math.max(0,Math.round((lockMs()-(nowMs()-Date.parse(f)))/60000));return m>=60?Math.floor(m/60)+\" \u0633 \"+(m%60)+\" \u062f\":m+\" \u062f\"}",
"function renderNav(){",
