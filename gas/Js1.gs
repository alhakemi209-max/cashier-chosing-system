"function copyNames(){",
"  const prev=[...days.keys()].filter(d=>d<cur.date).sort().pop();",
"  if(!prev){toast(\"\u0644\u0627 \u064a\u0648\u062c\u062f \u064a\u0648\u0645 \u0645\u062d\u0641\u0648\u0638 \u0642\u0628\u0644 \u0647\u0630\u0627 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\");return}",
