"}",
"function applyRemote(r){",
"  lastRev=r.rev;if(r.settings){const lv=settings.logoV,wv=settings.wmV;settings=Object.assign(settings,r.settings);syncBoxes();if((settings.logoV||\"\")!==(lv||\"\"))loadLogo(settings.logoV||\"\");if((settings.wmV||\"\")!==(wv||\"\"))loadWm(settings.wmV||\"\");paintLogo()}if(r.sent){noticeNewSent(r.sent);sentLog=r.sent}",
"  noticeNewRq(r);(r.deleted||[]).forEach(d=>days.delete(d));(r.days||[]).map(fatDay).forEach(d=>days.set(d.date,d));",
"  cacheSave();",
"  const touched=(r.days||[]).some(d=>d.date===cur.date)||(r.deleted||[]).indexOf(cur.date)>=0;",
"  if(layerOpen()){if(touched)needMerge=true;renderTop();return}",
"  if(touched||needMerge){needMerge=false;mergeCur()}",
"  if(tab===\"settings\"||busyInput()){renderTop();return}",
"  const y=window.scrollY;render();window.scrollTo(0,y);",
"}",
"async function deleteDay(date){",
"  try{await api(\"deleteDay\",{date});days.delete(date);ls.del(\"ccd-pend-\"+date);loadDate(date);cacheSave();render();toast(\"\u062a\u0645 \u062d\u0630\u0641 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u064a\u0648\u0645\")}",
"  catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062d\u0630\u0641\")}",
"}",
"async function saveSettings(){",
"  try{settings=Object.assign(settings,await api(\"saveSettings\",settings));syncBoxes();cacheSave();toast(\"\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\");renderNav();renderTop();return true}",
"  catch(e){toast(e.msg||\"\u062a\u0639\u0630\u0651\u0631 \u062d\u0641\u0638 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\");return false}",
"}",
