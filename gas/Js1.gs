"function openReturns(){",
"  const opts=i=>`<option value=\"0\">\u2014 \u0627\u062e\u062a\u0631 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u2014</option>`+cur.boxes.map((b,k)=>`<option value=\"${k+1}\" ${i===k+1?\"selected\":\"\"} ${boxHidden(k)&&i!==k+1?\"hidden\":\"\"}>\u0635\u0646\u062f\u0648\u0642 ${BN(k)}${b.cashier?\" \u2014 \"+esc(b.cashier):\"\"}</option>`).join(\"\");",
"  const lines=()=>cur.returns.map((r,j)=>`<div class=\"ret-line\" data-j=\"${j}\">",
"     <div><small>\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0631\u062a\u062c\u0639</small><input class=\"inp money\" data-f=\"amount\" inputmode=\"decimal\" placeholder=\"-0.00\" value=\"${r.amount?r2(r.amount):\"\"}\"></div>",
