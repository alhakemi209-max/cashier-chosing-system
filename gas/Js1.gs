"  $(\"#dayLabel\").innerHTML=`${dayName(cur.date)} <span class=\"num\">${dmy(cur.date)}</span>`;$(\"#datePick\").value=cur.date;",
"  const p=$(\"#statusPill\");p.hidden=!r;",
"  if(syncState===\"saving\"){p.className=\"pill dirty\";p.textContent=\"\u062c\u0627\u0631\u064d \u0627\u0644\u062d\u0641\u0638\u2026\"}",
"  else if(syncState===\"error\"){p.className=\"pill err\";p.textContent=\"\u0628\u062f\u0648\u0646 \u0627\u062a\u0635\u0627\u0644\u060c \u0633\u064a\u064f\u062d\u0641\u0638 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b\"}",
"  else if(hasPend()){p.className=\"pill dirty\";p.textContent=\"\u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u062d\u0641\u0638\"}",
