"async function xlsxSave(filename,sheets){",
"  try{await loadXLSX()}catch(e){toast(e.message);return}",
"  try{",
"    const wb=XLSX.utils.book_new();wb.Workbook={Views:[{RTL:true}]};",
"    sheets.forEach(sh=>{const ws={};let mc=0;",
"      sh.rows.forEach((r,R)=>(r||[]).forEach((v,C)=>{if(v===\"\"||v==null)return;mc=Math.max(mc,C);const a=XLSX.utils.encode_cell({r:R,c:C});",
"        if(v instanceof XDate)ws[a]={t:\"n\",v:serial(v.iso),z:\"dd/mm/yyyy\"};",
"        else if(typeof v===\"number\")ws[a]=(sh.ints||[]).includes(C)||R===0?{t:\"n\",v}:{t:\"n\",v,z:\"#,##0.00\"};",
"        else ws[a]={t:\"s\",v:trText(String(v))}}));",
"      ws[\"!ref\"]=XLSX.utils.encode_range({s:{r:0,c:0},e:{r:Math.max(0,sh.rows.length-1),c:mc}});",
"      ws[\"!cols\"]=(sh.rows[0]||[]).map((h,i)=>({wch:(sh.cols&&sh.cols[i])||Math.max(10,String(h).length+4)}));",
"      XLSX.utils.book_append_sheet(wb,ws,trText(sh.name).slice(0,31))});",
"    const out=XLSX.write(wb,{bookType:\"xlsx\",type:\"array\"});",
"    saveFile(filename,new Blob([out],{type:\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\"}));",
"  }catch(e){toast(\"\u062a\u0639\u0630\u0651\u0631 \u0625\u0646\u0634\u0627\u0621 \u0645\u0644\u0641 Excel\")}",
