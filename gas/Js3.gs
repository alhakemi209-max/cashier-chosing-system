"/* ---------- monthly shortage statement (for signature) ---------- */",
"function stmtFor(name,list,label){preview(\"\u0643\u0634\u0641 \u0627\u0644\u0639\u062c\u0632 \u2014 \"+name,rcptStmt(name,list,label),`\u0643\u0634\u0641-\u0627\u0644\u0639\u062c\u0632-${name}-${label.replace(/[\\s/]+/g,\"-\")}.pdf`)}",
"function rcptStmt(name,list,label){const rows=[];let sh=0,n=0;",
