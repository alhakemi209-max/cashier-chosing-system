"  list.forEach(d=>d.boxes.forEach((b,i)=>{if(!hasData(b)||namesIn(b).indexOf(name)<0)return;n++;const df=r2(boxCalc(b).diff);if(df<0){sh=r2(sh+df);rows.push({date:d.date,box:BN(i),df})}}));",
"  return`<div class=\"rcpt\">${head(\"\u0625\u0642\u0631\u0627\u0631 \u0627\u0644\u0639\u062c\u0632\",`<div class=\"c\" style=\"font-weight:700\">${esc(name)} \u2014 ${label}</div>`)}${R(\"\u0639\u062f\u062f \u0627\u0644\u0625\u0642\u0641\u0627\u0644\u0627\u062a\",n)}${R(\"\u0623\u064a\u0627\u0645 \u0627\u0644\u0639\u062c\u0632\",rows.length)}",
"  <table><thead><tr><th>\u0627\u0644\u062a\u0627\u0631\u064a\u062e</th><th>\u0627\u0644\u0635\u0646\u062f\u0648\u0642</th><th class=\"n\">\u0627\u0644\u0639\u062c\u0632</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${dmy(r.date)}</td><td>${r.box}</td><td class=\"n\">${fmt(r.df)}</td></tr>`).join(\"\")||`<tr><td colspan=\"3\" class=\"c\">\u0644\u0627 \u064a\u0648\u062c\u062f \u0639\u062c\u0632 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0641\u062a\u0631\u0629</td></tr>`}</tbody>",
"</table>",
"  ${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0639\u062c\u0632\",fmt(sh),\"tot\")}",
