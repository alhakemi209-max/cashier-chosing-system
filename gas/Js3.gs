"  const T=A.T,L=[[\"\u0627\u0644\u0628\u064a\u0627\u0646\",\"\u0627\u0644\u0642\u064a\u0645\u0629\"],[\"\u0627\u0644\u0641\u062a\u0631\u0629\",label],[\"\u0639\u062f\u062f \u0627\u0644\u0623\u064a\u0627\u0645\",T.days],[\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634\",r2(T.cash)],[\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",r2(T.ret)],[\"\u0635\u0627\u0641\u064a \u0627\u0644\u0643\u0627\u0634\",r2(T.cashNet)]];",
"  NV().forEach(([k,l])=>L.push([l,r2(T.nets[k])]));",
"  if(A.list&&bfShow()){const B=bfCalc(A.list);if(B.sales){NETS.filter(([k])=>Object.keys(B.nets[k].rates).length).forEach(([k,l])=>L.push([\"\u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0628\u0646\u0643 - \"+BF_SHORT[k]+\" (\"+bfRateTxt(B.nets[k])+\")\",r2(B.nets[k].fee)]));if(B.vr)L.push([\"\u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0628\u0646\u0643 \u0642\u0628\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u0629\",B.fee],[\"\u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \"+B.vr+\"%\",B.vat]);L.push([\"\u0625\u062c\u0645\u0627\u0644\u064a \u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0628\u0646\u0643\",B.total],[\"\u0635\u0627\u0641\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0628\u0639\u062f \u0627\u0644\u0639\u0645\u0648\u0644\u0629\",r2(B.sales-B.total)])}}",
"  L.push([\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a\",r2(T.net)],[\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a\",r2(T.total)],[\"\u0625\u062c\u0645\u0627\u0644\u064a \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",r2(T.report)],[\"\u0635\u0627\u0641\u064a \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",r2(T.reportNet)],[\"\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0639\u062c\u0632\",r2(T.short)],[\"\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0632\u064a\u0627\u062f\u0629\",r2(T.over)],[\"\u0635\u0627\u0641\u064a \u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635\",r2(T.diff)],[\"\u0645\u062a\u0648\u0633\u0637 \u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u064a\u0648\u0645\",r2(T.reportNet/(T.days||1))]);",
"  return{name:\"\u0627\u0644\u0645\u0644\u062e\u0635\",rows:L,cols:[24,22]};",
"}",
"function xlsxReport(list,A,label){",
"  const sh=[xSummary(A,label),xDaily(A)];if(A.months.length>1)sh.push(xMonthly(A));sh.push(xPeople(A),xDetail(list));",
"  xlsxSave(`\u062a\u0642\u0631\u064a\u0631-\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a-${xname(label)}.xlsx`,sh);",
"}",
"function xlsxAll(){",
"  const list=[...days.values()].filter(d=>!d.namesOnly).map(normDay).sort((a,b)=>a.date<b.date?-1:1);",
"  if(!list.length){toast(\"\u0644\u0627 \u062a\u0648\u062c\u062f \u0628\u064a\u0627\u0646\u0627\u062a \u0644\u0644\u062a\u0635\u062f\u064a\u0631\");return}",
"  const A=aggregate(list),label=\"\u0645\u0646 \"+dmy(list[0].date)+\" \u0625\u0644\u0649 \"+dmy(list[list.length-1].date);",
"  xlsxSave(`\u0646\u0633\u062e\u0629-\u0643\u0627\u0645\u0644\u0629-${todayISO()}.xlsx`,[xSummary(A,label),xMonthly(A),xDaily(A),xPeople(A),xDetail(list)]);",
"}",
"function xlsxDay(day){",
"  const list=[day],A=aggregate(list);",
"  xlsxSave(`\u0625\u0642\u0641\u0627\u0644-\u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642-${day.date}.xlsx`,[xSummary(A,\"\u064a\u0648\u0645 \"+dayName(day.date)+\" \"+dmy(day.date)),xDetail(list)]);",
"}",
"function xlsxComm(list,C,label){",
"  const nt=settings.rateNet;",
"  const g=(L,first)=>{const rows=[[first,\"\u0625\u0642\u0641\u0627\u0644\u0627\u062a\",\"\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",...(nt?[\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",\"\u0627\u0644\u0635\u0627\u0641\u064a\"]:[]),\"\u0627\u0644\u0646\u0633\u0628\u0629\"]];",
"    L.forEach(x=>rows.push([x.label,x.n,r2(x.sales),...(nt?[r2(x.ret),r2(x.base)]:[]),r2(x.comm)]));",
"    rows.push([\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\",C.T.n,r2(C.T.sales),...(nt?[r2(C.T.ret),r2(C.T.base)]:[]),r2(C.T.comm)]);return rows};",
"  const byDay=[[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u064a\u0648\u0645\",\"\u0625\u0642\u0641\u0627\u0644\u0627\u062a\",\"\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",\"\u0627\u0644\u0646\u0633\u0628\u0629\"]];C.day.forEach(d=>byDay.push([xd(d.date),dayName(d.date),d.n,r2(d.base),r2(d.comm)]));",
"  const det=[[\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u064a\u0648\u0645\",\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",\"\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",\"\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",\"\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0643\u0644 1000\",\"\u0645\u0628\u0644\u063a \u0627\u0644\u0646\u0633\u0628\u0629\"]];",
"  list.forEach(d=>d.boxes.forEach((b,i)=>{if(!hasData(b))return;const s=+b.report||0,rt=nt?retOfBox(d,i):0,base=s+rt;det.push([xd(d.date),dayName(d.date),BN(i),b.cashier,r2(s),r2(rt),r2(base),C.rate,r2(base/1000*C.rate)])}));",
"  xlsxSave(`\u0646\u0633\u0628\u0629-\u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a-${xname(label)}.xlsx`,[",
"    {name:\"\u0627\u0644\u0645\u0644\u062e\u0635\",rows:[[\"\u0627\u0644\u0628\u064a\u0627\u0646\",\"\u0627\u0644\u0642\u064a\u0645\u0629\"],[\"\u0627\u0644\u0641\u062a\u0631\u0629\",label],[\"\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0643\u0644 1000 \u0631\u064a\u0627\u0644\",C.rate],[\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",r2(C.T.sales)],[\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",r2(C.T.ret)],[\"\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",r2(C.T.base)],[\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0646\u0633\u0628\u0629\",r2(C.T.comm)]],cols:[24,22]},",
"    {name:\"\u062d\u0633\u0628 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",rows:g(C.box,\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\"),ints:[1],cols:[14]},{name:\"\u062d\u0633\u0628 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\",rows:g(C.cash,\"\u0627\u0644\u0643\u0627\u0634\u064a\u0631\"),ints:[1],cols:[18]},",
"    {name:\"\u062d\u0633\u0628 \u0627\u0644\u064a\u0648\u0645\",rows:byDay,ints:[2],cols:[12,10]},{name:\"\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644\",rows:det,ints:[2],cols:[12,10,9,18]}]);",
"}",
"function xlsxAtt(A,label){",
"  const sum=[[\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0646\u0648\u0639 \u0627\u0644\u062f\u0648\u0627\u0645\",\"\u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\",\"\u062d\u0636\u0648\u0631\",\"\u063a\u064a\u0627\u0628\",\"\u0623\u0648\u0641\",\"\u0639\u0645\u0644 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\"]];",
"  A.rows.forEach(r=>sum.push([r.name,r.type||\"\",r.off||\"\",r.c.p+r.c.po,r.c.a,r.c.o,r.c.po]));",
"  const code={p:\"\u062d\",po:\"\u062d*\",a:\"\u063a\",o:\"\u0623\"};",
"  const grid=[[\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\",...A.dates.map(d=>dmy(d).slice(0,5))]];",
"  A.rows.forEach(r=>grid.push([r.name,...r.cells.map(x=>x.s?code[x.s]:\"\")]));",
"  grid.push([]);grid.push([\"\u062d = \u062d\u0627\u0636\u0631\u060c \u062d* = \u062d\u0627\u0636\u0631 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u0623\u0648\u0641\u060c \u063a = \u063a\u064a\u0627\u0628\u060c \u0623 = \u0623\u0648\u0641\"]);",
"  const det=[[\"\u0627\u0644\u0645\u0648\u0638\u0641\u0629\",\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",\"\u0627\u0644\u064a\u0648\u0645\",\"\u0627\u0644\u062d\u0627\u0644\u0629\",\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\"]];",
"  A.rows.forEach(r=>r.cells.forEach(x=>{if(x.s)det.push([r.name,xd(x.d),dayName(x.d),ATT[x.s][0],x.box])}));",
"  xlsxSave(`\u0627\u0644\u062d\u0636\u0648\u0631-${xname(label)}.xlsx`,[{name:\"\u0645\u0644\u062e\u0635 \u0627\u0644\u062d\u0636\u0648\u0631\",rows:sum,ints:[3,4,5,6],cols:[18,10,10]},{name:\"\u062c\u062f\u0648\u0644 \u0627\u0644\u062d\u0636\u0648\u0631\",rows:grid,cols:[18,...A.dates.map(()=>6)]},{name:\"\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644\",rows:det,cols:[18,12,10,16,10]}]);",
"}",
"",
"/* ---------- receipts (80mm) ---------- */",
"const head=(title,sub)=>`${logoHTML()}<div class=\"t1\">${esc(settings.store)}</div><div class=\"t2\">${esc(settings.branch)}</div><div class=\"t3\">${title}</div>${sub||\"\"}`;",
"const R=(l,v,c)=>`<div class=\"r ${c||\"\"}\"><span>${l}</span><span>${v}</span></div>`;",
"const sigs=()=>`<div class=\"sig\"><div>${esc(settings.signA)}</div><div>${esc(settings.signB)}</div></div>`;",
"const dateRows=d=>R(\"\u0627\u0644\u062a\u0627\u0631\u064a\u062e\",dmy(d))+R(\"\u0627\u0644\u064a\u0648\u0645\",dayName(d));",
"function rcptBox(day,i){",
"  const b=day.boxes[i],c=boxCalc(b),rt=retOfBox(day,i);const st=statusOf(c.diff);",
"  return`<div class=\"rcpt\">${head(\"\u062a\u0642\u0631\u064a\u0631 \u0625\u0642\u0641\u0627\u0644 \u0627\u0644\u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u064a\u0648\u0645\u064a\")}${dateRows(day.date)}${R(\"\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",boxText(i))}${R(\"\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u0646\u062f\u0648\u0642\",esc(b.cashier)||\"\u2014\")}${R(\"\u0627\u0644\u0648\u0631\u062f\u064a\u0629\",esc(b.shift)||\"\u2014\")}",
"  <div class=\"h\">\u0627\u0644\u0645\u0642\u0628\u0648\u0636\u0627\u062a \u0627\u0644\u0646\u0642\u062f\u064a\u0629</div>${R(\"\u0627\u0644\u0643\u0627\u0634\",fmt(b.cash))}${rt?R(\"\u0645\u0631\u062a\u062c\u0639\u0627\u062a \u0645\u0635\u0631\u0648\u0641\u0629\",fmt(rt))+R(\"\u0635\u0627\u0641\u064a \u0627\u0644\u0643\u0627\u0634 \u0627\u0644\u0645\u0633\u0644\u064e\u0651\u0645\",fmt((+b.cash||0)+rt),\"tot\"):\"\"}",
"  <div class=\"h\">\u0645\u0642\u0628\u0648\u0636\u0627\u062a \u0627\u0644\u0634\u0628\u0643\u0627\u062a</div>${NV().map(([k,l])=>R(l,fmt(b[k]))).join(\"\")}${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a\",fmt(c.net),\"tot\")}",
"  <div class=\"h\">\u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u0645\u0639 \u0627\u0644\u0646\u0638\u0627\u0645</div>${R(\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a\",fmt(c.total))}${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u0642\u0631\u064a\u0631 (\u0627\u0644\u0646\u0638\u0627\u0645)\",fmt(b.report))}${R(\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635\",fmtS(c.diff),\"tot\")}",
"  ${(b.report||c.total)?`<div class=\"st\">*** ${st[1]} ***</div>`:\"\"}",
"  <div style=\"font-weight:700;margin-top:6px\">\u0645\u0644\u0627\u062d\u0638\u0627\u062a</div><div class=\"notes\">${esc(b.notes)}</div>${sigs()}<div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"function rcptReturns(day){",
"  const L=day.returns.filter(r=>r.amount);const tot=L.reduce((s,r)=>s+r.amount,0);",
"  return`<div class=\"rcpt\">${head(\"\u062a\u0642\u0631\u064a\u0631 \u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\")}${dateRows(day.date)}",
"  <table><thead><tr><th>#</th><th>\u0645\u0646 \u0635\u0646\u062f\u0648\u0642</th><th>\u0645\u0644\u0627\u062d\u0638\u0629</th><th class=\"n\">\u0627\u0644\u0642\u064a\u0645\u0629</th></tr></thead><tbody>${L.map((r,j)=>`<tr><td>${j+1}</td><td>${r.box?BN(r.box-1):\"\u2014\"}${r.box&&day.boxes[r.box-1].cashier?\" (\"+esc(day.boxes[r.box-1].cashier)+\")\":\"\"}</td><td class=\"who\">${esc(r.note)}</td><td class=\"n\">${fmt(r.amount)}</td></tr>`).join(\"\")||`<tr><td colspan=\"4\" class=\"c\">\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0631\u062a\u062c\u0639\u0627\u062a</td></tr>`}</tbody>",
"  <tfoot><tr><td colspan=\"3\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</td><td class=\"n\">${fmt(tot)}</td></tr></tfoot></table>${sigs()}<div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"function rcptDay(day){",
"  const t=dayCalc(day);const list=day.boxes.map((b,i)=>[b,i]).filter(([b])=>hasData(b));",
"  return`<div class=\"rcpt\">${head(\"\u0645\u0644\u062e\u0635 \u0625\u0642\u0641\u0627\u0644 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u064a\u0648\u0645\u064a\")}${dateRows(day.date)}${R(\"\u0639\u062f\u062f \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642\",t.count)}",
"  <table><thead><tr><th>\u0635</th><th>\u0627\u0644\u0643\u0627\u0634\u064a\u0631</th><th class=\"n\">\u0643\u0627\u0634</th><th class=\"n\">\u0634\u0628\u0643\u0627\u062a</th><th class=\"n\">\u0625\u062c\u0645\u0627\u0644\u064a</th><th class=\"n\">\u062a\u0642\u0631\u064a\u0631</th><th class=\"n\">\u0641\u0631\u0642</th></tr></thead><tbody>",
"  ${list.map(([b,i])=>{const c=boxCalc(b);return`<tr><td>${BN(i)}</td><td class=\"who\">${esc(b.cashier)}</td><td class=\"n\">${fmt(b.cash)}</td><td class=\"n\">${fmt(c.net)}</td><td class=\"n\">${fmt(c.total)}</td><td class=\"n\">${fmt(b.report)}</td><td class=\"n\">${fmtS(c.diff)}</td></tr>`}).join(\"\")}</tbody>",
"  <tfoot><tr><td colspan=\"2\">\u0627\u0644\u0645\u062c\u0645\u0648\u0639</td><td class=\"n\">${fmt(t.cash)}</td><td class=\"n\">${fmt(t.net)}</td><td class=\"n\">${fmt(t.cash+t.net)}</td><td class=\"n\">${fmt(t.report)}</td><td class=\"n\">${fmtS(t.diff)}</td></tr></tfoot></table>",
"  ${t.ret?`<div class=\"h\">\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a</div>${day.returns.filter(r=>r.amount).map(r=>R(\"\u0645\u0646 \u0635\u0646\u062f\u0648\u0642 \"+(r.box?BN(r.box-1):\"\u2014\")+(r.note?\" - \"+esc(r.note):\"\"),fmt(r.amount))).join(\"\")}`:\"\"}",
"  <div class=\"h\">\u0627\u0644\u0634\u0628\u0643\u0627\u062a</div>${NV().map(([k,l])=>R(l,fmt(t.nets[k]))).join(\"\")}${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a\",fmt(t.net),\"tot\")}",
"  <div class=\"h\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a</div>${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634\",fmt(t.cash))}${R(\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",fmt(t.ret))}${R(\"\u0635\u0627\u0641\u064a \u0627\u0644\u0643\u0627\u0634\",fmt(t.cashNet),\"tot\")}",
"  ${R(\"\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0644\u064a\",fmt(t.total))}${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",fmt(t.report))}${R(\"\u0635\u0627\u0641\u064a \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",fmt(t.reportNet),\"tot\")}${R(\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635\",fmtS(t.diff),\"tot\")}",
"  ${t.count?`<div class=\"st\">*** ${statusOf(t.diff)[1]} ***</div>`:\"\"}${sigs()}<div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"function rcptPeriod(A,label,ana){",
"  const T=A.T,byMonth=rep.mode===\"year\";",
"  const rows=byMonth?A.months.map(m=>`<tr><td>${MONTHS[+m.key.slice(5)-1]}</td><td class=\"n\">${fmt(m.cashNet)}</td><td class=\"n\">${fmt(m.net)}</td><td class=\"n\">${fmt(m.cashNet+m.net)}</td><td class=\"n\">${fmt(m.reportNet)}</td><td class=\"n\">${fmtS(m.diff)}</td></tr>`).join(\"\")",
"    :A.rows.map(r=>`<tr><td>${r.date.slice(8)}/${r.date.slice(5,7)}</td><td class=\"n\">${fmt(r.cashNet)}</td><td class=\"n\">${fmt(r.net)}</td><td class=\"n\">${fmt(r.cashNet+r.net)}</td><td class=\"n\">${fmt(r.reportNet)}</td><td class=\"n\">${fmtS(r.diff)}</td></tr>`).join(\"\");",
"  return`<div class=\"rcpt\">${head(ana?\"\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u062a\u062d\u0644\u064a\u0644\u064a\":\"\u0645\u0644\u062e\u0635 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",`<div class=\"c\" style=\"font-weight:700\">${label}</div>`)}${R(\"\u0639\u062f\u062f \u0627\u0644\u0623\u064a\u0627\u0645\",T.days)}${ana?`",
"  <table><thead><tr><th>${byMonth?\"\u0627\u0644\u0634\u0647\u0631\":\"\u0627\u0644\u064a\u0648\u0645\"}</th><th class=\"n\">\u0643\u0627\u0634</th><th class=\"n\">\u0634\u0628\u0643\u0627\u062a</th><th class=\"n\">\u0625\u062c\u0645\u0627\u0644\u064a</th><th class=\"n\">\u062a\u0642\u0627\u0631\u064a\u0631</th><th class=\"n\">\u0641\u0631\u0642</th></tr></thead><tbody>${rows}</tbody>",
"  <tfoot><tr><td>\u0627\u0644\u0645\u062c\u0645\u0648\u0639</td><td class=\"n\">${fmt(T.cashNet)}</td><td class=\"n\">${fmt(T.net)}</td><td class=\"n\">${fmt(T.cashNet+T.net)}</td><td class=\"n\">${fmt(T.reportNet)}</td><td class=\"n\">${fmtS(T.diff)}</td></tr></tfoot></table>`:\"\"}",
"  <div class=\"h\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a</div>${R(\"\u0635\u0627\u0641\u064a \u0627\u0644\u0643\u0627\u0634\",fmt(T.cashNet))}${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a\",fmt(T.net))}${R(\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",fmt(T.ret))}${R(\"\u0635\u0627\u0641\u064a \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",fmt(T.reportNet),\"tot\")}",
"  ${R(\"\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0639\u062c\u0632\",fmt(T.short))}${R(\"\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0632\u064a\u0627\u062f\u0629\",fmt(T.over))}${R(\"\u0635\u0627\u0641\u064a \u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635\",fmtS(T.diff),\"tot\")}${R(\"\u0645\u062a\u0648\u0633\u0637 \u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u064a\u0648\u0645\",fmt(T.reportNet/(T.days||1)))}",
"  <div class=\"h\">\u0627\u0644\u0634\u0628\u0643\u0627\u062a</div>${NV().map(([k,l])=>R(l,fmt(T.nets[k]))).join(\"\")}${bfPrint(A.list)}${ana?`",
"  <div class=\"h\">\u0627\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a</div><table><thead><tr><th>\u0627\u0644\u0643\u0627\u0634\u064a\u0631</th><th class=\"n\">\u0625\u0642\u0641\u0627\u0644</th><th class=\"n\">\u0645\u0628\u064a\u0639\u0627\u062a</th><th class=\"n\">\u0635\u0627\u0641\u064a \u0641\u0631\u0642</th></tr></thead><tbody>",
"  ${A.people.map(p=>`<tr><td class=\"who\" style=\"max-width:110px\">${esc(p.name)}</td><td class=\"n\">${p.n}</td><td class=\"n\">${fmt(p.sales)}</td><td class=\"n\">${fmtS(p.diff)}</td></tr>`).join(\"\")}</tbody></table>`:\"\"}",
"  ${sigs()}<div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"",
"function bfPrint(list){if(!list||!bfShow())return\"\";const B=bfCalc(list);if(!B.sales)return\"\";",
"  return`<div class=\"h\">\u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0628\u0646\u0643</div>${NETS.filter(([k])=>B.nets[k].fee>0||Object.keys(B.nets[k].rates).length).map(([k,l])=>R(BF_SHORT[k]+\" \"+bfRateTxt(B.nets[k]),fmt(B.nets[k].fee))).join(\"\")}${B.vr?R(\"\u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0642\u0628\u0644 \u0627\u0644\u0636\u0631\u064a\u0628\u0629\",fmt(B.fee))+R(\"\u0627\u0644\u0636\u0631\u064a\u0628\u0629 \"+B.vr+\"%\",fmt(B.vat)):\"\"}${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u0628\u0646\u0643\",fmt(B.total),\"tot\")}${R(\"\u0635\u0627\u0641\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a \u0628\u0639\u062f \u0627\u0644\u0639\u0645\u0648\u0644\u0629\",fmt(B.sales-B.total))}`}",
"function rcptDayShort(day,detailed){",
"  const t=dayCalc(day);",
"  return`<div class=\"rcpt\">${head(detailed?\"\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u064a\u0648\u0645\u064a \u2014 \u0645\u0641\u0635\u0651\u0644\":\"\u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u064a\u0648\u0645\u064a \u2014 \u0645\u062c\u0645\u0651\u0639\")}${dateRows(day.date)}${R(\"\u0639\u062f\u062f \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642\",t.count)}",
"  <div class=\"h\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a</div>${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634\",fmt(t.cashNet),\"tot\")}",
"  ${detailed?`<div class=\"h\">\u0627\u0644\u0634\u0628\u0643\u0627\u062a</div>`+NV().map(([k,l])=>R(l,fmt(t.nets[k]))).join(\"\")+R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a\",fmt(t.net),\"tot\"):R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0628\u0643\u0627\u062a\",fmt(t.net),\"tot\")}",
"  ${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0643\u0627\u0634 \u0648\u0627\u0644\u0634\u0628\u0643\u0627\u062a\",fmt(t.total),\"tot\")}${detailed?`<div class=\"h\">\u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629</div>`:\"\"}${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645\",fmt(t.reportNet),\"tot\")}${R(\"\u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635\",fmtS(t.diff),\"tot\")}",
"  ${t.count?`<div class=\"st\">*** ${statusOf(t.diff)[1]} ***</div>`:\"\"}",
"  ${t.ret?`<div style=\"font-size:10.5px;margin-top:4px\">* \u0627\u0644\u0643\u0627\u0634 \u0648\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0628\u0639\u062f \u062e\u0635\u0645 \u0645\u0631\u062a\u062c\u0639\u0627\u062a \u0628\u0642\u064a\u0645\u0629 <span style=\"direction:ltr;unicode-bidi:isolate\">${fmt(t.ret)}</span></div>`:\"\"}",
"  ${sigs()}<div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"function rcptComm(C,label){",
"  const T=C.T,g=com.group;",
"  const L=g===\"day\"?C.day.map(d=>({label:d.date.slice(8)+\"/\"+d.date.slice(5,7)+\" \"+dayName(d.date),base:d.base,comm:d.comm})):(g===\"box\"?C.box:C.cash);",
"  return`<div class=\"rcpt\">${head(\"\u062a\u0642\u0631\u064a\u0631 \u0646\u0633\u0628\u0629 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",`<div class=\"c\" style=\"font-weight:700\">${label}</div>`)}${R(\"\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0643\u0644 1,000 \u0631\u064a\u0627\u0644\",fmt(C.rate))}${R(\"\u0639\u062f\u062f \u0627\u0644\u0623\u064a\u0627\u0645\",T.days)}",
"  <table><thead><tr><th>${g===\"box\"?\"\u0627\u0644\u0635\u0646\u062f\u0648\u0642\":g===\"cash\"?\"\u0627\u0644\u0643\u0627\u0634\u064a\u0631\":\"\u0627\u0644\u064a\u0648\u0645\"}</th><th class=\"n\">\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a</th><th class=\"n\">\u0627\u0644\u0646\u0633\u0628\u0629</th></tr></thead>",
"  <tbody>${L.map(x=>`<tr><td class=\"who\" style=\"max-width:120px\">${esc(x.label)}</td><td class=\"n\">${fmt(x.base)}</td><td class=\"n\">${fmt(x.comm)}</td></tr>`).join(\"\")}</tbody>",
"  <tfoot><tr><td>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td><td class=\"n\">${fmt(T.base)}</td><td class=\"n\">${fmt(T.comm)}</td></tr></tfoot></table>",
"  <div class=\"h\">\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a</div>${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",fmt(T.sales))}${settings.rateNet?R(\"\u0627\u0644\u0645\u0631\u062a\u062c\u0639\u0627\u062a\",fmt(T.ret)):\"\"}${R(\"\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\",fmt(T.base))}${R(\"\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0646\u0633\u0628\u0629\",fmt(T.comm),\"tot\")}",
"  ${sigs()}<div class=\"foot\">\u0634\u0643\u0631\u0627\u064b \u0644\u0643\u0645</div></div>`;",
"}",
"",
"/* ---------- preview, print & PDF ---------- */",
"let paper=ls.get(\"ccd-paper\")||\"80\";",
"/* colour the printed report like the screen: shortages red, surpluses amber, matched green */",
"function colorRcpt(html){",
"  if(String(html).indexOf(\"data-clr\")>=0)return html;",
"  const box=document.createElement(\"div\");box.innerHTML=html;",
"  if(wmSrc())box.querySelectorAll(\".rcpt\").forEach(R=>{const w=document.createElement(\"div\");w.className=\"wm\";w.setAttribute(\"aria-hidden\",\"true\");wmStyle(w,wmSrc(),wmOp(1),\"rcpt\");R.insertBefore(w,R.firstChild)});",
"  const val=t=>{t=String(t||\"\").replace(/[\\u200e\\u200f\\u202a-\\u202e\\s]/g,\"\").replace(/[\u0660-\u0669]/g,d=>\"\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669\".indexOf(d)).replace(/,/g,\"\").replace(\"\u2212\",\"-\");return/^[-+]?\\d+(\\.\\d+)?$/.test(t)?parseFloat(t):null};",
"  const diffWord=/\u0627\u0644\u0641\u0631\u0642|\u0627\u0644\u0632\u064a\u0627\u062f\u0629|\u0627\u0644\u0646\u0642\u0635|\u0627\u0644\u0639\u062c\u0632|\u0627\u0644\u0635\u0627\u0641\u064a|\u0627\u0644\u0639\u062c\u0632 \\/ \u0627\u0644\u0632\u064a\u0627\u062f\u0629/;",
"  box.querySelectorAll(\".rcpt\").forEach(R=>{",
"    R.setAttribute(\"data-clr\",\"1\");",
"    R.querySelectorAll(\"td,.r>span:last-child,.r>b,.r b\").forEach(e=>{if(e.children.length)return;const v=val(e.textContent);if(v!==null&&v<0)e.classList.add(\"neg\")});",
"    R.querySelectorAll(\".r\").forEach(r=>{const k=r.firstElementChild,l=r.lastElementChild;if(!k||!l||k===l)return;const v=val(l.textContent);if(v!==null&&v>0&&diffWord.test(k.textContent))l.classList.add(\"pos\")});",
"    R.querySelectorAll(\"table\").forEach(tb=>{const hs=[...tb.querySelectorAll(\"thead th\")].map(th=>diffWord.test(th.textContent));",
"      tb.querySelectorAll(\"tbody tr,tfoot tr\").forEach(tr=>[...tr.children].forEach((td,i)=>{if(!hs[i])return;const v=val(td.textContent);if(v!==null&&v>0)td.classList.add(\"pos\")}))});",
"    R.querySelectorAll(\".st\").forEach(s=>{const t=s.textContent;s.classList.add(/\u0639\u062c\u0632|\u0646\u0642\u0635/.test(t)?\"s-short\":/\u0632\u064a\u0627\u062f\u0629/.test(t)?\"s-over\":\"s-ok\")});",
"  });",
"  return box.innerHTML;",
"}",
"/* shrink the type until every column fits the printable width of the chosen paper */",
"/* the receipt is fitted to 64 mm so it also fits cashier printers whose printable width is narrower than 72 mm */",
"const FIT={a4:{w:\"180mm\",fs:10.5,min:6.5},\"80\":{w:\"64mm\",fs:8.6,min:4.6}};",
"function fitRcpt(html,pp){",
"  const F=FIT[pp]||FIT[\"80\"],box=document.createElement(\"div\");",
"  box.className=pp===\"a4\"?\"a4 fitm\":\"fitm\";box.style.cssText=\"position:absolute;left:-10000px;top:0;visibility:hidden;width:\"+F.w;",
"  box.innerHTML=html;document.body.appendChild(box);",
"  box.querySelectorAll(\".rcpt\").forEach(r=>{",
"    const a4p=r.classList.contains(\"a4p\");let fs=a4p?(parseFloat(r.style.getPropertyValue(\"--fs\"))||10.2):F.fs;",
"    r.style.width=\"100%\";r.style.maxWidth=\"none\";",
"    const set=()=>{r.style.fontSize=fs+\"pt\";if(a4p)r.style.setProperty(\"--fs\",fs+\"pt\")};",
"    const wide=()=>{const w=r.clientWidth+1;if(r.scrollWidth>w)return true;for(const t of r.querySelectorAll(\"table\"))if(t.scrollWidth>w||t.getBoundingClientRect().width>w)return true;",
"      for(const c of r.querySelectorAll(\"td,th,.r>*\"))if(c.scrollWidth>c.clientWidth+1)return true;",
"      // the one-page A4 report must also fit the page height",
"      return a4p&&r.scrollHeight>r.clientHeight+1};",
"    set();while(wide()&&fs>F.min){fs=Math.round((fs-.25)*100)/100;set()}",
"    // still taller than one page at the smallest type: let it continue on a second page instead of cutting it",
"    if(a4p&&r.scrollHeight>r.clientHeight+1)r.classList.add(\"a4tall\");",
"    r.style.removeProperty(\"width\");r.style.removeProperty(\"max-width\");r.setAttribute(\"data-fit\",pp);",
"  });",
"  const out=box.innerHTML;box.remove();return out;",
"}",
"/* every printed copy, PDF or image carries who printed it and when */",
"function printStamp(){",
"  const p=Object.fromEntries(new Intl.DateTimeFormat(\"en-GB\",{timeZone:\"Asia/Riyadh\",year:\"numeric\",month:\"2-digit\",day:\"2-digit\",hour:\"numeric\",minute:\"2-digit\",hour12:true}).formatToParts(new Date()).map(x=>[x.type,x.value]));",
"  const iso=p.year+\"-\"+p.month+\"-\"+p.day,ap=String(p.dayPeriod||\"\").toLowerCase().indexOf(\"p\")>=0?\"\u0645\":\"\u0635\";",
"  return`\u0637\u064f\u0628\u0639 \u0628\u0648\u0627\u0633\u0637\u0629 ${(me&&(me.name||me.username))||\"\"} \u0628\u062a\u0627\u0631\u064a\u062e ${dayName(iso)} ${p.day}/${p.month}/${p.year} \u0627\u0644\u0633\u0627\u0639\u0629 ${p.hour}:${p.minute} ${ap}`}",
"function stampRcpt(html){",
"  const box=document.createElement(\"div\");box.innerHTML=html;const t=printStamp();",
"  box.querySelectorAll(\".pstamp\").forEach(x=>x.remove());",
"  box.querySelectorAll(\".rcpt\").forEach(R=>{const d=document.createElement(\"div\");d.className=\"pstamp\";d.textContent=t;R.appendChild(d)});",
"  return box.innerHTML}",
"function preview(title,src,filename){",
"  const H=()=>fitRcpt(colorRcpt(stampRcpt(typeof src===\"function\"?src(paper):src)),paper);let html=H();",
"  const s=sheet(title,`<div class=\"seg\" style=\"margin:8px 0 10px\" role=\"group\" aria-label=\"\u0645\u0642\u0627\u0633 \u0627\u0644\u0648\u0631\u0642\"><button data-pp=\"80\" aria-pressed=\"${paper===\"80\"}\">\u0648\u0631\u0642 \u0643\u0627\u0634\u064a\u0631 80 \u0645\u0645</button><button data-pp=\"a4\" aria-pressed=\"${paper===\"a4\"}\">\u0648\u0631\u0642 A4</button></div>",
"    <div class=\"paper-wrap\"><div id=\"pv\" class=\"${paper===\"a4\"?\"a4\":\"\"}\">${html}</div></div>`,",
"   `<button class=\"btn primary\" id=\"doPrint\">\u0637\u0628\u0627\u0639\u0629</button><button class=\"btn\" id=\"doPdf\">PDF</button><button class=\"btn share-img\" id=\"doImg\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><circle cx=\"9\" cy=\"10\" r=\"2\"/><path d=\"M21 17l-5-5-9 8\"/></svg>\u0635\u0648\u0631\u0629</button><button class=\"btn\" data-close>\u0625\u063a\u0644\u0627\u0642</button>`);",
"  s.el.querySelectorAll(\"[data-pp]\").forEach(b=>b.onclick=()=>{paper=b.dataset.pp;ls.set(\"ccd-paper\",paper);$(\"#pv\").className=paper===\"a4\"?\"a4\":\"\";html=H();$(\"#pv\").innerHTML=html;",
