"ILL.sales=ILL.reports;ILL.home=ILL.boxes;",
"/* ---------- home: the opening screen, one tile per screen the user may open ---------- */",
"const APP_MARK='<img src=\"data:image/jpeg;base64,\" alt=\"\" aria-hidden=\"true\">';",
"const HOME_T={",
" boxes:[\"t-navy\",\"\u0625\u062f\u062e\u0627\u0644 \u0625\u0642\u0641\u0627\u0644 \u0627\u0644\u0635\u0646\u0627\u062f\u064a\u0642\"],summary:[\"t-teal\",\"\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a \u0627\u0644\u064a\u0648\u0645 \u0648\u0627\u0644\u0637\u0628\u0627\u0639\u0629\"],reports:[\"t-indigo\",\"\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0641\u062a\u0631\u0627\u062a \u0648\u0627\u0644\u062a\u062d\u0644\u064a\u0644\"],commission:[\"t-amber\",\"\u0646\u0633\u0628\u0629 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0644\u0644\u0643\u0627\u0634\u064a\u0631\u0627\u062a\"],",
" att:[\"t-green\",\"\u0627\u0644\u062d\u0636\u0648\u0631 \u0648\u0627\u0644\u063a\u064a\u0627\u0628 \u0648\u0627\u0644\u0623\u0648\u0641\"],log:[\"t-slate\",\"\u0643\u0644 \u062a\u0639\u062f\u064a\u0644 \u0648\u0645\u0646 \u0639\u062f\u0651\u0644\u0647\"],cashbox:[\"t-gold\",\"\u0627\u0644\u0645\u062f\u062e\u0644\u0627\u062a \u0648\u0627\u0644\u0645\u062e\u0631\u062c\u0627\u062a \u0648\u0627\u0644\u0625\u0642\u0641\u0627\u0644\"],petty:[\"t-rose\",\"\u0627\u0644\u0639\u0647\u062f \u0648\u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0648\u0627\u0644\u062a\u0635\u0641\u064a\u0629\"],",
" branches:[\"t-plum\",\"\u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0641\u0631\u0648\u0639 \u0648\u062a\u0642\u0631\u064a\u0631 \u0645\u062c\u0645\u0651\u0639\"],settings:[\"t-slate\",\"\u0627\u0644\u0634\u0631\u0643\u0629 \u0648\u0627\u0644\u0645\u0648\u0638\u0641\u0648\u0646 \u0648\u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0627\u062a\"],short:[\"t-rose\",\"\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0639\u062c\u0632 \u0648\u0627\u0644\u0632\u064a\u0627\u062f\u0629 \u0644\u0644\u0645\u0648\u0638\u0641\u064a\u0646\"],cash:[\"t-teal\",\"\u0643\u0627\u0634 \u0622\u062e\u0631 \u0627\u0644\u0623\u064a\u0627\u0645\"],sales:[\"t-indigo\",\"\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0623\u062e\u064a\u0631\u0629\"]};",
"function greet(){const h=+new Intl.DateTimeFormat(\"en-GB\",{timeZone:\"Asia/Riyadh\",hour:\"numeric\",hour12:false}).format(new Date());return h<12?\"\u0635\u0628\u0627\u062d \u0627\u0644\u062e\u064a\u0631\":\"\u0645\u0633\u0627\u0621 \u0627\u0644\u062e\u064a\u0631\"}",
"function homeToday(){const raw=days.get(todayISO());if(!raw||raw.namesOnly)return null;try{return normDay(raw)}catch(e){return null}}",
"function homeHint(k,T){",
"  const vis=Array.from({length:BOXES},(_,i)=>i).filter(i=>!boxHidden(i));",
"  if(k===\"boxes\"&&T)return`${T.boxes.filter((b,i)=>vis.indexOf(i)>=0&&hasData(b)).length} \u0645\u0646 ${vis.length} \u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u064a\u0648\u0645`;",
"  if(k===\"summary\"&&T&&me.role!==\"lead\"){const c=dayCalc(T);return c.count?`\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u064a\u0648\u0645 ${fmt(c.total)}`:null}",
"  if(k===\"short\"&&T){const n=T.boxes.filter(b=>hasData(b)&&r2(boxCalc(b).diff)<0).length;return n?`${n} \u0635\u0646\u062f\u0648\u0642 \u0639\u0644\u064a\u0647 \u0639\u062c\u0632 \u0627\u0644\u064a\u0648\u0645`:null}",
"  if(k===\"branches\")return`${(ALLBR||BRANCHES||[]).length} \u0641\u0631\u0648\u0639`;",
"  if(k===\"settings\"&&me.role===\"acc\")return`\u0627\u0644\u0625\u0635\u062f\u0627\u0631 ${APPV}`;",
"  return null;",
"}",
"function renderHome(){",
"  const r=effectiveRole(),T=r===\"lead\"?null:homeToday(),c=T?dayCalc(T):null,tabs=myTabs().filter(k=>k!==\"home\");",
"  const rq=r===\"acc\"&&T?T.boxes.filter(b=>b&&b.rq).length:0,many=(BRANCHES||[]).length>1,vis=Array.from({length:BOXES},(_,i)=>i).filter(i=>!boxHidden(i)).length;",
"  $(\"#view\").innerHTML=`<section class=\"home-hero\">",
"    <div class=\"hh-top\">${LOGO?`<img src=\"${LOGO}\" alt=\"\" class=\"hh-logo\">`:`<span class=\"hh-mark\">${APP_MARK}</span>`}",
"     <div class=\"hh-who\"><span>${greet()}\u060c ${esc((me.name||me.username).split(\" \")[0])}</span><b>${esc(settings.store||\"\u0625\u0642\u0641\u0627\u0644 \u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u0643\u0627\u0634\u064a\u0631\")}</b>",
"      ${many?`<button type=\"button\" class=\"hh-br\" id=\"hhBr\">${esc(brName(BRC)||settings.branch||\"\")} \u25be</button>`:`<small>${esc(settings.branch||\"\")}</small>`}</div></div>",
"    <div class=\"hh-day\"><span>${dayName(todayISO())}</span><b class=\"num\">${dmy(todayISO())}</b></div>",
"    ${r===\"lead\"?\"\":`<div class=\"hh-bubble\"><span>\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u064a\u0648\u0645</span><b class=\"num\">${fmt(c&&c.count?c.total:0)}</b><small>${c&&c.count?`<span class=\"num\">${c.count} / ${vis}</span> \u0635\u0646\u0627\u062f\u064a\u0642 \u0645\u062d\u0641\u0648\u0638\u0629`:\"\u0644\u0645 \u062a\u064f\u062f\u062e\u0644 \u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u064a\u0648\u0645 \u0628\u0639\u062f\"}</small></div>`}",
"    ${c&&c.count?`<div class=\"hh-figs\"><div><span>\u0627\u0644\u0643\u0627\u0634</span><b class=\"num\">${fmt(c.cash)}</b></div><div><span>\u0627\u0644\u0634\u0628\u0643\u0627\u062a</span><b class=\"num\">${fmt(c.net)}</b></div>",
"      <div><span>\u0627\u0644\u0632\u064a\u0627\u062f\u0629 / \u0627\u0644\u0646\u0642\u0635</span><b class=\"num ${c.diff<0?\"neg\":c.diff>0?\"pos\":\"\"}\">${fmtS(c.diff)}</b></div></div>`:\"\"}",
"    ${rq?`<button type=\"button\" class=\"hh-alert\" data-home=\"boxes\"><b class=\"num\">${rq}</b> \u0625\u062f\u062e\u0627\u0644 \u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0639\u062a\u0645\u0627\u062f\u0643</button>`:\"\"}",
"   </section>",
"   <nav class=\"home-grid\" aria-label=\"\u0627\u0644\u0634\u0627\u0634\u0627\u062a\">${tabs.map(k=>{const t=HOME_T[k]||[\"t-slate\",\"\"],h=homeHint(k,T);",
"     return`<button type=\"button\" class=\"tile ${t[0]}\" data-home=\"${k}\">${ILL[k]?`<span class=\"ill\" aria-hidden=\"true\">${ILL[k]}</span>`:\"\"}<span class=\"ti\">${ICONS[k]||\"\"}</span><b>${TABN[k]||k}</b><span class=\"ts\">${esc(h||t[1])}</span></button>`}).join(\"\")}</nav>",
"   ${dockHTML(tabs)}`;",
"  document.querySelectorAll(\"[data-home]\").forEach(b=>b.onclick=()=>{tab=b.dataset.home;render();window.scrollTo(0,0)});",
"  const hb=$(\"#hhBr\");if(hb)hb.onclick=pickBranchUI;",
"  const dk=$(\"#dock\");if(dk){dk.querySelector(\".dk-t\").onclick=()=>{const m=!dk.classList.contains(\"min\");dk.classList.toggle(\"min\",m);try{localStorage.setItem(\"ccd-dock\",m?\"1\":\"\")}catch(e){}}}",
"}",
"/* a small floating shortcut bar for the screens opened most during the day */",
"function dockHTML(tabs){",
"  const L=[\"petty\",\"commission\",\"cashbox\"].filter(k=>tabs.indexOf(k)>=0);if(!L.length)return\"\";",
"  let min=false;try{min=localStorage.getItem(\"ccd-dock\")===\"1\"}catch(e){}",
